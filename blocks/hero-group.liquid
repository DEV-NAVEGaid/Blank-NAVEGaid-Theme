{%- style -%}
  .hero-overlay__block-{{ block.id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    gap: {{ block.settings.gap }}px;
    background-color: {{ block.settings.bg_color }};
    {% if block.settings.bg_image != blank %}
      background-image: url('{{ block.settings.bg_image | image_url: width: 1500 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_horizontal }}px;
    padding-right: {{ block.settings.padding_horizontal }}px;
    border-radius: {{ block.settings.border_radius }}px;
    
    {% if block.settings.width_mode == 'custom' %}
      width: {{ block.settings.custom_width }}%;
      max-width: 100%;
    {% else %}
      width: 100%;
    {% endif %}
    
    justify-content: {{ block.settings.justify_content }};
    align-items: {{ block.settings.align_items }};
  }

  @media screen and (max-width: 749px) {
    .hero-overlay__block-{{ block.id }} {
      {% if block.settings.stack_on_mobile %}
        flex-direction: column;
      {% endif %}
    }
  }
{%- endstyle -%}

<div class="hero-overlay__group hero-overlay__block-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for "blocks" %}
</div>

{% schema %}
{
  "name": "Group",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        },
        {
          "value": "row",
          "label": "Horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack vertically on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Gap between blocks",
      "default": 16
    },
    {
      "type": "select",
      "id": "justify_content",
      "label": "Justify content",
      "options": [
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        },
        {
          "value": "space-between",
          "label": "Space Between"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "align_items",
      "label": "Align items",
      "options": [
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "select",
      "id": "width_mode",
      "label": "Width",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit / Full Width"
        },
        {
          "value": "custom",
          "label": "Custom Width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "custom_width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Custom width",
      "default": 50
    },
    {
      "type": "header",
      "content": "Background and padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding left/right",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
