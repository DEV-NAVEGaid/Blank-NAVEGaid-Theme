{%- assign current_product = closest.product | default: product -%}
{%- assign current_sku = current_product.selected_or_first_available_variant.sku | default: 'SKU-00123' -%}

{%- style -%}
  .card-sku-{{ block.id }} {
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    text-align: {{ block.settings.alignment }};
    line-height: 1.2;
  }
{%- endstyle -%}

<div class="card-sku-wrapper card-sku-{{ block.id }}" {{ block.shopify_attributes }}>
  <span>{{ block.settings.label_prefix }}{{ current_sku }}</span>
</div>

{% schema %}
{
  "name": "SKU",
  "settings": [
    {
      "type": "text",
      "id": "label_prefix",
      "label": "Label prefix",
      "default": "SKU: "
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 12
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "SKU",
      "category": "Product"
    }
  ]
}
{% endschema %}
