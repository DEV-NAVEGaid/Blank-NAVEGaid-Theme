{%- assign current_product = closest.product | default: product -%}
{%- assign product_title = current_product.title | default: 'Example product title' -%}
{%- assign product_url = current_product.url | default: '#' -%}

{%- style -%}
  .card-title-{{ block.id }} {
    margin: 0;
    line-height: {{ block.settings.line_height }};
    text-align: {{ block.settings.alignment }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .card-title-{{ block.id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size_mobile }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .card-title-{{ block.id }} a:hover {
    opacity: 0.75;
  }

  @media screen and (min-width: 750px) {
    .card-title-{{ block.id }} a {
      font-size: {{ block.settings.font_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="card-title-wrapper card-title-wrapper-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading_tag == 'h2' -%}
    <h2 class="card-title-{{ block.id }}"><a href="{{ product_url }}">{{ product_title }}</a></h2>
  {%- elsif block.settings.heading_tag == 'h4' -%}
    <h4 class="card-title-{{ block.id }}"><a href="{{ product_url }}">{{ product_title }}</a></h4>
  {%- elsif block.settings.heading_tag == 'p' -%}
    <p class="card-title-{{ block.id }}"><a href="{{ product_url }}">{{ product_title }}</a></p>
  {%- elsif block.settings.heading_tag == 'div' -%}
    <div class="card-title-{{ block.id }}"><a href="{{ product_url }}">{{ product_title }}</a></div>
  {%- else -%}
    <h3 class="card-title-{{ block.id }}"><a href="{{ product_url }}">{{ product_title }}</a></h3>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product title",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "p",
          "label": "Paragraph (p)"
        },
        {
          "value": "div",
          "label": "div"
        }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.3
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Product title",
      "category": "Product"
    }
  ]
}
{% endschema %}
