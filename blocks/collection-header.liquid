{%- assign section_id = section.id -%}

{%- style -%}
  .collection-header-{{ block.id }} {
    display: flex;
    flex-direction: {{ block.settings.layout_mobile }};
    justify-content: {{ block.settings.justify_content }};
    align-items: {{ block.settings.align_items }};
    gap: {{ block.settings.gap_mobile }}px;
    margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .collection-header-{{ block.id }} {
      flex-direction: {{ block.settings.layout_desktop }};
      gap: {{ block.settings.gap_desktop }}px;
      margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="collection__header collection-header-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop layout",
      "options": [
        {
          "value": "row",
          "label": "Horizontal (Row)"
        },
        {
          "value": "column",
          "label": "Vertical (Column)"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile layout",
      "options": [
        {
          "value": "row",
          "label": "Horizontal (Row)"
        },
        {
          "value": "column",
          "label": "Vertical (Column)"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "justify_content",
      "label": "Horizontal alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Start (Left)"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End (Right)"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "space-between"
    },
    {
      "type": "select",
      "id": "align_items",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "flex-end"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Gap between items (Desktop)",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between items (Mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margin bottom (Mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "collection-title"
        },
        {
          "type": "collection-view-all"
        }
      ]
    }
  ]
}
{% endschema %}
