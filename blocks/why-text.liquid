{%- style -%}
  {{ block.settings.font | font_face: font_display: 'swap' }}

  .why-text-{{ block.id }},
  .why-text-{{ block.id }} p {
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.weight }};
    font-size: {{ block.settings.size }}px;
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }};
    color: {{ block.settings.color }};
    text-align: {{ block.settings.align }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .why-text-{{ block.id }} {
      font-size: {{ block.settings.size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="why-choose__block why-text-{{ block.id }}" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</div>

{% schema %}
{
  "name": "Why text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 15
    },
    {
      "type": "range",
      "id": "size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "1.3",
          "label": "Tight"
        },
        {
          "value": "1.5",
          "label": "Normal"
        },
        {
          "value": "1.7",
          "label": "Loose"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "-0.02em",
          "label": "Tight"
        },
        {
          "value": "0em",
          "label": "Normal"
        },
        {
          "value": "0.04em",
          "label": "Loose"
        }
      ],
      "default": "0em"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Why text"
    }
  ]
}
{% endschema %}