{%- style -%}
  {{ block.settings.button_font | font_face: font_display: 'swap' }}
  .hero-overlay__block-{{ block.id }} {
    text-align: {{ block.settings.button_align }};
    margin-top: {{ block.settings.button_padding_top }}px;
    display: flex;
    justify-content: {% if block.settings.button_align == 'center' %}center{% elsif block.settings.button_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  {% if block.settings.button_style_secondary %}
  .hero-overlay__block-{{ block.id }} .button::after,
  .hero-overlay__block-{{ block.id }} .button::before {
    content: none !important;
    display: none !important;
  }
  {% endif %}

  .hero-overlay__block-{{ block.id }} .button {
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-size: {{ block.settings.button_size }}px;
    font-weight: {{ block.settings.button_weight }};
    {% if block.settings.button_style_secondary %}
      background-color: transparent;
      border: 1px solid {{ block.settings.button_text_color }};
    {% else %}
      background-color: {{ block.settings.button_bg_color }};
      border: 1px solid transparent;
    {% endif %}
    padding: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
    {% if block.settings.button_style_secondary %}
      border-radius: {{ block.settings.secondary_button_border_radius }}px;
    {% else %}
      border-radius: {{ block.settings.button_border_radius }}px;
    {% endif %}
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-block;
  }

  {% if block.settings.button_hover_bg_color != blank %}
  .hero-overlay__block-{{ block.id }} .button:hover {
    {% if block.settings.button_style_secondary %}
      background-color: {{ block.settings.button_hover_bg_color }};
      color: {{ block.settings.button_hover_text_color }};
      border-color: {{ block.settings.button_hover_bg_color }};
    {% else %}
      background-color: {{ block.settings.button_hover_bg_color }};
      color: {{ block.settings.button_hover_text_color }};
    {% endif %}
  }
  {% endif %}

  @media screen and (max-width: 749px) {
    .hero-overlay__block-{{ block.id }} .button {
      font-size: {{ block.settings.button_size_mobile }}px;
      padding: {{ block.settings.button_padding_y_mobile }}px {{ block.settings.button_padding_x_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="hero-overlay__button-wrapper-{{ section.id }} hero-overlay__block-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.button_label != blank -%}
    <a href="{{ block.settings.button_link }}" class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}">
      {{- block.settings.button_label | escape -}}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Use secondary button style",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography and style"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "button_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 14
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background color",
      "default": "#F5F5F5"
    },
    {
      "type": "select",
      "id": "button_align",
      "label": "Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding X",
      "default": 32
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Padding Y",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_padding_x_mobile",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Padding X (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_padding_y_mobile",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Padding Y (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 30
    },
    {
      "type": "range",
      "id": "secondary_button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Secondary border radius",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_padding_top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Spacing top",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
