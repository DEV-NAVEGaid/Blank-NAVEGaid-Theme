{%- style -%}
  {{ block.settings.font | font_face: font_display: 'swap' }}
  {{ block.settings.desc_font | font_face: font_display: 'swap' }}

  .why-heading-{{ block.id }} {
    width: 100%;
    box-sizing: border-box;
  }

  .why-heading-{{ block.id }} h2 {
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.weight }};
    font-size: {{ block.settings.size }}px;
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }};
    color: {{ block.settings.color }};
    text-align: {{ block.settings.align }};
    text-transform: {{ block.settings.case }};
    margin: 0;
  }

  {% if block.settings.description != blank %}
  .why-heading-{{ block.id }} .why-heading__description {
    font-family: {{ block.settings.desc_font.family }}, {{ block.settings.desc_font.fallback_families }};
    font-weight: {{ block.settings.desc_weight }};
    font-size: {{ block.settings.desc_size }}px;
    line-height: {{ block.settings.desc_line_height }};
    color: {{ block.settings.desc_color }};
    text-align: {{ block.settings.align }};
    margin-top: {{ block.settings.desc_margin }}px;
    margin-bottom: 0;
  }
  {% endif %}

  @media screen and (max-width: 749px) {
    .why-heading-{{ block.id }} {
      flex: 0 0 100%;
    }
    .why-heading-{{ block.id }} h2 {
      font-size: {{ block.settings.size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="why-choose__block why-heading-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2>{{ block.settings.heading }}</h2>
  {% endif %}
  {% if block.settings.description != blank %}
    <p class="why-heading__description">{{ block.settings.description }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Why heading",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description (optional)"
    },
    {
      "type": "range",
      "id": "column_width",
      "min": 15,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Column width",
      "info": "How much of the row the heading takes. The feature columns share the rest.",
      "default": 30
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "libre_baskerville_n4"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Font size (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "size_mobile",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 30
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "1.05",
          "label": "Tight"
        },
        {
          "value": "1.2",
          "label": "Normal"
        },
        {
          "value": "1.4",
          "label": "Loose"
        }
      ],
      "default": "1.2"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "-0.02em",
          "label": "Tight"
        },
        {
          "value": "0em",
          "label": "Normal"
        },
        {
          "value": "0.04em",
          "label": "Loose"
        }
      ],
      "default": "-0.02em"
    },
    {
      "type": "select",
      "id": "case",
      "label": "Case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Description typography"
    },
    {
      "type": "font_picker",
      "id": "desc_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "select",
      "id": "desc_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "desc_line_height",
      "label": "Line height",
      "options": [
        {
          "value": "1.3",
          "label": "Tight"
        },
        {
          "value": "1.5",
          "label": "Normal"
        },
        {
          "value": "1.7",
          "label": "Loose"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "range",
      "id": "desc_margin",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space above description",
      "default": 16
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Why heading"
    }
  ]
}
{% endschema %}