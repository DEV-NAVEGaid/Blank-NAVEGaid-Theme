{%- style -%}
  {{ block.settings.font | font_face: font_display: 'swap' }}

  .why-title-{{ block.id }} h3 {
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.weight }};
    font-size: {{ block.settings.size }}px;
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }};
    color: {{ block.settings.color }};
    text-align: {{ block.settings.align }};
    text-transform: {{ block.settings.case }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .why-title-{{ block.id }} h3 {
      font-size: {{ block.settings.size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="why-choose__block why-title-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h3>{{ block.settings.title }}</h3>
  {% endif %}
</div>

{% schema %}
{
  "name": "Why title",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Heading"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "assistant_n7"
    },
    {
      "type": "select",
      "id": "weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "size_mobile",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 17
    },
    {
      "type": "select",
      "id": "line_height",
      "label": "Line height",
      "options": [
        {
          "value": "1.1",
          "label": "Tight"
        },
        {
          "value": "1.3",
          "label": "Normal"
        },
        {
          "value": "1.5",
          "label": "Loose"
        }
      ],
      "default": "1.3"
    },
    {
      "type": "select",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "options": [
        {
          "value": "-0.02em",
          "label": "Tight"
        },
        {
          "value": "0em",
          "label": "Normal"
        },
        {
          "value": "0.04em",
          "label": "Loose"
        }
      ],
      "default": "0em"
    },
    {
      "type": "select",
      "id": "case",
      "label": "Case",
      "options": [
        {
          "value": "none",
          "label": "Default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Why title"
    }
  ]
}
{% endschema %}