{% render 'section-corners', section: section %}
{{ 'component-before-after.css' | asset_url | stylesheet_tag }}
<script src="{{ 'before-after-results.js' | asset_url }}" defer="defer"></script>
{% assign sid = section.id | replace: '_', '' | downcase %}

{% comment %} Collect blocks by type {% endcomment %}
{% assign heading_block = nil %}
{% assign before_block = nil %}
{% assign after_block = nil %}

{% for block in section.blocks %}
  {% if block.type == 'heading' %}
    {% assign heading_block = block %}
  {% elsif block.type == 'before_image' %}
    {% assign before_block = block %}
  {% elsif block.type == 'after_image' %}
    {% assign after_block = block %}
  {% endif %}
{% endfor %}

{% comment %} Aspect ratio map {% endcomment %}
{% assign img_ratio = section.settings.image_ratio %}
{% if img_ratio == '1:1' %}
  {% assign ratio_val = 100 %}
{% elsif img_ratio == '4:3' %}
  {% assign ratio_val = 75 %}
{% elsif img_ratio == '3:2' %}
  {% assign ratio_val = 66.666 %}
{% elsif img_ratio == '16:9' %}
  {% assign ratio_val = 56.25 %}
{% elsif img_ratio == '2:3' %}
  {% assign ratio_val = 150 %}
{% elsif img_ratio == '3:4' %}
  {% assign ratio_val = 133.333 %}
{% elsif img_ratio == '5:4' %}
  {% assign ratio_val = 80 %}
{% elsif img_ratio == 'custom' %}
  {% assign ratio_val = section.settings.custom_ratio %}
{% else %}
  {% assign ratio_val = 75 %}
{% endif %}




<div
  class="bar-section-{{ sid }} bar-section"
  style="
    --bar-z: {{ section.settings.z_index | default: 1 }};
    --bar-bg: {{ section.settings.section_bg | default: '#FFFFFF' }};
    {%- if section.settings.enable_global_spacing -%}
      --bar-pt: {{ settings.padding_vertical | default: 60 }}px;
      --bar-pb: {{ settings.padding_vertical | default: 60 }}px;
      --bar-pl: {{ settings.padding_horizontal | default: 40 }}px;
      --bar-pr: {{ settings.padding_horizontal | default: 40 }}px;
      --bar-pt-m: {{ settings.padding_vertical_mobile | default: 40 }}px;
      --bar-pb-m: {{ settings.padding_vertical_mobile | default: 40 }}px;
      --bar-pl-m: {{ settings.padding_horizontal_mobile | default: 20 }}px;
      --bar-pr-m: {{ settings.padding_horizontal_mobile | default: 20 }}px;
    {%- else -%}
      --bar-pt: {{ section.settings.padding_top | default: 60 }}px;
      --bar-pb: {{ section.settings.padding_bottom | default: 60 }}px;
      --bar-pl: {{ section.settings.padding_left | default: 40 }}px;
      --bar-pr: {{ section.settings.padding_right | default: 40 }}px;
      --bar-pt-m: {{ section.settings.padding_top_mobile | default: 40 }}px;
      --bar-pb-m: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
      --bar-pl-m: {{ section.settings.padding_left_mobile | default: 20 }}px;
      --bar-pr-m: {{ section.settings.padding_right_mobile | default: 20 }}px;
    {%- endif -%}
    --bar-max-w: {% if section.settings.enable_global_spacing %}var(--page-width, 1200px){% elsif section.settings.section_width == 'fixed' %}{{ section.settings.container_width | default: 1200 }}px{% else %}100%{% endif %};
    --bar-heading-gap: {{ heading_block.settings.heading_gap | default: 40 }}px;
    --bar-stats-justify: {{ section.settings.stats_alignment | default: 'center' }};
    --bar-stat-align: {{ section.settings.stat_text_align | default: 'center' }};
    --bar-stats-gap: {{ section.settings.stats_gap | default: 24 }}px;
    --bar-stats-col-gap: {{ section.settings.stats_col_gap | default: 32 }}px;
    --bar-stats-gap-m: {{ section.settings.stats_gap_mobile | default: 16 }}px;
    --bar-stats-col-gap-m: {{ section.settings.stats_col_gap_mobile | default: 16 }}px;
    --bar-ratio: {{ ratio_val | default: 75 }}%;
    --bar-img-radius: {{ section.settings.image_border_radius | default: 12 }}px;
    --bar-img-gap: {{ section.settings.images_bottom_gap | default: 32 }}px;
    --bar-line-w: {{ section.settings.handle_line_width | default: 2 }}px;
    --bar-line-color: {{ section.settings.handle_line_color | default: '#FFFFFF' }};
    --bar-handle-size: {{ section.settings.handle_size | default: 44 }}px;
    --bar-handle-bg: {{ section.settings.handle_bg | default: '#FFFFFF' }};
    --bar-handle-bw: {{ section.settings.handle_border_width | default: 0 }}px;
    --bar-handle-bc: {{ section.settings.handle_border_color | default: '#F5F5F5' }};
    --bar-handle-ring: {{ section.settings.handle_ring_color | default: '#E5E5E5' }};
    --bar-handle-icon: {{ section.settings.handle_icon_color | default: '#111111' }};
  "
>
  <div class="bar-container-{{ sid }} bar-container">

    {%- comment -%} ── Section Heading ── {%- endcomment -%}
    {%- if heading_block != nil -%}
      {%- assign hb = heading_block.settings -%}
      {%- assign h_tag = hb.heading_tag | default: 'h2' -%}
      <div
        class="bar-heading-wrap-{{ sid }} bar-heading-wrap"
        style="text-align: {{ hb.heading_alignment | default: 'center' }}; margin-bottom: {{ hb.heading_gap | default: 40 }}px;"
        {{ heading_block.shopify_attributes }}
      >
        {%- if hb.heading != blank -%}
          <{{ h_tag }}
            style="color: {{ hb.heading_color | default: '#111111' }}; font-size: {{ hb.heading_font_size | default: 40 }}px; font-weight: {{ hb.heading_font_weight | default: '400' }}; font-family: {% if hb.heading_font_family == 'inherit' or hb.heading_font_family == blank %}var(--font-heading-family){% else %}{{ hb.heading_font_family }}{% endif %}; line-height: 1.2; margin: 0 0 {{ hb.title_subtitle_gap | default: 12 }}px;"
          >
            {{- hb.heading -}}
          </{{ h_tag }}>
        {%- endif -%}
        {%- if hb.subheading != blank -%}
          <p style="color: {{ hb.subtitle_color | default: '#111111' }}; font-size: {{ hb.subtitle_font_size | default: 16 }}px; font-weight: {{ hb.subtitle_font_weight | default: '400' }}; font-family: {% if hb.subtitle_font_family == 'inherit' or hb.subtitle_font_family == blank %}var(--font-body-family){% else %}{{ hb.subtitle_font_family }}{% endif %}; line-height: 1.5; margin: 0;">
            {{- hb.subheading -}}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Drag Slider ── {%- endcomment -%}
    {%- if before_block.settings.image != blank and after_block.settings.image != blank -%}
    <before-after-results
      class="bar-slider-wrap-{{ sid }} bar-slider-wrap"
      data-bar-slider="{{ sid }}"
      style="--comparison-position: {{ section.settings.initial_position | default: 50 }}%;"
    >

      {%- comment -%} After image — bottom layer (always fully visible) {%- endcomment -%}
      {%- if after_block != nil -%}
        {%- assign ab = after_block.settings -%}
        <div class="bar-after-{{ sid }} bar-after" {{ after_block.shopify_attributes }}>
          {%- if ab.image != blank -%}
            {%- assign after_alt = ab.image.alt | default: ab.label | default: 'After' -%}
            {{- ab.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 2000', sizes: '(min-width: 1200px) 1120px, 100vw', alt: after_alt -}}
          {%- endif -%}
        </div>
        {%- if ab.show_label and ab.label != blank -%}
          <span
            class="bar-label-after-{{ sid }} bar-label-after"
            style="top: {{ ab.label_top | default: 20 }}px; right: {{ ab.label_side_offset | default: 20 }}px; padding: {{ ab.label_padding_y | default: 6 }}px {{ ab.label_padding_x | default: 12 }}px; background-color: {{ ab.label_bg | default: '#E5E5E5' }}; color: {{ ab.label_color | default: '#E5E5E5' }}; border-radius: {{ ab.label_border_radius | default: 4 }}px; border: 1px solid {{ ab.label_border_color | default: '#E5E5E5' }}; font-size: {{ ab.label_font_size | default: 11 }}px; font-weight: {{ ab.label_font_weight | default: '500' }}; font-family: {{ ab.label_font_family | default: 'inherit' }};"
          >{{- ab.label -}}</span>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Before image — top layer, clipped to reveal from left {%- endcomment -%}
      {%- if before_block != nil -%}
        {%- assign bb = before_block.settings -%}
        <div data-bar-before class="bar-before-{{ sid }} bar-before" {{ before_block.shopify_attributes }}>
          {%- if bb.image != blank -%}
            {%- assign before_alt = bb.image.alt | default: bb.label | default: 'Before' -%}
            {{- bb.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 2000', sizes: '(min-width: 1200px) 1120px, 100vw', alt: before_alt -}}
          {%- endif -%}
        </div>
        {%- if bb.show_label and bb.label != blank -%}
          <span
            class="bar-label-before-{{ sid }} bar-label-before"
            style="top: {{ bb.label_top | default: 20 }}px; left: {{ bb.label_side_offset | default: 20 }}px; padding: {{ bb.label_padding_y | default: 6 }}px {{ bb.label_padding_x | default: 12 }}px; background-color: {{ bb.label_bg | default: '#E5E5E5' }}; color: {{ bb.label_color | default: '#E5E5E5' }}; border-radius: {{ bb.label_border_radius | default: 4 }}px; border: 1px solid {{ bb.label_border_color | default: '#E5E5E5' }}; font-size: {{ bb.label_font_size | default: 11 }}px; font-weight: {{ bb.label_font_weight | default: '500' }}; font-family: {{ bb.label_font_family | default: 'inherit' }};"
          >{{- bb.label -}}</span>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Divider line {%- endcomment -%}
      <div class="bar-divider-{{ sid }} bar-divider" data-bar-divider></div>

      {%- comment -%} Drag handle button {%- endcomment -%}
      <label class="visually-hidden" for="Comparison-{{ section.id }}">{{ section.settings.slider_label | escape }}</label>
      <input id="Comparison-{{ section.id }}" class="bar-comparison-input" type="range" min="0" max="100" step="1" value="{{ section.settings.initial_position | default: 50 }}">
      <div aria-hidden="true" class="bar-handle-{{ sid }} bar-handle" data-bar-handle>
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <polyline points="9 18 3 12 9 6"></polyline>
          <polyline points="15 6 21 12 15 18"></polyline>
        </svg>
      </div>

    </before-after-results>
    {%- endif -%}

    {%- comment -%} ── Stats Row ── {%- endcomment -%}
    {%- assign has_stats = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        {%- assign has_stats = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_stats -%}
      <div class="bar-stats-{{ sid }} bar-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            {%- assign sb = block.settings -%}
            <div
              class="bar-stat-item-{{ sid }} bar-stat-item"
              {{ block.shopify_attributes }}
            >
              {%- if sb.value != blank -%}
                <span style="display: block; color: {{ sb.value_color | default: '#111111' }}; font-size: {{ sb.value_font_size | default: 36 }}px; font-weight: {{ sb.value_font_weight | default: '600' }}; font-family: {% if sb.value_font_family == 'inherit' or sb.value_font_family == blank %}var(--font-heading-family){% else %}{{ sb.value_font_family }}{% endif %}; line-height: 1.1; margin-bottom: {{ sb.value_label_gap | default: 6 }}px;">
                  {{- sb.value -}}
                </span>
              {%- endif -%}
              {%- if sb.label != blank -%}
                <span style="display: block; color: {{ sb.label_color | default: '#111111' }}; font-size: {{ sb.label_font_size | default: 11 }}px; font-weight: {{ sb.label_font_weight | default: '400' }}; font-family: {% if sb.label_font_family == 'inherit' or sb.label_font_family == blank %}var(--font-body-family){% else %}{{ sb.label_font_family }}{% endif %}; line-height: 1.3; text-transform: {{ sb.label_transform | default: 'uppercase' }}; letter-spacing: 0.0{{ sb.label_letter_spacing | default: 8 }}em;">
                  {{- sb.label -}}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* moved from inline style block for bundling */
.bar-section {
  position: relative;
  z-index: var(--bar-z, 1);
  background-color: var(--bar-bg, #FFFFFF);
  padding-top: var(--bar-pt, 60px);
  padding-bottom: var(--bar-pb, 60px);
  padding-left: var(--bar-pl, 40px);
  padding-right: var(--bar-pr, 40px);
}
@media screen and (max-width: 749px) {
  .bar-section {
    padding-top: var(--bar-pt-m, 40px);
    padding-bottom: var(--bar-pb-m, 40px);
    padding-left: var(--bar-pl-m, 20px);
    padding-right: var(--bar-pr-m, 20px);
  }
}
.bar-container {
  margin: 0 auto;
  width: 100%;
  max-width: var(--bar-max-w, 1200px);
}
.bar-heading-wrap {
  margin-bottom: var(--bar-heading-gap, 40px);
}
.bar-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: var(--bar-stats-justify, center);
  gap: var(--bar-stats-gap, 24px) var(--bar-stats-col-gap, 32px);
}
.bar-stat-item {
  text-align: var(--bar-stat-align, center);
  flex: 1 1 auto;
  min-width: 80px;
}
@media screen and (max-width: 749px) {
  .bar-stats {
    gap: var(--bar-stats-gap-m, 16px) var(--bar-stats-col-gap-m, 16px);
  }
  .bar-stat-item {
    flex: 0 1 calc(50% - 8px);
  }
}
.bar-slider-wrap {
  position: relative;
  width: 100%;
  padding-bottom: var(--bar-ratio, 75%);
  overflow: hidden;
  border-radius: var(--bar-img-radius, 12px);
  margin-bottom: var(--bar-img-gap, 32px);
  cursor: col-resize;
  user-select: none;
  -webkit-user-select: none;
  touch-action: pan-y;
}
.bar-after,
.bar-before {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.bar-after img, .bar-after svg,
.bar-before img, .bar-before svg {
  width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none;
}
.bar-before {
  clip-path: inset(0 calc(100% - var(--comparison-position, 50%)) 0 0);
  will-change: clip-path;
}
.bar-divider {
  position: absolute;
  top: 0; bottom: 0; left: var(--comparison-position, 50%);
  width: var(--bar-line-w, 2px);
  background-color: var(--bar-line-color, #FFFFFF);
  transform: translateX(-50%);
  will-change: left;
  pointer-events: none;
  z-index: 8;
}
.bar-handle {
  position: absolute;
  top: 50%; left: var(--comparison-position, 50%);
  transform: translate(-50%, -50%);
  width: var(--bar-handle-size, 44px);
  height: var(--bar-handle-size, 44px);
  background-color: var(--bar-handle-bg, #FFFFFF);
  border: var(--bar-handle-bw, 0px) solid var(--bar-handle-bc, #E5E5E5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 3px var(--bar-handle-ring, #FFFFFF), 0 2px 14px rgba(0,0,0,0.25);
  pointer-events: none;
  will-change: left;
  z-index: 10;
}
.bar-handle svg {
  width: 60%; height: 60%;
  fill: none;
  stroke: var(--bar-handle-icon, #111111);
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.bar-label-before,
.bar-label-after {
  position: absolute;
  display: inline-flex;
  align-items: center;
  letter-spacing: 0.04em;
  line-height: 1;
  pointer-events: none;
  z-index: 5;
}
@media screen and (max-width: 749px) {
  .bar-label-before,
  .bar-label-after {
    max-width: calc(50% - 12px);
    padding: 4px !important;
    font-size: 8px !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bar-label-before {
    left: 6px !important;
  }
  .bar-label-after {
    right: 6px !important;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Before and after results",
  "tag": "section",
  "class": "bar-results-section",
  "settings": [
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "slider_label",
      "label": "Comparison control label",
      "default": "Compare before and after images"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1:1",
          "label": "Square (1:1)"
        },
        {
          "value": "4:3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3:2",
          "label": "Photo (3:2)"
        },
        {
          "value": "5:4",
          "label": "Classic (5:4)"
        },
        {
          "value": "16:9",
          "label": "Widescreen (16:9)"
        },
        {
          "value": "2:3",
          "label": "Portrait (2:3)"
        },
        {
          "value": "3:4",
          "label": "Tall (3:4)"
        },
        {
          "value": "custom",
          "label": "Custom %"
        }
      ],
      "default": "4:3"
    },
    {
      "type": "range",
      "id": "custom_ratio",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "%",
      "label": "Custom height % (of width)",
      "default": 75,
      "info": "Only used when 'Custom %' is selected above",
      "visible_if": "{{ section.settings.image_ratio == 'custom' }}"
    },
    {
      "type": "range",
      "id": "images_bottom_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Gap below slider",
      "default": 40
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Slider handle"
    },
    {
      "type": "range",
      "id": "initial_position",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Initial split position",
      "default": 50,
      "info": "50 = centered. Drag left for more Before, right for more After."
    },
    {
      "type": "range",
      "id": "handle_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Handle button size",
      "default": 44
    },
    {
      "type": "color",
      "id": "handle_bg",
      "label": "Handle background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "handle_ring_color",
      "label": "Handle ring / border color",
      "default": "#FFFFFF",
      "info": "White ring that outlines the handle button"
    },
    {
      "type": "color",
      "id": "handle_icon_color",
      "label": "Handle icon/arrow color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "handle_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Handle border width",
      "default": 0
    },
    {
      "type": "color",
      "id": "handle_border_color",
      "label": "Handle border color",
      "default": "#E5E5E5"
    },
    {
      "type": "range",
      "id": "handle_line_width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Divider line width",
      "default": 2
    },
    {
      "type": "color",
      "id": "handle_line_color",
      "label": "Divider line color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Stats row"
    },
    {
      "type": "select",
      "id": "stats_alignment",
      "label": "Stats horizontal alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-between",
          "label": "Space between"
        },
        {
          "value": "space-around",
          "label": "Space around"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "stat_text_align",
      "label": "Stat text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "stats_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Stats row gap (desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "stats_col_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Stats column gap (desktop)",
      "default": 32
    },
    {
      "type": "range",
      "id": "stats_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Stats row gap (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "stats_col_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Stats column gap (mobile)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "z_index",
      "min": 0,
      "max": 50,
      "step": 1,
      "label": "Z-Index (layer order)",
      "default": 2,
      "info": "Higher = on top of other sections"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Container width",
      "options": [
        {
          "value": "full",
          "label": "Full Width"
        },
        {
          "value": "fixed",
          "label": "Boxed"
        }
      ],
      "default": "fixed",
      "visible_if": "{{ section.settings.enable_global_spacing != true }}"
    },
    {
