{% render 'section-corners', section: section %}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{% assign section_id = section.id | replace: '_', '' | downcase %}

  <footer
    class="nvgd-footer nvgd-footer-{{ section_id }}"
    role="contentinfo"
    data-section-id="{{ section.id }}"
    style="
      --nvgd-footer-bg: {{ section.settings.background_color }};
      --nvgd-footer-text: {{ section.settings.text_color }};
      --nvgd-footer-subtitle: {{ section.settings.subtitle_color }};
      --nvgd-footer-heading: {{ section.settings.heading_color }};
      --nvgd-footer-link: {{ section.settings.link_color }};
      --nvgd-footer-link-hover: {{ section.settings.link_hover_color }};
      --nvgd-social-bg: {{ section.settings.social_icon_bg }};
      --nvgd-social-hover-bg: {{ section.settings.social_icon_hover_bg }};
      --nvgd-social-color: {{ section.settings.social_icon_color }};
      --nvgd-footer-bottom-text: {{ section.settings.bottom_text_color }};
      --nvgd-footer-max-width: {% if section.settings.enable_global_spacing %}var(--page-width){% else %}{{ section.settings.container_width }}px{% endif %};
      --nvgd-footer-pad-top: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}{% else %}{{ section.settings.padding_top }}{% endif %}px;
      --nvgd-footer-pad-x: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal }}{% else %}{{ section.settings.padding_x }}{% endif %}px;
      --nvgd-footer-pad-bottom: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}{% else %}{{ section.settings.padding_bottom }}{% endif %}px;
      --nvgd-footer-pad-top-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}{% else %}{{ section.settings.padding_top_mobile }}{% endif %}px;
      --nvgd-footer-pad-x-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal_mobile }}{% else %}{{ section.settings.padding_x_mobile }}{% endif %}px;
      --nvgd-footer-pad-bottom-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}{% else %}{{ section.settings.padding_bottom_mobile }}{% endif %}px;
    ">
  <div class="nvgd-footer-container nvgd-footer-container-{{ section_id }}">

    {% comment %} LEFT: Logo + Description + Social {% endcomment %}
    <div class="nvgd-footer-brand">
      <div class="nvgd-logo">
        {% if section.settings.logo_image %}
          <img
            src="{{ section.settings.logo_image | image_url: width: section.settings.logo_image_width }}"
            alt="{{ shop.name }} Logo"
            loading="lazy"
            width="{{ section.settings.logo_image_width }}"
            height="{{ section.settings.logo_image_width | divided_by: section.settings.logo_image.aspect_ratio | round }}">
        {% else %}
          <h2 class="nvgd-logo-text">{{ section.settings.logo_text | default: shop.name }}</h2>
        {% endif %}
      </div>

      {% if section.settings.support_text != blank %}
        <p class="nvgd-description">{{ section.settings.support_text }}</p>
      {% endif %}

      {% if section.settings.show_social_icons %}
        <div class="nvgd-social-icons">
          {% if section.settings.twitter_url != blank %}
            <a
              href="{{ section.settings.twitter_url }}"
              class="nvgd-social-icon"
              aria-label="Twitter"
              target="_blank"
              rel="noopener">
              {% render 'nvgd-icon'
                , icon: 'twitter'
                , size: '18px' %}
            </a>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <a
              href="{{ section.settings.facebook_url }}"
              class="nvgd-social-icon"
              aria-label="Facebook"
              target="_blank"
              rel="noopener">
              {% render 'nvgd-icon'
                , icon: 'facebook'
                , size: '18px' %}
            </a>
          {% endif %}
          {% if section.settings.instagram_url != blank %}
            <a
              href="{{ section.settings.instagram_url }}"
              class="nvgd-social-icon"
              aria-label="Instagram"
              target="_blank"
              rel="noopener">
              {% render 'nvgd-icon'
                , icon: 'instagram'
                , size: '18px' %}
            </a>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <a
              href="{{ section.settings.youtube_url }}"
              class="nvgd-social-icon"
              aria-label="YouTube"
              target="_blank"
              rel="noopener">
              {% render 'nvgd-icon'
                , icon: 'youtube'
                , size: '18px' %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% comment %} RIGHT: Menu Columns {% endcomment %}
    <div class="nvgd-footer-menus">
      {% for block in section.blocks %}
        {% if block.type == 'menu_column' %}
          <div class="nvgd-menu-column {% if block.settings.mobile_accordion %}nvgd-menu-accordion{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h3 class="nvgd-menu-heading">
                {% if block.settings.mobile_accordion %}
                  <button
                    type="button"
                    class="nvgd-accordion-trigger"
                    aria-expanded="false"
                    aria-controls="FooterMenu-{{ block.id }}"
                  >
                    <span>{{ block.settings.heading | upcase }}</span>
                    <span class="nvgd-accordion-icon" aria-hidden="true">+</span>
                  </button>
                {% else %}
                  {{ block.settings.heading | upcase }}
                {% endif %}
              </h3>
            {% endif %}

            {% if block.settings.menu != blank %}
              <ul
                class="nvgd-menu-links {% if block.settings.mobile_accordion %}nvgd-accordion-content{% endif %}"
                {% if block.settings.mobile_accordion %}id="FooterMenu-{{ block.id }}"{% endif %}
              >
                {% for link in linklists[block.settings.menu].links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% comment %} BOTTOM: Copyright + Payment Icons {% endcomment %}
  {% if section.settings.show_bottom_section %}
    <div class="nvgd-footer-bottom nvgd-footer-bottom-{{ section_id }}">
      <div class="nvgd-footer-bottom-inner">
        <div class="nvgd-footer-bottom-content">
          <!-- Copyright -->
          <div class="nvgd-copyright">
            <p>{{ section.settings.copyright_text | default: shop.name }}</p>
          </div>

          <!-- Payment Icons -->
          {%- if section.settings.show_payment_icons or section.settings.payment_enable -%}
            <div class="nvgd-payment-icons">
              {%- if section.settings.payment_enable -%}
                {%- for type in shop.enabled_payment_types -%}
                  <div class="nvgd-payment-icon">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </div>
                {%- endfor -%}
              {%- endif -%}

              {%- if section.settings.show_payment_icons -%}
                {%- if section.settings.payment_icon_1 -%}
                  <img
                    src="{{ section.settings.payment_icon_1 | image_url: height: 30 }}"
                    alt="Payment"
                    loading="lazy"
                    width="{{ section.settings.payment_icon_1.aspect_ratio | times: 30 | round }}"
                    height="30">
                {%- endif -%}
                {%- if section.settings.payment_icon_2 -%}
                  <img
                    src="{{ section.settings.payment_icon_2 | image_url: height: 30 }}"
                    alt="Payment"
                    loading="lazy"
                    width="{{ section.settings.payment_icon_2.aspect_ratio | times: 30 | round }}"
                    height="30">
                {%- endif -%}
                {%- if section.settings.payment_icon_3 -%}
                  <img
                    src="{{ section.settings.payment_icon_3 | image_url: height: 30 }}"
                    alt="Payment"
                    loading="lazy"
                    width="{{ section.settings.payment_icon_3.aspect_ratio | times: 30 | round }}"
                    height="30">
                {%- endif -%}
                {%- if section.settings.payment_icon_4 -%}
                  <img
                    src="{{ section.settings.payment_icon_4 | image_url: height: 30 }}"
                    alt="Payment"
                    loading="lazy"
                    width="{{ section.settings.payment_icon_4.aspect_ratio | times: 30 | round }}"
                    height="30">
                {%- endif -%}
                {%- if section.settings.payment_icon_5 -%}
                  <img
                    src="{{ section.settings.payment_icon_5 | image_url: height: 30 }}"
                    alt="Payment"
                    loading="lazy"
                    width="{{ section.settings.payment_icon_5.aspect_ratio | times: 30 | round }}"
                    height="30">
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {% endif %}
</footer>

{% stylesheet %}
/* moved from inline <style> for bundling */

/*

   ============================================
   FOOTER MAIN CONTAINER
   ============================================
*/
.nvgd-footer {
  width: 100%;
  background-color: var(--nvgd-footer-bg);
  color: var(--nvgd-footer-text);
  padding: var(--nvgd-footer-pad-top) var(--nvgd-footer-pad-x) 0;
}

.nvgd-footer-container {
  max-width: var(--nvgd-footer-max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 80px;
  padding-bottom: var(--nvgd-footer-pad-bottom);
}

/*

   ============================================
   LEFT: BRAND SECTION
   ============================================
*/
.nvgd-footer-brand {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.nvgd-logo-text {
  font-size: 32px;
  font-weight: 700;
  letter-spacing: 3px;
  margin: 0;
  color: var(--nvgd-footer-text);
}

.nvgd-description {
  font-size: 14px;
  line-height: 1.6;
  color: var(--nvgd-footer-subtitle);
  margin: 0;
  white-space: pre-line;
}

.nvgd-social-icons {
  display: flex;
  gap: 12px;
}

.nvgd-social-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--nvgd-social-bg);
  color: var(--nvgd-social-color);
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: background-color 0.3s ease, transform 0.3s ease;
}

.nvgd-social-icon:hover {
  background-color: var(--nvgd-social-hover-bg);
  transform: translateY(-3px);
}


/*

   ============================================
   RIGHT: MENU COLUMNS
   ============================================
*/
.nvgd-footer-menus {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
}

.nvgd-menu-column {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.nvgd-menu-heading {
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 2px;
  color: var(--nvgd-footer-heading);
  margin: 0;
  text-transform: uppercase;
}

.nvgd-menu-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.nvgd-menu-links li a {
  font-size: 14px;
  color: var(--nvgd-footer-link);
  text-decoration: none;
  transition: color 0.2s ease;
  display: inline-block;
}

.nvgd-menu-links li a:hover {
  color: var(--nvgd-footer-link-hover);
}

.nvgd-accordion-icon {
  display: none;
}

.nvgd-accordion-trigger {
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  letter-spacing: inherit;
  text-align: left;
  text-transform: inherit;
}


/*

   ============================================
   BOTTOM: COPYRIGHT + PAYMENT
   ============================================
*/
.nvgd-footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.nvgd-footer-bottom-inner {
  max-width: var(--nvgd-footer-max-width);
  margin: 0 auto;
  padding: 24px var(--nvgd-footer-pad-x) var(--nvgd-footer-pad-bottom);
}

.nvgd-footer-bottom-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nvgd-copyright p {
  margin: 0;
  font-size: 14px;
  color: var(--nvgd-footer-bottom-text);
}

.nvgd-payment-icons {
  display: flex;
  gap: 8px;
  align-items: center;
}

.nvgd-payment-icons img,
.nvgd-payment-icon {
  height: 30px;
  width: auto;
  object-fit: contain;
}

.nvgd-payment-icons img {
  background: white;
  padding: 6px 10px;
  border-radius: 6px;
}

.nvgd-payment-icon {
  background: white;
  padding: 4px 8px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}


/*

   ============================================
   RESPONSIVE: TABLET
   ============================================
*/
@media screen and (max-width: 989px) {
  .nvgd-footer-container {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .nvgd-footer-menus {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
}


/*

   ============================================
   RESPONSIVE: MOBILE
   ============================================
*/
@media screen and (max-width: 749px) {
  .nvgd-footer {
    padding: var(--nvgd-footer-pad-top-m) var(--nvgd-footer-pad-x-m) 0;
  }

  .nvgd-footer-container {
    gap: 30px;
    padding-bottom: var(--nvgd-footer-pad-bottom-m);
  }

  .nvgd-footer-menus {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .nvgd-menu-column {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 20px 0;
  }

  /* Accordion for mobile */
  .nvgd-menu-accordion .nvgd-accordion-trigger {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .nvgd-accordion-icon {
    display: block;
    font-size: 24px;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .nvgd-menu-accordion.active .nvgd-accordion-icon {
    transform: rotate(45deg);
  }

  .nvgd-menu-accordion .nvgd-accordion-content {
    display: none;
  }

  .nvgd-menu-accordion.active .nvgd-accordion-content {
    display: flex;
    margin-top: 20px;
  }

  .nvgd-footer-bottom-content {
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .nvgd-footer-bottom-inner {
    padding: 24px var(--nvgd-footer-pad-x-m) var(--nvgd-footer-pad-bottom-m);
  }

  .nvgd-payment-icons {
    flex-wrap: wrap;
  }

  .nvgd-payment-icons img,
  .nvgd-payment-icon {
    height: 26px;
  }
}
{% endstylesheet %}

<script src="{{ 'footer-custom.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
