{% render 'section-corners', section: section %}
{% comment %}
  Product Collection List Alt Section
  
  TWO DISTINCT MODES:
  1. SERVER-SIDE MODE: On collection template pages when using the current collection
     - Uses Shopify Search & Discovery filters (collection.filters)
     - Form-based filtering with page reload
     - URL parameters reflect active filters
     - No JavaScript filtering logic
     
  2. CLIENT-SIDE MODE: When a specific collection is selected OR on non-collection pages
     - Uses JavaScript to hide/show products
     - No page reload
     - Filters via data attributes
     
  NOTE: This is an alternative version without:
  - Collections display thumbnails
  - Block content (use Collection Blocks section instead)
{% endcomment %}

{% liquid
  # Determine which collection to use
  # Priority: Selected collection in settings > Current collection on collection template
  if section.settings.collection != blank
    assign col = section.settings.collection
    # Check if we're on a collection template AND the selected collection matches the current collection
    if template.name == 'collection' and collection and collection.handle == col.handle
      assign filtering_mode = 'server'
    else
      assign filtering_mode = 'client'
    endif
  elsif template.name == 'collection' and collection
    assign col = collection
    assign filtering_mode = 'server'
  else
    assign col = null
    assign filtering_mode = 'none'
  endif
  
  assign filter_type = section.settings.filter_type
%}

{% liquid
  # ONE pass over the collection products accumulating filter counts (replaces
  # the O(N) availability loop and O(N x types)/O(N x vendors) counting loops)
  assign pcl_in_stock = 0
  assign pcl_out_stock = 0
  assign pcl_type_parts = ''
  assign pcl_vendor_parts = ''
  if filtering_mode == 'client' and col
    for product in col.products
      if product.available
        assign pcl_in_stock = pcl_in_stock | plus: 1
      else
        assign pcl_out_stock = pcl_out_stock | plus: 1
      endif
      assign pcl_type_parts = pcl_type_parts | append: product.type | append: '||'
      assign pcl_vendor_parts = pcl_vendor_parts | append: product.vendor | append: '||'
    endfor
  endif
%}

{{ 'section-product-collection-list-alt.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --pclalt-mv: {{ settings.margin_vertical }}px;
    --pclalt-mh: {{ settings.margin_horizontal }}px;
    --pclalt-pt: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px{% else %}{{ section.settings.padding_top }}px{% endif %};
    --pclalt-pb: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px{% else %}{{ section.settings.padding_bottom }}px{% endif %};
    --pclalt-pl: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal }}px{% else %}{{ section.settings.padding_left }}px{% endif %};
    --pclalt-pr: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal }}px{% else %}{{ section.settings.padding_right }}px{% endif %};
    --pclalt-pt-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px{% else %}{{ section.settings.padding_top_mobile }}px{% endif %};
    --pclalt-pb-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px{% else %}{{ section.settings.padding_bottom_mobile }}px{% endif %};
    --pclalt-pl-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.padding_left_mobile }}px{% endif %};
    --pclalt-pr-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.padding_right_mobile }}px{% endif %};
    --pclalt-outer-max: {% if section.settings.section_width == 'full' %}100%{% else %}var(--page-width, 1200px){% endif %};
    --pclalt-outer-margin: {% if section.settings.section_width == 'full' %}0{% else %}0 auto{% endif %};
    --pclalt-outer-px: {% if section.settings.section_width == 'full' %}0px{% else %}var(--page-gutter, 20px){% endif %};
    --pclalt-inner-max: {% if section.settings.content_width == 'full' %}100%{% else %}var(--page-width, 1200px){% endif %};
    --pclalt-inner-margin: {% if section.settings.content_width == 'full' %}0{% else %}0 auto{% endif %};
  }
{% endstyle %}


{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}

<div
  id="product-collection-{{ section.id }}"
  class="product-collection-{{ section.id }} section-{{ section.id }}-spacing nvgd-section-surface pclalt-section pclalt-spacing"
  data-section-id="{{ section.id }}"
  data-filter-type="{{ filter_type }}"
  data-filtering-mode="{{ filtering_mode }}"
>
  <div class="product-collection-{{ section.id }}__outer pclalt-outer">
    <div class="product-collection-{{ section.id }}__inner pclalt-inner">
      
      {% if col %}
        
        <div class="collection-layout collection-layout--{{ filter_type }}">
          
          {% if section.settings.enable_filtering %}
            <!-- ============================================== -->
            <!-- FILTER SIDEBAR                                 -->
            <!-- ============================================== -->
            <aside class="collection-sidebar {% if filter_type == 'vertical' or filter_type == 'horizontal' %}always-visible{% endif %}" id="collectionSidebar-{{ section.id }}">
              
              <div class="filter-header">
                <div class="filter-header-left">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                  </svg>
                  <span class="filter-header-title">Filter</span>
                  <span class="filter-results-count"><span id="resultsCount-{{ section.id }}">{{ col.products_count }}</span> Results</span>
                </div>
                <button type="button" class="filter-close-btn" id="filterCloseBtn-{{ section.id }}" aria-label="Close filters">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </div>

              {% comment %} ============================== {% endcomment %}
              {% comment %} SERVER-SIDE FILTERING (FORM)   {% endcomment %}
              {% comment %} ============================== {% endcomment %}
              {% if filtering_mode == 'server' %}
                <form id="filterForm-{{ section.id }}" class="filter-form" action="{{ col.url }}" method="get">
                  
                  {% comment %} Preserve sort parameter {% endcomment %}
                  {% if col.sort_by != col.default_sort_by %}
                    <input type="hidden" name="sort_by" value="{{ col.sort_by }}">
                  {% endif %}
                  
                  <div class="filter-content">
                    {% for filter in col.filters %}
                      <div class="filter-group">
                        <button type="button" class="filter-group-toggle {% if filter.active_values.size > 0 %}active{% endif %}" data-target="filter-{{ filter.param_name | handleize }}-{{ section.id }}" aria-expanded="{% if filter.active_values.size > 0 %}true{% else %}false{% endif %}" aria-controls="filter-{{ filter.param_name | handleize }}-{{ section.id }}">
                          <span>{{ filter.label }}</span>
                          <svg class="filter-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>
                        
                        <div class="filter-group-content {% if filter.active_values.size > 0 %}open{% endif %}" id="filter-{{ filter.param_name | handleize }}-{{ section.id }}">
                          {% case filter.type %}
                            
                            {% when 'list', 'boolean' %}
                              <ul class="filter-list">
                                {% for value in filter.values %}
                                  <li class="filter-list-item">
                                    <label class="filter-checkbox {% if value.count == 0 and value.active == false %}filter-checkbox--disabled{% endif %}">
                                      <input 
                                        type="checkbox"
                                        name="{{ value.param_name }}"
                                        value="{{ value.value }}"
                                        {% if value.active %}checked{% endif %}
                                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                        class="filter-checkbox-input"
                                        onchange="this.form.submit()"
                                      >
                                      <span class="checkbox-custom"></span>
                                      <span class="checkbox-label">
                                        {{ value.label }}
                                        <span class="filter-value-count">({{ value.count }})</span>
                                      </span>
                                    </label>
                                  </li>
                                {% endfor %}
                              </ul>

                            {% when 'price_range' %}
                              <div class="price-range-filter">
                                {% liquid
                                  assign min_value = filter.min_value.value | default: 0 | divided_by: 100.0
                                  assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
                                  assign range_max = filter.range_max | divided_by: 100.0
                                %}
                                <div class="price-inputs">
                                  <div class="price-input-group">
                                    <span class="price-currency">{{ cart.currency.symbol }}</span>
                                    <input 
                                      type="number"
                                      name="{{ filter.min_value.param_name }}"
                                      id="priceMin-{{ section.id }}"
                                      placeholder="Von"
                                      {% if filter.min_value.value %}value="{{ min_value | ceil }}"{% endif %}
                                      min="0"
                                      max="{{ range_max | ceil }}"
                                      class="price-input"
                                    >
                                  </div>
                                  <span class="price-separator">-</span>
                                  <div class="price-input-group">
                                    <span class="price-currency">{{ cart.currency.symbol }}</span>
                                    <input 
                                      type="number"
                                      name="{{ filter.max_value.param_name }}"
                                      id="priceMax-{{ section.id }}"
                                      placeholder="Bis"
                                      {% if filter.max_value.value %}value="{{ max_value | floor }}"{% endif %}
                                      min="0"
                                      max="{{ range_max | ceil }}"
                                      class="price-input"
                                    >
                                  </div>
                                </div>
                                <button type="submit" class="price-apply-btn">Anwenden</button>
                              </div>
                          {% endcase %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>

                  {% comment %} Clear All button at bottom of drawer {% endcomment %}
                  <div class="filter-actions-drawer">
                    <a href="{{ col.url }}{% if col.sort_by != col.default_sort_by %}?sort_by={{ col.sort_by }}{% endif %}" class="filter-clear-all-btn">
                      Clear All
                    </a>
                  </div>
                </form>

              {% comment %} ============================== {% endcomment %}
              {% comment %} CLIENT-SIDE FILTERING (JS)     {% endcomment %}
              {% comment %} ============================== {% endcomment %}
              {% elsif filtering_mode == 'client' %}
                <div class="filter-content" id="clientFilterContent-{{ section.id }}">
                  
                  {% comment %} Availability Filter {% endcomment %}
                  <div class="filter-group">
                    <button type="button" class="filter-group-toggle active" data-target="availabilityFilter-{{ section.id }}" aria-expanded="true" aria-controls="availabilityFilter-{{ section.id }}">
                      <span>Availability</span>
                      <svg class="filter-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </button>
                    <div class="filter-group-content open" id="availabilityFilter-{{ section.id }}">
                      {% assign in_stock_count = pcl_in_stock %}
                      {% assign out_of_stock_count = pcl_out_stock %}
                      <ul class="filter-list">
                        <li class="filter-list-item">
                          <label class="filter-checkbox">
                            <input type="checkbox" class="js-client-filter" data-filter-type="availability" data-filter-value="true">
                            <span class="checkbox-custom"></span>
                            <span class="checkbox-label">In stock <span class="filter-value-count">({{ in_stock_count }})</span></span>
                          </label>
                        </li>
                        {% if out_of_stock_count > 0 %}
                          <li class="filter-list-item">
                            <label class="filter-checkbox">
                              <input type="checkbox" class="js-client-filter" data-filter-type="availability" data-filter-value="false">
                              <span class="checkbox-custom"></span>
                              <span class="checkbox-label">Sold out <span class="filter-value-count">({{ out_of_stock_count }})</span></span>
                            </label>
                          </li>
                        {% endif %}
                      </ul>
                    </div>
                  </div>

                  {% comment %} Product Type Filter {% endcomment %}
                  {% assign product_types = col.products | map: 'type' | uniq | compact %}
                  {% if product_types.size > 0 %}
                    <div class="filter-group">
                      <button type="button" class="filter-group-toggle active" data-target="typeFilter-{{ section.id }}" aria-expanded="true" aria-controls="typeFilter-{{ section.id }}">
                        <span>Produktart</span>
                        <svg class="filter-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </button>
                      <div class="filter-group-content open" id="typeFilter-{{ section.id }}">
                        <ul class="filter-list">
                          {% for type in product_types %}
                            {% if type != blank %}
                              {% assign type_needle = type | append: '||' %}
                              {% assign type_count = pcl_type_parts | split: type_needle | size | minus: 1 %}
                              <li class="filter-list-item">
                                <label class="filter-checkbox">
                                  <input type="checkbox" class="js-client-filter" data-filter-type="type" data-filter-value="{{ type | handleize }}">
                                  <span class="checkbox-custom"></span>
                                  <span class="checkbox-label">{{ type }} <span class="filter-value-count">({{ type_count }})</span></span>
                                </label>
                              </li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endif %}

                  {% comment %} Vendor Filter {% endcomment %}
                  {% assign vendors = col.products | map: 'vendor' | uniq | compact %}
                  {% if vendors.size > 0 %}
                    <div class="filter-group">
                      <button type="button" class="filter-group-toggle" data-target="vendorFilter-{{ section.id }}" aria-expanded="false" aria-controls="vendorFilter-{{ section.id }}">
                        <span>Marke</span>
                        <svg class="filter-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </button>
                      <div class="filter-group-content" id="vendorFilter-{{ section.id }}">
                        <ul class="filter-list">
                          {% for vendor in vendors %}
                            {% if vendor != blank %}
                              {% assign vendor_needle = vendor | append: '||' %}
                              {% assign vendor_count = pcl_vendor_parts | split: vendor_needle | size | minus: 1 %}
                              <li class="filter-list-item">
                                <label class="filter-checkbox">
                                  <input type="checkbox" class="js-client-filter" data-filter-type="vendor" data-filter-value="{{ vendor | handleize }}">
                                  <span class="checkbox-custom"></span>
                                  <span class="checkbox-label">{{ vendor }} <span class="filter-value-count">({{ vendor_count }})</span></span>
                                </label>
                              </li>
                            {% endif %}
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endif %}

                  {% comment %} Price Filter {% endcomment %}
                  <div class="filter-group">
                    <button type="button" class="filter-group-toggle" data-target="priceFilter-{{ section.id }}" aria-expanded="false" aria-controls="priceFilter-{{ section.id }}">
                      <span>Price</span>
                      <svg class="filter-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </button>
                    <div class="filter-group-content" id="priceFilter-{{ section.id }}">
                      <div class="price-range-filter">
                        <div class="price-inputs">
                          <div class="price-input-group">
                            <span class="price-currency">€</span>
                            <input type="number" class="price-input js-client-price-min" id="clientPriceMin-{{ section.id }}" placeholder="Von" min="0">
                          </div>
                          <span class="price-separator">-</span>
                          <div class="price-input-group">
                            <span class="price-currency">€</span>
                            <input type="number" class="price-input js-client-price-max" id="clientPriceMax-{{ section.id }}" placeholder="Bis" min="0">
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {% comment %} Tags Filter {% endcomment %}
                  {% assign all_tags = col.all_tags %}
                  {% if all_tags.size > 0 %}
                    <div class="filter-group">
                      <button type="button" class="filter-group-toggle" data-target="tagsFilter-{{ section.id }}" aria-expanded="false" aria-controls="tagsFilter-{{ section.id }}">
                        <span>Tags</span>
                        <svg class="filter-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </button>
                      <div class="filter-group-content" id="tagsFilter-{{ section.id }}">
                        <ul class="filter-list">
                          {% for tag in all_tags limit: 15 %}
                            <li class="filter-list-item">
                              <label class="filter-checkbox">
                                <input type="checkbox" class="js-client-filter" data-filter-type="tag" data-filter-value="{{ tag | handleize }}">
                                <span class="checkbox-custom"></span>
                                <span class="checkbox-label">{{ tag }}</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>
                      </div>
                    </div>
                  {% endif %}
                </div>

                <div class="filter-actions-drawer">
                  <button type="button" class="filter-clear-all-btn js-client-reset" id="clientResetBtn-{{ section.id }}">
                    Clear All
                  </button>
                </div>
              {% endif %}
              
            </aside>

            {% comment %} Overlay for drawer mode {% endcomment %}
            <div class="filter-overlay" id="filterOverlay-{{ section.id }}"></div>
          {% endif %}

          <!-- ============================================== -->
          <!-- MAIN CONTENT                                   -->
          <!-- ============================================== -->
          <div class="collection-main {% if section.settings.enable_filtering and filter_type == 'vertical' %}has-sidebar{% endif %}">

            <!-- Toolbar with Active Filters inline -->
            <div class="collection-toolbar">
              <div class="toolbar-left">
                {% if section.settings.enable_filtering %}
                  <button type="button" class="filter-toggle-btn" id="filterToggleBtn-{{ section.id }}" data-filter-type="{{ filter_type }}" aria-expanded="false" aria-controls="collectionSidebar-{{ section.id }}">
                    <svg class="filter-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    <span>Filter</span>
                    <svg class="filter-chevron-btn" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                {% endif %}

                {% comment %} Active Filters - inline with toolbar {% endcomment %}
                {% if section.settings.enable_filtering %}
                  {% if filtering_mode == 'server' %}
                    {% assign has_active_filters = false %}
                    {% for filter in col.filters %}
                      {% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}
                        {% assign has_active_filters = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if has_active_filters %}
                      <div class="active-filters-inline">
                        {% for filter in col.filters %}
                          {% for value in filter.active_values %}
                            <button type="button" class="active-filter-tag js-remove-filter" data-param-name="{{ value.param_name }}" data-param-value="{{ value.value }}">
                              <span>{{ value.label }}</span>
                              <span class="active-filter-x">×</span>
                            </button>
                          {% endfor %}
                          {% if filter.type == 'price_range' %}
                            {% if filter.min_value.value or filter.max_value.value %}
                              <button type="button" class="active-filter-tag js-remove-filter" data-param-name="{{ filter.min_value.param_name }}" data-remove-price="true">
                                <span>{{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }}</span>
                                <span class="active-filter-x">×</span>
                              </button>
                            {% endif %}
                          {% endif %}
                        {% endfor %}
                        <a href="{{ col.url }}{% if col.sort_by != col.default_sort_by %}?sort_by={{ col.sort_by }}{% endif %}" class="filter-clear-link">Clear filters</a>
                      </div>
                    {% endif %}
                  {% else %}
                    <div class="active-filters-inline" id="clientActiveFilters-{{ section.id }}" style="display: none;">
                      <span class="active-filters-list" id="clientActiveFiltersList-{{ section.id }}"></span>
                      <button type="button" class="filter-clear-link js-client-clear-all" id="clientClearAll-{{ section.id }}">Clear filters</button>
                    </div>
                  {% endif %}
                {% endif %}
              </div>

              {% if section.settings.enable_sorting %}
                <div class="collection-sort">
                  <button type="button" class="sort-button" id="sortToggle-{{ section.id }}">
                    <span>{{ 'products.facets.sort_button' | t }}</span>
                    <svg class="sort-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                  <div class="sort-dropdown" id="sortDropdown-{{ section.id }}">
                    <p class="sort-title">{{ 'products.facets.sort_button' | t }}</p>
                    {% if filtering_mode == 'server' %}
                      {% assign current_sort = col.sort_by | default: col.default_sort_by %}
                      {% for option in col.sort_options %}
                        <a href="{{ col.url }}?sort_by={{ option.value }}" class="sort-option {% if option.value == current_sort %}active{% endif %}">
                          {{ option.name }}
                        </a>
                      {% endfor %}
                    {% else %}
                      <button type="button" class="sort-option js-client-sort active" data-sort="default">Featured</button>
                      <button type="button" class="sort-option js-client-sort" data-sort="title-asc">Alphabetically, A-Z</button>
                      <button type="button" class="sort-option js-client-sort" data-sort="title-desc">Alphabetically, Z-A</button>
                      <button type="button" class="sort-option js-client-sort" data-sort="price-asc">Price, low to high</button>
                      <button type="button" class="sort-option js-client-sort" data-sort="price-desc">Price, high to low</button>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            </div>

            {% if filtering_mode == 'server' %}
              {% paginate col.products by section.settings.products_per_page %}
                {% render 'product-collection-grid', products: col.products, product_limit: section.settings.products_per_page %}
                {% if paginate.pages > 1 %}
                  <div class="pagination">
                    {{ paginate | default_pagination }}
                  </div>
                {% endif %}
              {% endpaginate %}
            {% else %}
              {% render 'product-collection-grid', products: col.products, product_limit: section.settings.products_per_page %}
            {% endif %}

            <!-- No Results -->
            <div class="no-results-message" id="noResults-{{ section.id }}" {% unless col.products.size == 0 %}style="display: none;"{% endunless %}>
              <p>No products found. Please adjust your filters.</p>
              {% if filtering_mode == 'server' %}
                <a href="{{ col.url }}" class="filter-reset-link">{{ 'products.facets.clear_all' | t }}</a>
              {% else %}
                <button type="button" class="filter-reset-link js-client-reset">{{ 'products.facets.clear_all' | t }}</button>
              {% endif %}
            </div>

          </div>
        </div>
        
      {% else %}
        <p>No collection selected</p>
      {% endif %}
    </div>
  </div>
</div>


<script src="{{ 'section-product-collection-list-alt.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product collection alt",
  "settings": [
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
