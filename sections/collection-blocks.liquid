                            {% if block.settings.header_col3 != blank %}<td>{% if block.settings.row2_col3 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col4 != blank %}<td>{% if block.settings.row2_col4 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col5 != blank %}<td>{% if block.settings.row2_col5 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col6 != blank %}<td>{% if block.settings.row2_col6 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                          </tr>
