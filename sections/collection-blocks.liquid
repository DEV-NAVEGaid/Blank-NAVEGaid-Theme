      "max": 10,
      "step": 1,
      "default": 1,
      "unit": "px",
      "label": "Border width (Mobile)",
      "info": "Only applies if 'Hide border on mobile' is unchecked"
    },
    {
      "type": "range",
      "id": "border_padding_mobile",
