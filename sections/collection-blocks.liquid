                            </td>
                            {% if block.settings.header_col2 != blank %}<td>{% if block.settings.row1_col2 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col3 != blank %}<td>{% if block.settings.row1_col3 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col4 != blank %}<td>{% if block.settings.row1_col4 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col5 != blank %}<td>{% if block.settings.row1_col5 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col6 != blank %}<td>{% if block.settings.row1_col6 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                          </tr>
