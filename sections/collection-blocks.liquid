                            {% endif %}
                            {% if block.settings.header_col6 != blank %}
                              <th>
                                {% if block.settings.header_col6_link != blank %}
                                  <a href="{{ block.settings.header_col6_link }}">{{ block.settings.header_col6 }}</a>
                                {% else %}
                                  {{ block.settings.header_col6 }}
                                {% endif %}
                              </th>
                            {% endif %}
                          </tr>
                        </thead>
                        <tbody>
                          {% comment %} Row 1 {% endcomment %}
                          {% if block.settings.row1_feature != blank %}
                          <tr>
                            <td class="feature-column">
                              {% if block.settings.row1_link != blank %}
