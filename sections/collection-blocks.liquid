                              {% endif %}
                            </td>
                            {% if block.settings.header_col2 != blank %}<td>{% if block.settings.row8_col2 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col3 != blank %}<td>{% if block.settings.row8_col3 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
