                                {{ block.settings.row3_feature }}
                              {% endif %}
                            </td>
                            {% if block.settings.header_col2 != blank %}<td>{% if block.settings.row3_col2 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col3 != blank %}<td>{% if block.settings.row3_col3 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col4 != blank %}<td>{% if block.settings.row3_col4 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col5 != blank %}<td>{% if block.settings.row3_col5 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col6 != blank %}<td>{% if block.settings.row3_col6 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                          </tr>
                          {% endif %}
                          
                          {% comment %} Row 4 {% endcomment %}
                          {% if block.settings.row4_feature != blank %}
                          <tr>
                            <td class="feature-column">
                              {% if block.settings.row4_link != blank %}
                                <a href="{{ block.settings.row4_link }}">{{ block.settings.row4_feature }}</a>
                              {% else %}
                                {{ block.settings.row4_feature }}
                              {% endif %}
                            </td>
                            {% if block.settings.header_col2 != blank %}<td>{% if block.settings.row4_col2 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col3 != blank %}<td>{% if block.settings.row4_col3 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col4 != blank %}<td>{% if block.settings.row4_col4 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col5 != blank %}<td>{% if block.settings.row4_col5 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col6 != blank %}<td>{% if block.settings.row4_col6 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                          </tr>
                          {% endif %}
                          
                          {% comment %} Row 5 {% endcomment %}
                          {% if block.settings.row5_feature != blank %}
                          <tr>
                            <td class="feature-column">
                              {% if block.settings.row5_link != blank %}
                                <a href="{{ block.settings.row5_link }}">{{ block.settings.row5_feature }}</a>
                              {% else %}
                                {{ block.settings.row5_feature }}
                              {% endif %}
                            </td>
                            {% if block.settings.header_col2 != blank %}<td>{% if block.settings.row5_col2 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col3 != blank %}<td>{% if block.settings.row5_col3 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col4 != blank %}<td>{% if block.settings.row5_col4 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col5 != blank %}<td>{% if block.settings.row5_col5 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                            {% if block.settings.header_col6 != blank %}<td>{% if block.settings.row5_col6 %}<span class="table-checkmark">✓</span>{% endif %}</td>{% endif %}
                          </tr>
