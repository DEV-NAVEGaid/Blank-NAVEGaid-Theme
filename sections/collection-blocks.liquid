    {
      "type": "header",
      "content": "Border Left Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_border_left",
      "default": true,
      "label": "Enable border left"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E5E5E5"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1,
      "unit": "px",
      "label": "Border width (Desktop)"
    },
    {
      "type": "range",
      "id": "border_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "Padding from border (Desktop)"
    },
    {
      "type": "checkbox",
      "id": "hide_border_mobile",
      "default": true,
      "label": "Hide border on mobile"
    },
    {
      "type": "range",
      "id": "border_width_mobile",
