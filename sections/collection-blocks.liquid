                    --text-block-link-color: {{ block.settings.link_color }};
                  ">
                    {% assign text_tag = block.settings.text_style %}
                    <div class="text-block text-style-{{ text_tag }}" style="
                      color: {{ block.settings.text_color }};
                      text-align: {{ block.settings.text_alignment }};
                      margin-bottom: {{ block.settings.margin_bottom }}px;
