                    <{{ heading_tag }} class="heading-block heading-style-{{ heading_tag }}" style="
                      color: {{ block.settings.text_color }};
                      text-align: {{ block.settings.text_alignment }};
                      margin-bottom: {{ block.settings.margin_bottom }}px;
                    ">{{ block.settings.heading_text }}</{{ heading_tag }}>
                  </div>

                {% comment %} SUBHEADING BLOCK {% endcomment %}
                {% when 'subheading' %}
                  <div class="block-subheading-{{ section.id }} cb-block-subheading" {{ block.shopify_attributes }}>
                    {% assign subheading_tag = block.settings.subheading_style %}
                    <{{ subheading_tag }} class="subheading-block subheading-style-{{ subheading_tag }}" style="
                      color: {{ block.settings.text_color }};
                      text-align: {{ block.settings.text_alignment }};
                      margin-bottom: {{ block.settings.margin_bottom }}px;
                      {% if block.settings.uppercase %}text-transform: uppercase; letter-spacing: 0.1em;{% endif %}
                    ">{{ block.settings.subheading_text }}</{{ subheading_tag }}>
                  </div>

                {% comment %} TEXT BLOCK {% endcomment %}
                {% when 'text' %}
