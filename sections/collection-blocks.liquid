  id="collection-blocks-{{ section.id }}"
  class="collection-blocks-{{ section.id }} section-{{ section.id }}-spacing cb-section"
  data-section-id="{{ section.id }}"
  data-faq-behavior="{{ section.settings.faq_collapse_behavior }}"
