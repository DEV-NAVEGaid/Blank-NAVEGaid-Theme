{% render 'section-corners', section: section %}
{% comment %}
  Collection Blocks Section
  
  A standalone section for content blocks (Heading, Subheading, Text, FAQ)
  that can be used alongside the Product Collection List Alt section.
  
  Features:
  - Optional border-left styling on the blocks wrapper
  - Configurable border color, width, and padding
  - FAQ accordion with single/multiple open behavior
  - Responsive design
  
  BLOCKS:
  - Heading: Configurable H1-H6 styles
  - Subheading: Configurable styles with optional uppercase
  - Text: Rich text content with configurable styles
  - FAQ: Collapsible accordion rows
{% endcomment %}

{% liquid
  if section.settings.enable_global_spacing
    assign cb_pt = settings.padding_vertical
    assign cb_pb = settings.padding_vertical
    assign cb_pl = settings.padding_horizontal
    assign cb_pr = settings.padding_horizontal
    assign cb_pt_m = settings.padding_vertical_mobile
    assign cb_pb_m = settings.padding_vertical_mobile
    assign cb_pl_m = settings.padding_horizontal_mobile
    assign cb_pr_m = settings.padding_horizontal_mobile
  else
    assign cb_pt = section.settings.padding_top
    assign cb_pb = section.settings.padding_bottom
    assign cb_pl = section.settings.padding_left
    assign cb_pr = section.settings.padding_right
    assign cb_pt_m = section.settings.padding_top_mobile
    assign cb_pb_m = section.settings.padding_bottom_mobile
    assign cb_pl_m = section.settings.padding_left_mobile
    assign cb_pr_m = section.settings.padding_right_mobile
  endif
  assign cb_mv = settings.margin_vertical
  assign cb_mh = settings.margin_horizontal

  if section.settings.section_width == 'full'
    assign cb_outer_max = '100%'
    assign cb_outer_margin = '0'
    assign cb_outer_px = '0px'
  else
    assign cb_outer_max = 'var(--page-width, 1200px)'
    assign cb_outer_margin = '0 auto'
    assign cb_outer_px = 'var(--page-gutter, 20px)'
  endif

  if section.settings.content_width == 'full'
    assign cb_inner_max = '100%'
    assign cb_inner_margin = '0'
  else
    assign cb_inner_max = 'var(--page-width, 1200px)'
    assign cb_inner_margin = '0 auto'
  endif

  if section.settings.hide_border_mobile
    assign cb_bl_w_m = '0px'
    assign cb_bl_pad_m = '0px'
  else
    assign cb_bl_w_m = section.settings.border_width_mobile | append: 'px'
    assign cb_bl_pad_m = section.settings.border_padding_mobile | append: 'px'
  endif
%}

{{ 'section-collection-blocks.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --cb-pt: {{ cb_pt }}px;
    --cb-pb: {{ cb_pb }}px;
    --cb-pl: {{ cb_pl }}px;
    --cb-pr: {{ cb_pr }}px;
    --cb-pt-m: {{ cb_pt_m }}px;
    --cb-pb-m: {{ cb_pb_m }}px;
    --cb-pl-m: {{ cb_pl_m }}px;
    --cb-pr-m: {{ cb_pr_m }}px;
    --cb-mv: {{ cb_mv }}px;
    --cb-mh: {{ cb_mh }}px;
    --cb-outer-max: {{ cb_outer_max }};
    --cb-outer-margin: {{ cb_outer_margin }};
    --cb-outer-px: {{ cb_outer_px }};
    --cb-inner-max: {{ cb_inner_max }};
    --cb-inner-margin: {{ cb_inner_margin }};
    --cb-bl-w: {{ section.settings.border_width }}px;
    --cb-bl-color: {{ section.settings.border_color }};
    --cb-bl-pad: {{ section.settings.border_padding }}px;
    --cb-bl-w-m: {{ cb_bl_w_m }};
    --cb-bl-pad-m: {{ cb_bl_pad_m }};
    --cb-faq-border-color: {{ section.settings.faq_border_color }};
    --cb-faq-pad-y: {{ section.settings.faq_padding_vertical }}px;
    --cb-faq-pad-y-m: {{ section.settings.faq_padding_vertical_mobile }}px;
    --cb-faq-q-size: {{ section.settings.faq_question_font_size_desktop }}px;
    --cb-faq-q-size-m: {{ section.settings.faq_question_font_size_mobile }}px;
    --cb-faq-q-weight: {{ section.settings.faq_question_font_weight }};
    --cb-faq-q-color: {{ section.settings.faq_question_color }};
    --cb-faq-a-size: {{ section.settings.faq_answer_font_size_desktop }}px;
    --cb-faq-a-size-m: {{ section.settings.faq_answer_font_size_mobile }}px;
    --cb-faq-a-weight: {{ section.settings.faq_answer_font_weight }};
    --cb-faq-a-color: {{ section.settings.faq_answer_color }};
    --cb-faq-arrow-size: {{ section.settings.faq_arrow_size }}px;
    --cb-faq-arrow-size-m: {{ section.settings.faq_arrow_size_mobile }}px;
    --cb-faq-arrow-color: {{ section.settings.faq_arrow_color }};
    --cb-arrow-color: {{ section.settings.faq_arrow_color }};
    --cb-tbl-mb: {{ section.settings.table_margin_bottom }}px;
    --cb-tbl-weight: {{ section.settings.table_font_weight }};
    --cb-tbl-cell-pad: {{ section.settings.table_cell_padding }}px;
    --cb-tbl-cell-pad-m: {{ section.settings.table_cell_padding_mobile }}px;
    --cb-tbl-border: {{ section.settings.table_border_color }};
    --cb-tbl-header-bg: {{ section.settings.table_header_bg }};
    --cb-tbl-header-color: {{ section.settings.table_header_color }};
    --cb-tbl-feature-color: {{ section.settings.table_feature_color }};
    --cb-tbl-row-bg: {{ section.settings.table_row_bg }};
    --cb-tbl-check-color: {{ section.settings.table_checkmark_color }};
    --cb-tbl-footer-mt: {{ section.settings.table_footer_margin_top }}px;
    --cb-tbl-footer-color: {{ section.settings.table_footer_color }};
    --cb-tbl-footer-link-color: {{ section.settings.table_footer_link_color }};
  }
{% endstyle %}

