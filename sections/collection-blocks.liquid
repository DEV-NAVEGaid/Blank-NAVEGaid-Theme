                                {% if block.settings.header_col3_link != blank %}
                                  <a href="{{ block.settings.header_col3_link }}">{{ block.settings.header_col3 }}</a>
                                {% else %}
                                  {{ block.settings.header_col3 }}
                                {% endif %}
                              </th>
                            {% endif %}
                            {% if block.settings.header_col4 != blank %}
                              <th>
                                {% if block.settings.header_col4_link != blank %}
                                  <a href="{{ block.settings.header_col4_link }}">{{ block.settings.header_col4 }}</a>
                                {% else %}
                                  {{ block.settings.header_col4 }}
                                {% endif %}
                              </th>
                            {% endif %}
                            {% if block.settings.header_col5 != blank %}
                              <th>
                                {% if block.settings.header_col5_link != blank %}
