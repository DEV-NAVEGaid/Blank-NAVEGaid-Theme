{% render 'section-corners', section: section %}

{% liquid
  assign use_manual = section.settings.use_manual_products
  assign max_products = 6

  if use_manual
    assign products_to_show = section.blocks | where: "type", "product"
    assign product_count = 0

    for block in products_to_show
      if block.settings.product != blank
        assign product_count = product_count | plus: 1
      endif
    endfor
  else
    assign collection = collections[section.settings.collection]
    if collection != blank
      assign current_product_id = product.id
      assign all_products = collection.products
        assign product_count = 0

      for product_item in all_products limit: 7
        if product_item.id != current_product_id and product_count < max_products
          assign product_count = product_count | plus: 1
        endif
      endfor
    else
      assign product_count = 0
    endif
  endif

  assign show_slider = false

  if product_count > 3
    assign show_slider = true
  endif
%}

<div
  class="upsell-section upsell-section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    --section-pt-desktop: {{ section.settings.section_pt_desktop }}px;
    --section-pb-desktop: {{ section.settings.section_pb_desktop }}px;
    --section-pt-mobile: {{ section.settings.section_pt_mobile }}px;
    --section-pb-mobile: {{ section.settings.section_pb_mobile }}px;
    --section-bg-color: {{ section.settings.section_bg_color }};
    --section-text-color: {{ section.settings.section_text_color }};
    --title-color: {{ section.settings.title_color }};
    --title-font-size-desktop: {{ section.settings.title_font_size_desktop }}px;
    --title-font-size-mobile: {{ section.settings.title_font_size_mobile }}px;
    --title-margin-bottom: {{ section.settings.title_margin_bottom }}px;
    --title-margin-bottom-mobile: {{ section.settings.title_margin_bottom_mobile }}px;
    --product-title-font-size: {{ section.settings.product_title_font_size }}px;
    --product-title-color: {{ section.settings.product_title_color }};
    --product-price-font-size: {{ section.settings.product_price_font_size }}px;
    --product-price-color: {{ section.settings.product_price_color }};
    --product-compare-price-font-size: {{ section.settings.product_compare_price_font_size }}px;
    --label-bg-color: {{ section.settings.label_bg_color }};
    --label-text-color: {{ section.settings.label_text_color }};
  "
>
  <div class="upsell-container">
    {% if section.settings.title != blank %}
      <h2 class="upsell-title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if product_count > 0 %}
      <div class="upsell-wrapper">
        {% if show_slider %}
          <button class="upsell-arrow upsell-arrow--prev" aria-label="Previous products">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="upsell-slider-wrapper">
            <div class="upsell-slider">
              {% if use_manual %}
                {% for block in section.blocks %}
                  {% if block.type == "product" and block.settings.product != blank %}
                    {% render 'upsell-product-card', product: block.settings.product, block: block, section: section %}
                  {% endif %}
                {% endfor %}
              {% else %}
                {% assign render_count = 0 %}
                {% for product_item in collection.products limit: 7 %}
                  {% if product_item.id != current_product_id and render_count < max_products %}
                    {% render 'upsell-product-card', product: product_item, section: section %}
                    {% assign render_count = render_count | plus: 1 %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <button class="upsell-arrow upsell-arrow--next" aria-label="Next products">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        {% else %}
          <div class="upsell-grid">
            {% if use_manual %}
              {% for block in section.blocks %}
                {% if block.type == "product" and block.settings.product != blank %}
                  {% render 'upsell-product-card', product: block.settings.product, block: block, section: section %}
                {% endif %}
              {% endfor %}
            {% else %}
              {% assign render_count = 0 %}
              {% for product_item in collection.products limit: 7 %}
                {% if product_item.id != current_product_id and render_count < max_products %}
                  {% render 'upsell-product-card', product: product_item, section: section %}
                  {% assign render_count = render_count | plus: 1 %}
                {% endif %}
              {% endfor %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="upsell-empty">
        <p>No products available for upsell. Please configure the section settings.</p>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
.upsell-section {
  width: 100%;
  overflow: hidden;
  position: relative;
  padding-top: var(--section-pt-desktop, 60px);
  padding-bottom: var(--section-pb-desktop, 60px);
  background-color: var(--section-bg-color, #F5F5F5);
  color: var(--section-text-color, #111111);
}

@media (max-width: 768px) {
  .upsell-section {
    padding-top: var(--section-pt-mobile, 40px);
    padding-bottom: var(--section-pb-mobile, 40px);
  }
}

.upsell-section--page-width .upsell-container {
  max-width: var(--page-width, 1200px);
  margin: 0 auto;
  padding: 0 20px;
}

.upsell-section--full-width .upsell-container {
  width: 100%;
  padding: 0 20px;
}

.upsell-title {
  text-align: center;
  margin: 0 0 var(--title-margin-bottom, 48px);
  font-size: var(--title-font-size-desktop, 2.5rem);
  font-weight: 700;
  line-height: 1.2;
  color: var(--title-color, inherit);
}

@media (max-width: 768px) {
  .upsell-title {
    font-size: var(--title-font-size-mobile, 1.75rem);
    margin-bottom: var(--title-margin-bottom-mobile, 32px);
  }
}

.upsell-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

/* Grid layout for 3 or fewer items */
.upsell-grid {
  display: flex;
  gap: 24px;
  width: 100%;
  justify-content: center;
  flex-wrap: wrap;
}

.upsell-grid .upsell-product-card {
  width: 100%;
  max-width: 380px;
  flex: 0 0 auto;
}

@media (min-width: 769px) {
  .upsell-grid .upsell-product-card {
    width: calc(33.333% - 16px);
    max-width: 380px;
  }
}

@media (max-width: 768px) {
  .upsell-grid .upsell-product-card {
    width: 100%;
    max-width: 100%;
  }
}

/* Slider layout for more than 3 items */
.upsell-slider-wrapper {
  overflow: hidden;
  flex: 1;
  width: 100%;
}

.upsell-slider {
  display: flex;
  transition: transform 0.5s ease-in-out;
  gap: 24px;
}

@media (max-width: 768px) {
  .upsell-slider {
    transition: none;
    scroll-snap-type: x mandatory;
  }
}

.upsell-slider .upsell-product-card {
  min-width: calc(33.333% - 16px);
  max-width: 380px;
  flex-shrink: 0;
}

@media (max-width: 1024px) {
  .upsell-slider .upsell-product-card {
    min-width: calc(50% - 12px);
    max-width: 380px;
  }
}

@media (max-width: 768px) {
  .upsell-slider .upsell-product-card {
    min-width: calc(100% - 40px);
    max-width: 100%;
    scroll-snap-align: start;
  }
}

/* Product Card */
.upsell-product-card {
  background: white;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
  height: 100%;
  text-decoration: none;
  color: inherit;
}

.upsell-product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
}

.upsell-product-card__image-wrapper {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  background: #FFFFFF;
}

.upsell-product-card__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Sale Label */
.upsell-product-card__label {
  position: absolute;
  top: 12px;
  left: 12px;
  background-color: var(--label-bg-color, #111111);
  color: var(--label-text-color, #FFFFFF);
  padding: 6px 12px;
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: 4px;
  z-index: 5;
  clip-path: polygon(0 0, 100% 0, 95% 100%, 0% 100%);
  min-width: 60px;
  text-align: left;
}

.upsell-product-card__content {
  padding: 20px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.upsell-product-card__title {
  font-size: var(--product-title-font-size, 1.125rem);
  font-weight: 600;
  margin: 0 0 12px;
  line-height: 1.4;
  color: var(--product-title-color, inherit);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.upsell-product-card__price-wrapper {
  display: flex;
  align-items: baseline;
  gap: 8px;
  flex-wrap: wrap;
}

.upsell-product-card__price {
  font-size: var(--product-price-font-size, 1.25rem);
  font-weight: 700;
  color: var(--product-price-color, inherit);
}

.upsell-product-card__compare-price {
  font-size: var(--product-compare-price-font-size, 1rem);
  color: #999;
  text-decoration: line-through;
}

.upsell-product-card__link {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

/* Arrows */
.upsell-arrow {
  background: white;
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
  z-index: 10;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
}

.upsell-arrow--prev {
  left: -60px;
}

.upsell-arrow--next {
  right: -60px;
}

.upsell-section--full-width .upsell-arrow--prev {
  left: 10px;
}

.upsell-section--full-width .upsell-arrow--next {
  right: 10px;
}

.upsell-arrow:hover {
  background: rgba(0, 0, 0, 0.05);
  border-color: rgba(0, 0, 0, 0.2);
}

.upsell-arrow svg {
  color: rgba(0, 0, 0, 0.8);
}

.upsell-arrow--hidden {
  display: none;
}

@media (max-width: 768px) {
  .upsell-arrow {
    display: none;
  }

  .upsell-grid {
    grid-template-columns: 1fr;
  }

  .upsell-slider-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .upsell-slider-wrapper::-webkit-scrollbar {
    display: none;
  }
}

/* Empty state */
.upsell-empty {
  text-align: center;
  padding: 60px 20px;
  color: #666;
}
{% endstylesheet %}

<script src="{{ 'upsell-section.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product upsell",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "checkbox",
      "id": "use_manual_products",
      "label": "Use manual product selection",
      "info": "Toggle to manually select products or use automatic collection-based selection",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection will be shown (excludes current product). Only used when manual selection is OFF."
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "Section text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "product_price_color",
      "label": "Product price color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Sale label"
    },
    {
      "type": "color",
      "id": "label_bg_color",
      "label": "Label background color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "label": "Title font size (desktop)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "label": "Title font size (mobile)",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "label": "Title margin bottom (desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_margin_bottom_mobile",
      "label": "Title margin bottom (mobile)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "product_title_font_size",
      "label": "Product title font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "product_price_font_size",
      "label": "Product price font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "product_compare_price_font_size",
      "label": "Compare price font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding (desktop)"
    },
    {
      "type": "range",
      "id": "section_pt_desktop",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_pb_desktop",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Padding (mobile)"
    },
    {
      "type": "range",
      "id": "section_pt_mobile",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_pb_mobile",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section corners"
    },
    {
      "type": "checkbox",
      "id": "custom_section_corners",
      "label": "Customize section corners",
      "default": false
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_section_corners }}"
    },
    {
      "type": "checkbox",
      "id": "clip_section_corners",
      "label": "Clip content to corners",
      "default": false,
      "info": "Enable for edge-to-edge images. Leave off for menus, popups, sticky content, or overlapping elements.",
      "visible_if": "{{ section.settings.custom_section_corners and section.settings.section_corner_radius > 0 }}"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Manual product",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product upsell"
    }
  ]
}
{% endschema %}
