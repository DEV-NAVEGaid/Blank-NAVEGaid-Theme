      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "left_heading_margin",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 15,
      "unit": "px",
      "label": "Heading margin bottom"
    },
    {
      "type": "text",
      "id": "heading_highlight_text",
      "label": "Heading highlight text",
      "info": "Enter text from heading to highlight with a different color"
    },
    {
      "type": "color",
      "id": "heading_highlight_color",
      "label": "Heading highlight color",
      "default": "#F5F5F5"
    },
    {
      "type": "header",
      "content": "Left column text"
    },
    {
      "type": "textarea",
      "id": "left_text",
      "label": "Text content",
      "default": "Text"
    },
    {
      "type": "select",
      "id": "left_text_tag",
      "label": "Text tag",
      "options": [
        {
          "value": "p",
          "label": "Paragraph"
        },
        {
          "value": "span",
          "label": "Span"
        },
        {
          "value": "div",
          "label": "Div"
        }
      ],
      "default": "p"
    },
    {
      "type": "select",
      "id": "left_text_weight",
      "label": "Text font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "text_highlight_text",
