{% comment %}
  Card Alt Section
  
  A flexible two-column card layout with:
  - Left side: Optional image + heading + text with highlight support
  - Divider: Optional vertical divider between columns
  - Right side: Image display
  
  Features:
  - Configurable column widths and alignment
  - Text highlighting with custom colors
  - Responsive mobile layout
  - Full padding and spacing controls
{% endcomment %}

{% assign section_id = section.id | replace: '_', '' | downcase %}

{% liquid
  if section.settings.enable_global_spacing
    assign ca_pt = settings.padding_vertical
    assign ca_pb = settings.padding_vertical
    assign ca_pl = settings.padding_horizontal
    assign ca_pr = settings.padding_horizontal
    assign ca_pt_m = ca_pt
    assign ca_pb_m = ca_pb
    assign ca_pl_m = ca_pl
    assign ca_pr_m = ca_pr
    assign ca_mv = settings.margin_vertical
    assign ca_mh = settings.margin_horizontal
  else
    assign ca_pt = section.settings.section_padding_top
    assign ca_pb = section.settings.section_padding_bottom
    assign ca_pl = section.settings.section_padding_left
    assign ca_pr = section.settings.section_padding_right
    assign ca_pt_m = section.settings.section_padding_top_mobile
    assign ca_pb_m = section.settings.section_padding_bottom_mobile
    assign ca_pl_m = section.settings.section_padding_left_mobile
    assign ca_pr_m = section.settings.section_padding_right_mobile
    assign ca_mv = 0
    assign ca_mh = 0
  endif

  if section.settings.left_text_align == 'center'
    assign ca_limg_ml = 'auto'
    assign ca_limg_mr = 'auto'
  elsif section.settings.left_text_align == 'right'
    assign ca_limg_ml = 'auto'
    assign ca_limg_mr = '0'
  else
    assign ca_limg_ml = '0'
    assign ca_limg_mr = '0'
  endif

  if section.settings.show_divider
    assign ca_grid_cols = section.settings.left_column_width | append: '% minmax(20px, 60px) 1fr'
  else
    assign ca_grid_cols = section.settings.left_column_width | append: '% 1fr'
  endif
%}

{{ 'section-card-alt.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --ca-pt: {{ ca_pt }}px;
    --ca-pb: {{ ca_pb }}px;
    --ca-pl: {{ ca_pl }}px;
    --ca-pr: {{ ca_pr }}px;
    --ca-pt-m: {{ ca_pt_m }}px;
    --ca-pb-m: {{ ca_pb_m }}px;
    --ca-pl-m: {{ ca_pl_m }}px;
    --ca-pr-m: {{ ca_pr_m }}px;
    --ca-mv: {{ ca_mv }}px;
    --ca-mh: {{ ca_mh }}px;
    --ca-wp-y: {{ section.settings.wrapper_padding_y }}px;
    --ca-wp-x: {{ section.settings.wrapper_padding_x }}px;
    --ca-wp-y-m: {{ section.settings.wrapper_padding_y_mobile }}px;
    --ca-wp-x-m: {{ section.settings.wrapper_padding_x_mobile }}px;
    --ca-bg: {{ section.settings.bg_color }};
    --ca-radius: {{ section.settings.border_radius }}px;
    --ca-radius-m: {{ section.settings.border_radius_mobile }}px;
    --ca-pad-y: {{ section.settings.padding_y }}px;
    --ca-pad-x: {{ section.settings.padding_x }}px;
    --ca-pad-y-m: {{ section.settings.padding_y_mobile }}px;
    --ca-pad-x-m: {{ section.settings.padding_x_mobile }}px;
    --ca-width: {{ section.settings.card_width }}%;
    --ca-width-m: {{ section.settings.card_width_mobile }}%;
    --ca-cols: {{ ca_grid_cols }};
    --ca-gap: {{ section.settings.gap }}px;
    --ca-gap-m: {{ section.settings.gap_mobile }}px;
    --ca-div-align: {{ section.settings.divider_align }};
    --ca-div-w: {{ section.settings.divider_width }}px;
    --ca-div-color: {{ section.settings.divider_color }};
    --ca-left-align: {{ section.settings.left_text_align }};
    --ca-limg-w: {{ section.settings.left_image_width }}%;
    --ca-limg-radius: {{ section.settings.left_image_radius }}px;
    --ca-limg-mb: {{ section.settings.left_image_spacing }}px;
    --ca-limg-ml: {{ ca_limg_ml }};
    --ca-limg-mr: {{ ca_limg_mr }};
    --ca-h-weight: {{ section.settings.left_heading_weight }};
    --ca-h-color: {{ section.settings.left_heading_color }};
    --ca-h-mb: {{ section.settings.left_heading_margin }}px;
    --ca-h-hl: {{ section.settings.heading_highlight_color }};
    --ca-t-weight: {{ section.settings.left_text_weight }};
    --ca-t-color: {{ section.settings.left_text_color }};
    --ca-t-hl: {{ section.settings.text_highlight_color }};
    --ca-r-justify: {{ section.settings.right_image_align }};
    --ca-rimg-w: {{ section.settings.right_image_width }}%;
    --ca-rimg-radius: {{ section.settings.right_image_radius }}px;
  }
{% endstyle %}

<div
  id="card-alt-{{ section.id }}"
  class="card-alt-section-{{ section_id }} ca-section"
  data-section-id="{{ section.id }}"
>
  <div class="card-alt-wrapper-{{ section_id }} ca-wrapper">
    <div class="card-alt-container-{{ section_id }} ca-container">
      
      <!-- LEFT SIDE: Image + Text -->
      <div class="card-alt-left-{{ section_id }} ca-left">
        {% if section.settings.left_image != blank %}
          <div class="card-alt-left-image-{{ section_id }} ca-left-image">
            <img 
              src="{{ section.settings.left_image | image_url: width: 600 }}" 
              alt="{{ section.settings.left_heading | escape }}" 
              loading="lazy"
              width="{{ section.settings.left_image.width }}"
              height="{{ section.settings.left_image.height }}"
            >
          </div>
        {% endif %}

        {% if section.settings.left_heading != blank %}
          {% assign heading_text = section.settings.left_heading %}
          {% if section.settings.heading_highlight_text != blank %}
            {% assign highlight = section.settings.heading_highlight_text %}
            {% assign replacement = '<span class="highlight-text">' | append: highlight | append: '</span>' %}
            {% assign heading_text = heading_text | replace_first: highlight, replacement %}
          {% endif %}
          <{{ section.settings.left_heading_tag }} class="card-alt-left-heading-{{ section_id }} ca-left-heading">
            {{ heading_text }}
          </{{ section.settings.left_heading_tag }}>
        {% endif %}

        {% if section.settings.left_text != blank %}
          {% assign text_content = section.settings.left_text %}
          {% if section.settings.text_highlight_text != blank %}
            {% assign text_highlight = section.settings.text_highlight_text %}
            {% assign replacement = '<span class="highlight-text">' | append: text_highlight | append: '</span>' %}
            {% assign text_content = text_content | replace_first: text_highlight, replacement %}
          {% endif %}
          <{{ section.settings.left_text_tag }} class="card-alt-left-text-{{ section_id }} ca-left-text">
            {{ text_content | newline_to_br }}
          </{{ section.settings.left_text_tag }}>
        {% endif %}
      </div>

      <!-- DIVIDER -->
      {% if section.settings.show_divider %}
        <div class="card-alt-divider-container-{{ section_id }} ca-divider-container">
          <div class="card-alt-divider-{{ section_id }} ca-divider"></div>
        </div>
      {% endif %}

      <!-- RIGHT SIDE: Image Only -->
      <div class="card-alt-right-{{ section_id }} ca-right">
        {% if section.settings.right_image != blank %}
          <div class="card-alt-right-image-{{ section_id }} ca-right-image">
            <img 
              src="{{ section.settings.right_image | image_url: width: 1000 }}" 
              alt="{{ section.settings.right_image.alt | default: '' | escape }}" 
              loading="lazy"
              width="{{ section.settings.right_image.width }}"
              height="{{ section.settings.right_image.height }}"
            >
          </div>
        {% else %}
          <div class="card-alt-right-image-{{ section_id }} card-alt-placeholder">
            {% if request.design_mode %}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>


{% schema %}
{
  "name": "Alternate card",
  "tag": "section",
  "class": "card-alt-section",
  "settings": [
    {
      "type": "header",
      "content": "Left column image"
