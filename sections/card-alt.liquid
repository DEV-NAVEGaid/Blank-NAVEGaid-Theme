    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left image"
    },
    {
      "type": "range",
      "id": "left_image_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "label": "Left image width"
    },
    {
      "type": "range",
      "id": "left_image_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 0,
      "unit": "px",
      "label": "Left image border radius"
    },
    {
      "type": "range",
      "id": "left_image_spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "px",
      "label": "Space below left image"
    },
    {
      "type": "header",
      "content": "Left column heading"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Heading text",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "left_heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "left_heading_weight",
      "label": "Heading font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
