{% render 'section-corners', section: section %}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .main-blog-{{ section.id }} .title--primary {
    font-family: {{ section.settings.heading_font | default: 'var(--font-heading-family)' }};
    color: {{ section.settings.heading_color | default: 'currentColor' }};
    font-weight: {{ section.settings.heading_weight | default: 600 }};
    text-decoration: {{ section.settings.heading_decoration | default: 'none' }};
  }
  .main-blog-{{ section.id }} .article-card .card__heading,
  .main-blog-{{ section.id }} .article-card .card__heading a {
    font-family: {{ section.settings.card_heading_font | default: 'var(--font-heading-family)' }};
    font-size: {{ section.settings.card_heading_size | default: 24 }}px;
    color: {{ section.settings.card_heading_color | default: 'currentColor' }};
    font-weight: {{ section.settings.card_heading_weight | default: 600 }};
    text-decoration: {{ section.settings.card_heading_decoration | default: 'none' }};
  }
  .main-blog-{{ section.id }} .article-card__excerpt,
  .main-blog-{{ section.id }} .article-card__info .caption-with-letter-spacing {
    font-family: {{ section.settings.card_text_font | default: 'var(--font-body-family)' }};
    font-size: {{ section.settings.card_text_size | default: 16 }}px;
    color: {{ section.settings.card_text_color | default: 'currentColor' }};
    font-weight: {{ section.settings.card_text_weight | default: 400 }};
    text-decoration: {{ section.settings.card_text_decoration | default: 'none' }};
  }
  .main-blog-{{ section.id }} .blog-articles__article {
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

{%- endstyle -%}

{%- paginate blog.articles by 6 -%}
  <div class="main-blog main-blog-{{ section.id }} page-width section-{{ section.id }}-padding nvgd-section-surface">
    <h1 class="{{ section.settings.heading_size | default: 'h1' }} title--primary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ blog.title | escape }}
    </h1>

    <div class="blog-articles {% if section.settings.layout == 'collage' %}blog-articles--collage{% endif %}">
      {%- for article in blog.articles -%}
          {%- assign article_ratio = 1.66 -%}
          {%- if section.settings.card_media_ratio == 'adapt' and article.image != blank -%}
            {%- assign article_ratio = article.image.aspect_ratio -%}
          {%- elsif section.settings.card_media_ratio == 'landscape' -%}
            {%- assign article_ratio = 1.7778 -%}
          {%- elsif section.settings.card_media_ratio == 'square' -%}
            {%- assign article_ratio = 1 -%}
          {%- elsif section.settings.card_media_ratio == 'portrait' -%}
            {%- assign article_ratio = 0.8 -%}
          {%- endif -%}
        <div
          class="blog-articles__article article{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- liquid
            assign lazy_load = true
            if forloop.index <= 2
              assign lazy_load = false
            endif
          -%}
          {%- render 'article-card',
            article: article,
            lazy_load: lazy_load,
            media_height: section.settings.image_height,
            media_aspect_ratio: article_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true
          -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

