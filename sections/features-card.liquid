{% render 'section-corners', section: section %}
{% assign section_id = section.id | replace: '_', '' | downcase %}

{% style %}
  {%- if section.settings.heading_font != blank and section.settings.heading_font.id != settings.type_body_font.id -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  {%- if section.settings.text_font != blank and section.settings.text_font.id != settings.type_body_font.id -%}
    {{ section.settings.text_font | font_face: font_display: 'swap' }}
  {%- endif -%}
  .feature-cards-{{ section_id }} {
    {% if section.settings.enable_global_spacing %}
      padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    {% else %}
      padding: {{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px;
    {% endif %}
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .feature-cards__grid-{{ section_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
  }

  .feature-cards__card-{{ section_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    {% if section.settings.card_background != blank %}
      background: {{ section.settings.card_background }};
      border-radius: {{ section.settings.image_radius }}px;
    {% endif %}
  }

  .feature-cards__image-wrapper-{{ section_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    margin-bottom: {{ section.settings.image_spacing }}px;
  }

  .feature-cards__image-{{ section_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  .feature-cards__placeholder-{{ section_id }} {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    background-color: #F5F5F5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-cards__placeholder-{{ section_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .feature-cards__content-{{ section_id }} {
    padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_x }}px {{ section.settings.content_padding_bottom }}px;
    {% if section.settings.show_divider %}
      border-bottom: 1px solid {{ section.settings.divider_color }};
    {% endif %}
  }

  .feature-cards__heading-{{ section_id }} {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_weight }};
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
    margin: 0 0 {{ section.settings.heading_spacing }}px 0;
  }

  .feature-cards__text-{{ section_id }} {
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_weight }};
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .feature-cards__grid-{{ section_id }} {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .feature-cards-{{ section_id }} {
      {% if section.settings.enable_global_spacing %}
        padding: {{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px;
      {% else %}
        padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_x_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
      {% endif %}

    }

    .feature-cards__grid-{{ section_id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ section.settings.gap_mobile }}px;
    }

    .feature-cards__heading-{{ section_id }} {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .feature-cards__text-{{ section_id }} {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }
  .feature-cards__intro-{{ section_id }} { text-align: {{ section.settings.intro_alignment | default: 'center' }}; margin-bottom: {{ section.settings.intro_spacing | default: 56 }}px; }
  .feature-cards__intro-{{ section_id }} h2 { font-family: var(--font-heading-family); font-size: {{ section.settings.intro_heading_size | default: 40 }}px; font-weight: 400; line-height: 1.2; margin: 12px 0 20px; }
  .feature-cards__intro-{{ section_id }} .rte { max-width: 70ch; margin-inline: {% if section.settings.intro_alignment == 'left' %}0{% else %}auto{% endif %}; font-size: 16px; color: {{ section.settings.text_color }}; }
  .feature-cards__eyebrow-{{ section_id }} { font-size: 14px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin: 0; color: {{ section.settings.heading_color }}; }
  @media (max-width: 749px) { .feature-cards__intro-{{ section_id }} h2 { font-size: 28px; } }
{% endstyle %}

<div class="feature-cards-{{ section_id }} nvgd-section-surface">
  {% if section.settings.title != blank %}
    <header class="feature-cards__intro-{{ section_id }}">
      {% if section.settings.eyebrow != blank %}<p class="feature-cards__eyebrow-{{ section_id }}">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.title }}</h2>
      {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
    </header>
  {% endif %}
  <div class="feature-cards__grid-{{ section_id }}">
    {% for block in section.blocks %}
      <div class="feature-cards__card-{{ section_id }}" {{ block.shopify_attributes }}>
        {% if section.settings.show_images %}
        <div class="feature-cards__image-wrapper-{{ section_id }}">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 800 }}"
              alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              class="feature-cards__image-{{ section_id }}"
            >
          {% else %}
            <div class="feature-cards__placeholder-{{ section_id }}">
              {% if request.design_mode %}{{ 'image' | placeholder_svg_tag }}{% endif %}
            </div>
          {% endif %}
        </div>
        {% endif %}

        <div class="feature-cards__content-{{ section_id }}">
          {% if block.settings.heading != blank %}
            <h3 class="feature-cards__heading-{{ section_id }}">{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="feature-cards__text-{{ section_id }}">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Feature cards",
  "tag": "section",
  "class": "feature-cards-section",
  "settings": [
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "visible_if": "{{ section.settings.title != blank }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Introduction",
      "visible_if": "{{ section.settings.title != blank }}"
    },
    {
      "type": "select",
      "id": "intro_alignment",
      "label": "Intro alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.title != blank }}"
    },
    {
      "type": "range",
      "id": "intro_heading_size",
      "label": "Intro heading size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.title != blank }}"
    },
    {
      "type": "range",
      "id": "intro_spacing",
      "label": "Space below intro",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.title != blank }}"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show card images",
      "default": true
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Leave empty for transparent cards."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "16/9",
          "label": "Wide (16:9)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ],
      "default": "4/3",
      "visible_if": "{{ section.settings.show_images }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card and image corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space below image",
      "default": 20,
      "visible_if": "{{ section.settings.show_images }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_padding_x",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Padding sides",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show bottom divider",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#E5E5E5",
      "visible_if": "{{ section.settings.show_divider }}"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Size",
      "default": 22
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 18
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Space below",
      "default": 12
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "font_picker",
      "id": "text_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "label": "Max width",
      "default": 1400
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns (tablet)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Gap",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap (mobile)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Global spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_global_spacing",
      "label": "Use global spacing",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "default": 100,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_global_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "default": 100,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_global_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal spacing",
      "default": 100,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_global_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "default": 48,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_global_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "default": 48,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_global_spacing == false }}"
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Mobile horizontal spacing",
      "default": 20,
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_global_spacing == false }}"
    },
    {
      "type": "header",
      "content": "Section corners"
    },
    {
      "type": "checkbox",
      "id": "custom_section_corners",
      "label": "Customize section corners",
      "default": false
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_section_corners }}"
    },
    {
      "type": "checkbox",
      "id": "clip_section_corners",
      "label": "Clip content to corners",
      "default": false,
      "info": "Enable for edge-to-edge images. Leave off for menus, popups, sticky content, or overlapping elements.",
      "visible_if": "{{ section.settings.custom_section_corners and section.settings.section_corner_radius > 0 }}"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Feature card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ section.settings.show_images }}"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Heading",
            "text": "Text"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Heading",
            "text": "Text"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Heading",
            "text": "Text"
          }
        }
      ]
    }
  ]
}
{% endschema %}
