{% render 'section-corners', section: section %}
{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{% render 'editorial-style', section: section %}
{%- if section.settings.show_top_border -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .nvgd-quote { border-top: 1px solid {{ section.settings.top_border_color | default: '#E5E5E5' }}; }
  {%- endstyle -%}
{%- endif -%}
<div class="nvgd-editorial nvgd-quote">
  <div class="nvgd-editorial__inner">
    <figure>
      {% if section.settings.show_mark %}<span class="nvgd-quote__mark" aria-hidden="true">“</span>{% endif %}
      <blockquote>{{ section.settings.quote }}</blockquote>
      {% if section.settings.author != blank %}<figcaption>{{ section.settings.author | escape }}</figcaption>{% endif %}
    </figure>
  </div>
</div>
{% schema %}
{
  "name": "Editorial quote",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>Text</p>"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Attribution"
    },
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Show quote mark",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "color",
      "id": "top_border_color",
      "label": "Top border color",
      "default": "#E5E5E5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Mobile horizontal spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section corners"
    },
    {
      "type": "checkbox",
      "id": "custom_section_corners",
      "label": "Customize section corners",
      "default": false
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_section_corners }}"
    },
    {
      "type": "checkbox",
      "id": "clip_section_corners",
      "label": "Clip content to corners",
      "default": false,
      "info": "Enable for edge-to-edge images. Leave off for menus, popups, sticky content, or overlapping elements.",
      "visible_if": "{{ section.settings.custom_section_corners and section.settings.section_corner_radius > 0 }}"
    }
  ],
  "presets": [
    {
      "name": "Editorial quote",
      "settings": {
        "heading_size": 24,
        "heading_size_mobile": 20,
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
{% endschema %}
