{% render 'section-corners', section: section %}
{% assign section_id = section.id | replace: '_', '' | downcase %}

{%- comment -%}
  font_picker settings return a font object, and its family only renders once the
  @font-face declaration is emitted, so declare every font this section renders.
  The filter returns nothing for system fonts, so no guard is needed.
  https://shopify.dev/docs/storefronts/themes/architecture/settings/fonts
{%- endcomment -%}
{%- style -%}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.subtitle_font | font_face: font_display: 'swap' }}
  {{ section.settings.card_title_font | font_face: font_display: 'swap' }}
  {{ section.settings.card_text_font | font_face: font_display: 'swap' }}
{%- endstyle -%}

{% style %}
  #shopify-section-{{ section.id }} {
    /* Section */
    --fcr-bg: {{ section.settings.section_bg_color }};
    --fcr-padding: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px{% else %}{{ section.settings.section_padding_top }}px {{ section.settings.section_padding_right }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left }}px{% endif %};
    --fcr-padding-mobile: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.section_padding_top }}px 24px {{ section.settings.section_padding_bottom }}px 24px{% endif %};
    {% if section.settings.enable_global_spacing %}--fcr-container-max: var(--page-width);{% endif %}

    /* Header */
    --fcr-header-mb: {{ section.settings.header_margin_bottom }}px;
    --fcr-header-align: {{ section.settings.header_align }};

    /* Title */
    --fcr-title-font: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    --fcr-title-weight: {{ section.settings.title_weight }};
    --fcr-title-size: {{ section.settings.title_size }}px;
    --fcr-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --fcr-title-color: {{ section.settings.title_color }};
    --fcr-title-mb: {{ section.settings.title_margin_bottom }}px;

    /* Subtitle */
    --fcr-subtitle-font: {{ section.settings.subtitle_font.family }}, {{ section.settings.subtitle_font.fallback_families }};
    --fcr-subtitle-weight: {{ section.settings.subtitle_weight }};
    --fcr-subtitle-size: {{ section.settings.subtitle_size }}px;
    --fcr-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;
    --fcr-subtitle-color: {{ section.settings.subtitle_color }};

    /* Track */
    --fcr-gap: {{ section.settings.card_gap }}px;
    --fcr-gap-mobile: {{ section.settings.card_gap_mobile }}px;
    --fcr-track-py: {{ section.settings.track_padding_y }}px;

    /* Card */
    --fcr-card-bg: {{ section.settings.card_bg_color }};
    --fcr-card-radius: {{ section.settings.card_border_radius }}px;
    --fcr-card-padding: {{ section.settings.card_padding | default: 0 }}px;
    --fcr-card-padding-mobile: {{ section.settings.card_padding_mobile | default: 0 }}px;
    --fcr-cards: {{ section.settings.cards_visible }};
    --fcr-cards-n: {{ section.settings.cards_visible | minus: 1 }};
    --fcr-cards-mobile: {{ section.settings.cards_visible_mobile }};
    --fcr-cards-mobile-n: {{ section.settings.cards_visible_mobile | minus: 1 }};
    --fcr-card-shadow: {% if section.settings.enable_card_shadow %}{{ section.settings.card_shadow_x }}px {{ section.settings.card_shadow_y }}px {{ section.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ section.settings.card_shadow_opacity | divided_by: 100.0 }}){% else %}none{% endif %};
    --fcr-card-shadow-hover: {% if section.settings.enable_card_shadow %}{{ section.settings.card_shadow_x }}px {{ section.settings.card_shadow_y | plus: section.settings.card_hover_lift }}px {{ section.settings.card_shadow_blur | plus: 10 }}px rgba(0, 0, 0, {{ section.settings.card_shadow_opacity | plus: 10 | divided_by: 100.0 }}){% else %}none{% endif %};
    --fcr-card-lift: -{{ section.settings.card_hover_lift }}px;

    /* Image */
    {% unless section.settings.image_aspect_ratio == 'adapt' %}--fcr-img-ratio: {{ section.settings.image_aspect_ratio }};{% endunless %}
    {% if section.settings.image_aspect_ratio == 'adapt' %}--fcr-img-height: auto;{% endif %}

    /* Card content */
    --fcr-content-padding: {{ section.settings.card_content_padding | default: 30 }}px;
    --fcr-content-padding-mobile: {{ section.settings.card_content_padding_mobile | default: 20 }}px;

    /* Card title */
    --fcr-card-title-font: {{ section.settings.card_title_font.family }}, {{ section.settings.card_title_font.fallback_families }};
    --fcr-card-title-weight: {{ section.settings.card_title_weight }};
    --fcr-card-title-size: {{ section.settings.card_title_size }}px;
    --fcr-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px;
    --fcr-card-title-color: {{ section.settings.card_title_color }};
    --fcr-card-title-mb: {{ section.settings.card_title_margin_bottom }}px;

    /* Card text */
    --fcr-card-text-font: {{ section.settings.card_text_font.family }}, {{ section.settings.card_text_font.fallback_families }};
    --fcr-card-text-weight: {{ section.settings.card_text_weight }};
    --fcr-card-text-size: {{ section.settings.card_text_size }}px;
    --fcr-card-text-size-mobile: {{ section.settings.card_text_size_mobile }}px;
    --fcr-card-text-color: {{ section.settings.card_text_color }};

    /* Parallax (only effective with features-carousel--parallax modifier on root) */
    {% if section.settings.enable_parallax %}
    --fcr-parallax-height: {{ section.settings.parallax_height }}px;
    --fcr-parallax-color: {{ section.settings.parallax_color }};
    {% endif %}
  }
{% endstyle %}

<div class="features-carousel-section-{{ section_id }} features-carousel nvgd-section-surface" data-parallax="{{ section.settings.enable_parallax }}" data-parallax-speed="{{ section.settings.parallax_speed }}" data-section-id="{{ section.id }}">
  <div class="features-carousel-container-{{ section_id }} features-carousel__container">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="features-carousel__header-{{ section_id }} features-carousel__header">
        {% if section.settings.title != blank %}
          <h2 class="features-carousel__title-{{ section_id }} features-carousel__title">
            {{ section.settings.title }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="features-carousel__subtitle-{{ section_id }} features-carousel__subtitle">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <div class="features-carousel__wrapper-{{ section_id }} features-carousel__wrapper">
      <div class="features-carousel__track-{{ section_id }} features-carousel__track">
        {% for block in section.blocks %}
          <div class="features-carousel__card-{{ section_id }} features-carousel__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="features-carousel__card-image-wrapper-{{ section_id }} features-carousel__card-image-wrapper">
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="features-carousel__card-image-{{ section_id }} features-carousel__card-image"
                >
              </div>
            {% endif %}
            <div class="features-carousel__card-content-{{ section_id }} features-carousel__card-content">
              {% if block.settings.title != blank %}
                <h3 class="features-carousel__card-title-{{ section_id }} features-carousel__card-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="features-carousel__card-text-{{ section_id }} features-carousel__card-text">
                  {{ block.settings.text }}
                </p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
/* moved from inline style block for bundling */
.features-carousel {
  width: 100%;
  background-color: var(--fcr-bg);
  padding: var(--fcr-padding);
  position: relative;
  overflow: hidden;
}

.features-carousel .features-carousel__container {
  width: 100%;
  margin: 0 auto;
  max-width: var(--fcr-container-max, none);
}

.features-carousel .features-carousel__header {
  margin-bottom: var(--fcr-header-mb);
  text-align: var(--fcr-header-align);
}

.features-carousel .features-carousel__title {
  font-family: var(--fcr-title-font);
  font-weight: var(--fcr-title-weight);
  font-size: var(--fcr-title-size);
  color: var(--fcr-title-color);
  line-height: 1.2;
  margin: 0 0 var(--fcr-title-mb) 0;
}

.features-carousel .features-carousel__subtitle {
  font-family: var(--fcr-subtitle-font);
  font-weight: var(--fcr-subtitle-weight);
  font-size: var(--fcr-subtitle-size);
  color: var(--fcr-subtitle-color);
  line-height: 1.5;
  margin: 0;
}

.features-carousel .features-carousel__wrapper {
  position: relative;
  z-index: 2;
}

.features-carousel .features-carousel__track {
  display: flex;
  gap: var(--fcr-gap);
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: var(--fcr-track-py) 0;
  cursor: grab;
  user-select: none;
}

.features-carousel .features-carousel__track::-webkit-scrollbar {
  display: none;
}

.features-carousel .features-carousel__track.is-dragging {
  cursor: grabbing;
  scroll-behavior: auto;
  scroll-snap-type: none;
}

.features-carousel .features-carousel__track.is-dragging .features-carousel__card {
  pointer-events: none;
}

.features-carousel .features-carousel__card {
  flex: 0 0 calc((100% - (var(--fcr-cards-n) * var(--fcr-gap))) / var(--fcr-cards));
  scroll-snap-align: start;
  background-color: var(--fcr-card-bg);
  border-radius: var(--fcr-card-radius);
  padding: var(--fcr-card-padding);
  overflow: hidden;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: var(--fcr-card-shadow);
}

.features-carousel--hover .features-carousel__card:hover {
  transform: translateY(var(--fcr-card-lift));
  box-shadow: var(--fcr-card-shadow-hover);
}

.features-carousel .features-carousel__card-image-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: var(--fcr-img-ratio, auto);
  overflow: hidden;
  background-color: #F5F5F5;
  border-radius: var(--fcr-card-radius);
}

.features-carousel .features-carousel__card-image {
  width: 100%;
  height: var(--fcr-img-height, 100%);
  object-fit: cover;
  display: block;
  border-radius: var(--fcr-card-radius);
}

.features-carousel .features-carousel__card-content {
  padding: var(--fcr-content-padding);
}

.features-carousel .features-carousel__card-title {
  font-family: var(--fcr-card-title-font);
  font-weight: var(--fcr-card-title-weight);
  font-size: var(--fcr-card-title-size);
  color: var(--fcr-card-title-color);
  line-height: 1.3;
  margin: 0 0 var(--fcr-card-title-mb) 0;
}

.features-carousel .features-carousel__card-text {
  font-family: var(--fcr-card-text-font);
  font-weight: var(--fcr-card-text-weight);
  font-size: var(--fcr-card-text-size);
  color: var(--fcr-card-text-color);
  line-height: 1.6;
  margin: 0;
}

.features-carousel--parallax::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: var(--fcr-parallax-height);
  background: linear-gradient(to bottom, transparent, var(--fcr-parallax-color));
  pointer-events: none;
  z-index: 1;
}

@media screen and (max-width: 749px) {
  .features-carousel {
    padding: var(--fcr-padding-mobile, var(--fcr-padding));
  }

  .features-carousel .features-carousel__title {
    font-size: var(--fcr-title-size-mobile);
  }

  .features-carousel .features-carousel__subtitle {
    font-size: var(--fcr-subtitle-size-mobile);
  }

  .features-carousel .features-carousel__track {
    gap: var(--fcr-gap-mobile);
  }

  .features-carousel .features-carousel__card {
    flex: 0 0 calc((100% - (var(--fcr-cards-mobile-n) * var(--fcr-gap-mobile))) / var(--fcr-cards-mobile));
    padding: var(--fcr-card-padding-mobile);
  }

  .features-carousel .features-carousel__card-title {
    font-size: var(--fcr-card-title-size-mobile);
  }

  .features-carousel .features-carousel__card-text {
    font-size: var(--fcr-card-text-size-mobile);
  }

  .features-carousel .features-carousel__card-content {
    padding: var(--fcr-content-padding-mobile);
  }

  .features-carousel .features-carousel__card-image-wrapper,
  .features-carousel .features-carousel__card-image {
    border-radius: var(--fcr-card-radius);
  }
}
{% endstylesheet %}

<script src="{{ 'features-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
