{% render 'section-corners', section: section %}
{% comment %}
  Interactive Insights Gallery Section
{% endcomment %}


<div class="insights-gallery-section{% if section.settings.desktop_layout == 'image_left' %} ig--image-left{% else %} ig--image-right{% endif %}{% if section.settings.card_internal_layout == 'title_top' %} ig--title-top{% endif %}{% if section.settings.enable_fixed_size %} ig--fixed-cards{% else %} ig--fluid-cards{% endif %}{% if section.settings.card_hover_lift > 0 %} ig--lift{% endif %} ig--cols-{{ section.settings.cards_per_row }}{% if section.settings.mobile_use_different_images %} ig--mobile-diff{% endif %}"
     data-auto-rotate="{{ section.settings.auto_rotate }}"
     data-rotation-speed="{{ section.settings.rotation_speed | times: 1000 }}"
     style="--ig-bg: {{ section.settings.background_color }}; --ig-section-padding: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px{% else %}{{ section.settings.section_padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.section_padding_bottom }}px{% endif %}; --ig-section-padding-mobile: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.section_padding_top_mobile }}px {{ section.settings.padding_x_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px{% endif %}; --ig-container-max-width: {% if section.settings.enable_global_spacing %}var(--page-width){% elsif section.settings.section_width == 'fixed' %}{% if section.settings.use_custom_container_width %}{{ section.settings.custom_container_width }}px{% else %}{{ section.settings.section_fixed_width }}px{% endif %}{% else %}100%{% endif %}; --ig-grid-gap: {{ section.settings.grid_gap }}px; --ig-grid-gap-tablet: {{ section.settings.grid_gap_tablet }}px; --ig-grid-gap-mobile: {{ section.settings.grid_gap_mobile }}px; --ig-content-width: {{ section.settings.content_width }}%; --ig-image-max-width: {{ section.settings.image_max_width }}%; --ig-heading-mb: {{ section.settings.heading_margin_bottom }}px; --ig-heading-mb-mobile: {{ section.settings.heading_margin_bottom_mobile }}px; --ig-heading-font: {{ section.settings.heading_font.family | replace: '"', '&quot;' }}, {{ section.settings.heading_font.fallback_families | replace: '"', '&quot;' }}; --ig-heading-weight: {{ section.settings.heading_weight }}; --ig-heading-size: {{ section.settings.heading_size }}px; --ig-heading-size-tablet: {{ section.settings.heading_size_tablet }}px; --ig-heading-size-mobile: {{ section.settings.heading_size_mobile }}px; --ig-heading-color: {{ section.settings.heading_color }}; --ig-heading-lh: {{ section.settings.heading_line_height }}; --ig-heading-align: {{ section.settings.heading_align }}; --ig-card-gap: {{ section.settings.card_gap }}px; --ig-card-gap-mobile: {{ section.settings.card_gap_mobile }}px; --ig-content-speed: {{ section.settings.content_transition_speed }}ms; --ig-image-radius: {{ section.settings.image_border_radius }}px; --ig-section-image-radius: {{ section.settings.section_image_border_radius }}px; --ig-card-bg: {{ section.settings.card_background }}; --ig-card-radius: {{ section.settings.card_border_radius }}px; --ig-card-padding: {{ section.settings.card_padding_y }}px {{ section.settings.card_padding_x }}px; --ig-card-padding-tablet: {{ section.settings.card_padding_y_tablet }}px {{ section.settings.card_padding_x_tablet }}px; --ig-card-padding-mobile: {{ section.settings.card_padding_y_mobile }}px {{ section.settings.card_padding_x_mobile }}px; --ig-card-transition: {{ section.settings.card_transition_speed }}ms; --ig-card-border-width: {{ section.settings.card_border_width }}px; --ig-card-border-color: {{ section.settings.card_border_color }}; --ig-card-fixed-width: {{ section.settings.card_fixed_width }}px; --ig-card-fixed-height: {{ section.settings.card_fixed_height }}px; --ig-card-min-height: {{ section.settings.card_min_height }}px; --ig-card-min-height-tablet: {{ section.settings.card_min_height_tablet }}px; --ig-card-min-height-mobile: {{ section.settings.card_min_height_mobile }}px; --ig-hover-lift: {{ section.settings.card_hover_lift }}px; --ig-hover-shadow: {{ section.settings.card_hover_shadow }}px; --ig-hover-shadow-opacity: {{ section.settings.card_hover_shadow_opacity | divided_by: 100.0 }}; --ig-active-card-bg: {{ section.settings.active_card_background }}; --ig-active-card-border: {{ section.settings.active_card_border }}; --ig-active-card-text: {{ section.settings.active_card_text_color }}; --ig-card-mobile-width: {{ section.settings.card_mobile_scroll_width }}px; --ig-icon-mb: {{ section.settings.icon_margin_bottom }}px; --ig-icon-mb-mobile: {{ section.settings.icon_margin_bottom_mobile }}px; --ig-icon-size: {{ section.settings.icon_size }}px; --ig-icon-size-tablet: {{ section.settings.icon_size_tablet }}px; --ig-icon-size-mobile: {{ section.settings.icon_size_mobile }}px; --ig-arrow-opacity: {{ section.settings.arrow_opacity | divided_by: 100.0 }}; --ig-arrow-mt: {{ section.settings.arrow_margin_top }}px; --ig-arrow-size: {{ section.settings.arrow_size }}px; --ig-arrow-size-mobile: {{ section.settings.arrow_size_mobile }}px; --ig-card-text-color: {{ section.settings.card_text_color }}; --ig-card-title-font: {{ section.settings.card_title_font.family | replace: '"', '&quot;' }}, {{ section.settings.card_title_font.fallback_families | replace: '"', '&quot;' }}; --ig-card-title-weight: {{ section.settings.card_title_weight }}; --ig-card-title-size: {{ section.settings.card_title_size }}px; --ig-card-title-size-tablet: {{ section.settings.card_title_size_tablet }}px; --ig-card-title-size-mobile: {{ section.settings.card_title_size_mobile }}px; --ig-card-title-lh: {{ section.settings.card_title_line_height }};">
  <div class="insights-gallery-container">
    <div class="insights-main-grid">

        <div class="insights-content-side">

          {% if section.settings.heading != blank %}
            <div class="insights-heading">
              <h2 class="text-block {{ section.settings.type_preset }}">{{ section.settings.heading | newline_to_br }}</h2>
            </div>
          {% endif %}

          <div class="insights-nav" role="region" aria-label="{{ section.settings.heading | default: 'Highlights' | escape }}" tabindex="0">
            {% for block in section.blocks %}
              {% render 'insights-gallery-block-card', block: block, is_first: forloop.first, block_index: forloop.index %}
            {% endfor %}
          </div>
        </div>

        <div class="insights-display-side">
          {% if section.settings.section_image != blank %}
            <img src="{{ section.settings.section_image | image_url: width: 1400 }}"
                 alt="{{ section.settings.heading | strip_html }}"
                 class="section-default-image"
                 loading="lazy"
                 width="{{ section.settings.section_image.width }}"
                 height="{{ section.settings.section_image.height }}" />
          {% endif %}
          {% for block in section.blocks %}
            {% render 'insights-gallery-block-content', block: block, is_first: forloop.first %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

<script src="{{ 'insights-gallery.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  font_picker settings return a font object, and its family only renders once the
  @font-face declaration is emitted, so declare every font this section renders.
  The filter returns nothing for system fonts, so no guard is needed.
  https://shopify.dev/docs/storefronts/themes/architecture/settings/fonts
{%- endcomment -%}
{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.card_title_font | font_face: font_display: 'swap' }}
{%- endstyle -%}

{% stylesheet %}
/* moved from inline style block for bundling */
.insights-gallery-section {
  width: 100%;
  background-color: var(--ig-bg);
  padding: var(--ig-section-padding);
}

@media screen and (max-width: 749px) {
  .insights-gallery-section {
    padding: var(--ig-section-padding-mobile);
  }
}

.insights-gallery-container {
  width: 100%;
  margin: 0 auto;
  max-width: var(--ig-container-max-width);
}

.insights-main-grid {
  display: grid;
  gap: var(--ig-grid-gap);
  align-items: end;
  width: 100%;
}

.ig--image-right .insights-main-grid {
  grid-template-columns: var(--ig-content-width) 1fr;
}

.ig--image-left .insights-main-grid {
  grid-template-columns: 1fr var(--ig-content-width);
}

/* ----- SIDE A: Content Wrapper (Heading + Cards) ----- */
.insights-content-side {
  display: flex;
  flex-direction: column;
}

.ig--image-right .insights-content-side {
  order: 1;
}

.ig--image-left .insights-content-side {
  order: 2;
}

/* Heading Styling */
.insights-heading {
  margin-bottom: var(--ig-heading-mb);
  max-width: 100%;
}

.insights-heading h2 {
  font-family: var(--ig-heading-font);
  font-weight: var(--ig-heading-weight);
  font-size: var(--ig-heading-size);
  color: var(--ig-heading-color);
  line-height: var(--ig-heading-lh);
  margin: 0;
  text-align: var(--ig-heading-align);
}

/* Cards Grid Area */
.insights-nav {
  display: grid;
  gap: var(--ig-card-gap);
}

.ig--cols-2 .insights-nav {
  grid-template-columns: repeat(2, 1fr);
}

.ig--cols-3 .insights-nav {
  grid-template-columns: repeat(3, 1fr);
}

.ig--fluid-cards .insights-nav {
  grid-auto-rows: 1fr;
}

/* ----- SIDE B: Image Display Wrapper ----- */
.insights-display-side {
  display: grid;
  position: relative;
  max-width: var(--ig-image-max-width);
  margin-left: auto;
}

.ig--image-right .insights-display-side {
  order: 2;
}

.ig--image-left .insights-display-side {
  order: 1;
  margin-left: 0;
  margin-right: auto;
}

.insight-content {
  grid-area: 1 / 1;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0s var(--ig-content-speed), visibility 0s var(--ig-content-speed);
  max-width: 500px;
}

.insight-content.active-content {
  opacity: 1;
  visibility: visible;
  transition: opacity var(--ig-content-speed) ease, visibility 0s;
  z-index: 1;
  max-width: 500px;
}

.insight-image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  border-radius: var(--ig-image-radius);
}

.section-default-image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  border-radius: var(--ig-section-image-radius);
  grid-area: 1 / 1;
  z-index: 0;
}

/* ================= INDIVIDUAL CARD STYLING ================= */
.insight-card {
  background: var(--ig-card-bg);
  border-radius: var(--ig-card-radius);
  padding: var(--ig-card-padding);
  cursor: pointer;
  transition: all var(--ig-card-transition) cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  border: var(--ig-card-border-width) solid var(--ig-card-border-color);

  display: flex;
  flex-direction: column;

  justify-content: space-between;
}

.ig--title-top .insight-card {
  flex-direction: column-reverse;
}

.ig--fixed-cards .insight-card {
  width: var(--ig-card-fixed-width);
  height: var(--ig-card-fixed-height);
  max-width: 100%;
}

.ig--fluid-cards .insight-card {
  width: 100%;
  height: 100%;
  min-height: var(--ig-card-min-height);
}

.ig--lift .insight-card {
  will-change: transform;
}

.insight-card:hover {
  transform: translateY(calc(-1 * var(--ig-hover-lift)));
  box-shadow: 0 var(--ig-hover-shadow) calc(var(--ig-hover-shadow) * 2) rgba(0, 0, 0, var(--ig-hover-shadow-opacity));
}

.insight-card.active-card {
  background: var(--ig-active-card-bg);
  border-color: var(--ig-active-card-border);
}

/* Card Header Section (Icon + Arrow) */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  margin-bottom: var(--ig-icon-mb);
}

.ig--title-top .card-header {
  margin-bottom: 0;
  margin-top: var(--ig-icon-mb);
  align-items: flex-end;
}

/* Icon Wrapper */
.icon-wrapper {
  width: var(--ig-icon-size);
  height: var(--ig-icon-size);
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-wrapper img {
  width: 50%;
  height: 50%;
  object-fit: contain;
}

/* Arrow */
.card-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ig-card-text-color);
  opacity: var(--ig-arrow-opacity);
  transition: opacity 0.3s ease, color 0.3s ease;
  margin-top: var(--ig-arrow-mt);
  flex-shrink: 0;
}

.card-arrow svg {
  width: var(--ig-arrow-size);
  height: var(--ig-arrow-size);
}

.insight-card:hover .card-arrow {
  opacity: 1;
}

.insight-card.active-card .card-arrow {
  color: var(--ig-active-card-text);
  opacity: 1;
}

/* Card Title */
.card-content {
  width: 100%;
  margin-top: auto;
}

.card-title {
  font-family: var(--ig-card-title-font);
  font-weight: var(--ig-card-title-weight);
  font-size: var(--ig-card-title-size);
  line-height: var(--ig-card-title-lh);
  margin: 0;
  color: var(--ig-card-text-color);
}

.insight-card.active-card .card-title {
  color: var(--ig-active-card-text);
}

.insight-image.mobile-only {
  display: none;
}

/* ================= RESPONSIVE TABLET ================= */
@media screen and (max-width: 1024px) {
  .ig--image-right .insights-main-grid,
  .ig--image-left .insights-main-grid {
    grid-template-columns: 1fr;
  }

  .insights-main-grid {
    gap: var(--ig-grid-gap-tablet);
  }

  .ig--image-right .insights-content-side,
  .ig--image-left .insights-content-side {
    order: 2;
  }

  .ig--image-right .insights-display-side,
  .ig--image-left .insights-display-side {
    order: 1;
    max-width: 100%;
    margin: 0 auto;
  }

  .insight-card {
    padding: var(--ig-card-padding-tablet);
  }

  .ig--fluid-cards .insight-card {
    min-height: var(--ig-card-min-height-tablet);
  }

  .icon-wrapper {
    width: var(--ig-icon-size-tablet);
    height: var(--ig-icon-size-tablet);
  }

  .card-title {
    font-size: var(--ig-card-title-size-tablet);
  }

  .insights-heading h2 {
    font-size: var(--ig-heading-size-tablet);
  }
}

/* ================= RESPONSIVE MOBILE ================= */
@media screen and (max-width: 749px) {
  .insights-main-grid {
    display: flex;
    flex-direction: column;
    gap: var(--ig-grid-gap-mobile);
  }

  .ig--image-right .insights-content-side,
  .ig--image-left .insights-content-side {
    order: 2;
    width: 100%;
  }

  .ig--image-right .insights-display-side,
  .ig--image-left .insights-display-side {
    order: 1;
    max-width: 100%;
    width: 100%;
    margin: 0;
  }

  .insight-content {
    max-width: 100%;
  }

  .insight-image {
    width: 100%;
    max-width: 100%;
  }

  /* Horizontal scrolling cards */
  .insights-nav {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: var(--ig-card-gap-mobile);
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .insights-nav::-webkit-scrollbar {
    display: none;
  }

  .ig--fixed-cards .insight-card,
  .ig--fluid-cards .insight-card {
    flex: 0 0 auto;
    width: var(--ig-card-mobile-width);
    min-width: var(--ig-card-mobile-width);
    scroll-snap-align: start;
    padding: var(--ig-card-padding-mobile);
    min-height: var(--ig-card-min-height-mobile);
    height: auto;
  }

  .icon-wrapper {
    width: var(--ig-icon-size-mobile);
    height: var(--ig-icon-size-mobile);
  }

  .card-header,
  .ig--title-top .card-header {
    margin-bottom: var(--ig-icon-mb-mobile);
  }

  .card-title {
    font-size: var(--ig-card-title-size-mobile);
  }

  .card-arrow svg {
    width: var(--ig-arrow-size-mobile);
    height: var(--ig-arrow-size-mobile);
  }

  .insights-heading h2 {
    font-size: var(--ig-heading-size-mobile);
  }

  .insights-heading {
    margin-bottom: var(--ig-heading-mb-mobile);
  }

  .ig--mobile-diff .insight-image:not(.mobile-only) {
    display: none;
  }

  .ig--mobile-diff .insight-image.mobile-only {
    display: block;
  }
}
{% endstylesheet %}

