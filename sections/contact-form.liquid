{% render 'section-corners', section: section %}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.padding_left_mobile > 0 %}
      padding-left: {{ section.settings.padding_left_mobile }}px;
    {% elsif section.settings.padding_left > 0 %}
      padding-left: {{ section.settings.padding_left | times: 0.75 | round: 0 }}px;
    {% endif %}
    {% if section.settings.padding_right_mobile > 0 %}
      padding-right: {{ section.settings.padding_right_mobile }}px;
    {% elsif section.settings.padding_right > 0 %}
      padding-right: {{ section.settings.padding_right | times: 0.75 | round: 0 }}px;
    {% endif %}
  }

  .section-{{ section.id }} .contact {
    max-width: {{ section.settings.content_max_width | default: 800 }}px;
  }

  .section-{{ section.id }} .contact .title,
  .section-{{ section.id }} .contact .contact__description {
    text-align: {{ section.settings.heading_align | default: 'left' }};
  }

  .section-{{ section.id }} .contact .contact__description {
    font-size: {{ section.settings.description_size | default: 16 }}px;
    max-width: {% if section.settings.heading_align == 'center' %}500px{% else %}none{% endif %};
    margin-inline: {% if section.settings.heading_align == 'center' %}auto{% else %}0{% endif %};
  }

  {%- if section.settings.heading_size_override > 0 -%}
  .section-{{ section.id }} .contact .title {
    font-size: {{ section.settings.heading_size_override }}px;
  }
  {%- endif -%}

  {%- if section.settings.button_pill -%}
  .section-{{ section.id }} .contact__button .button {
    background-color: #111111;
    color: #FFFFFF;
    border-radius: 9999px;
    padding: 16px 48px;
    font-size: 14px;
    font-weight: 700;
  }
  .section-{{ section.id }} .contact__button .button::after {
    border-radius: 9999px;
  }
  {%- endif -%}

  {%- if section.settings.background_color != blank -%}
  .section-{{ section.id }}-bg {
    background-color: {{ section.settings.background_color }};
  }
  {%- endif -%}

  {%- if section.settings.border_color != blank -%}
  .section-{{ section.id }}-bg {
    border: 1px solid {{ section.settings.border_color }};
  }
  {%- endif -%}

  {%- if section.settings.use_custom_heading_font -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  .section-{{ section.id }} .contact .title {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      {% if section.settings.padding_left > 0 %}
        padding-left: {{ section.settings.padding_left }}px;
      {% endif %}
      {% if section.settings.padding_right > 0 %}
        padding-right: {{ section.settings.padding_right }}px;
      {% endif %}
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-bg">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {% if section.settings.description != blank %}<div class="contact__description rte">{{ section.settings.description }}</div>{% endif %}
    {%- liquid
      assign contact_form_class = 'isolate'
      if settings.animations_reveal_on_scroll
        assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
      endif
    -%}
    {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: contact_form_id, class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message">
          <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
            {{- 'icon-error.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
        </div>
        <ul class="form-status-list caption-large" role="list">
          <li>
            <a href="#ContactForm-{{ section.id }}-email" class="link">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </a>
          </li>
        </ul>
      {%- endif -%}
      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-{{ section.id }}-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >
          <label class="field__label" for="ContactForm-{{ section.id }}-name">{{ 'templates.contact.form.name' | t }}</label>
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-{{ section.id }}-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-{{ section.id }}-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-{{ section.id }}-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-{{ section.id }}-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      </div>
      <div class="field">
        <input
          type="tel"
          id="ContactForm-{{ section.id }}-phone"
          class="field__input"
          autocomplete="tel"
          name="contact[{{ 'templates.contact.form.phone' | t }}]"
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
          placeholder="{{ 'templates.contact.form.phone' | t }}"
        >
        <label class="field__label" for="ContactForm-{{ section.id }}-phone">{{ 'templates.contact.form.phone' | t }}</label>
      </div>
      <div class="field">
        <textarea
          rows="10"
          id="ContactForm-{{ section.id }}-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-{{ section.id }}-body">
          {{- 'templates.contact.form.comment' | t -}}
        </label>
      </div>
      <div class="contact__button">
        <button type="submit" class="button">
          {{ 'templates.contact.form.send' | t }}
        </button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding left",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding left (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding right (Mobile)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section corners"
    },
    {
      "type": "checkbox",
      "id": "custom_section_corners",
      "label": "Customize section corners",
      "default": false
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_section_corners }}"
    },
    {
      "type": "checkbox",
      "id": "clip_section_corners",
      "label": "Clip content to corners",
      "default": false,
      "info": "Enable for edge-to-edge images. Leave off for menus, popups, sticky content, or overlapping elements.",
      "visible_if": "{{ section.settings.custom_section_corners and section.settings.section_corner_radius > 0 }}"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "Content max width",
      "default": 800
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color override",
      "info": "Leave empty to use the color scheme."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty for no border."
    },
    {
      "type": "checkbox",
      "id": "use_custom_heading_font",
      "label": "Use custom heading font",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "manrope_n8"
    },
    {
      "type": "range",
      "id": "heading_size_override",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading size override",
      "info": "Use 0 to keep the heading preset size.",
      "default": 0
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "button_pill",
      "label": "Pill submit button",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
