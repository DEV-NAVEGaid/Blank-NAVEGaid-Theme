{% render 'section-corners', section: section %}
{% comment %}
  Household Gallery - Side-by-Side Header fixed
{% endcomment %}

{% assign section_id = section.id | replace: '_', '' | downcase %}

{%- comment -%}
  font_picker settings return a font object, and its family only renders once the
  @font-face declaration is emitted, so declare every font this section renders.
  The filter returns nothing for system fonts, so no guard is needed.
  https://shopify.dev/docs/storefronts/themes/architecture/settings/fonts
{%- endcomment -%}
{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.button_font | font_face: font_display: 'swap' }}
  {{ section.settings.pill_font | font_face: font_display: 'swap' }}
{%- endstyle -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --hg-bg-top: {{ section.settings.background_color_top }};
    --hg-bg-bottom: {{ section.settings.background_color_bottom }};
    --hg-bg-split: {{ section.settings.background_split }}%;
    --hg-section-padding: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px{% else %}{{ section.settings.section_padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.section_padding_bottom }}px{% endif %};
    --hg-section-padding-mobile: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.section_padding_top_mobile }}px {{ section.settings.padding_x_mobile }}px {{ section.settings.section_padding_bottom_mobile }}px{% endif %};
    --hg-container-max: {% if section.settings.enable_global_spacing %}var(--page-width){% elsif section.settings.section_width == 'fixed' %}{% if section.settings.use_custom_container_width %}{{ section.settings.custom_container_width }}px{% else %}{{ section.settings.section_fixed_width }}px{% endif %}{% else %}100%{% endif %};
    --hg-header-justify: {% if section.settings.button_text != blank %}space-between{% else %}center{% endif %};
    --hg-header-margin: {{ section.settings.header_margin_bottom }}px;
    --hg-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --hg-heading-weight: {{ section.settings.heading_weight }};
    --hg-heading-size: {{ section.settings.heading_size }}px;
    --hg-heading-size-tablet: {{ section.settings.heading_size_tablet }}px;
    --hg-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --hg-heading-color: {{ section.settings.heading_color }};
    --hg-header-align-mobile: {{ section.settings.header_alignment_mobile }};
    --hg-button-font: {{ section.settings.button_font.family }}, {{ section.settings.button_font.fallback_families }};
    --hg-button-weight: {{ section.settings.button_weight }};
    --hg-button-size: {{ section.settings.button_size }}px;
    --hg-button-color: {{ section.settings.button_text_color }};
    --hg-button-bg: {{ section.settings.button_bg_color }};
    --hg-button-padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    --hg-button-radius: {{ section.settings.button_radius }}px;
    --hg-nav-justify: {% case section.settings.nav_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
    --hg-nav-margin: {{ section.settings.nav_margin_bottom }}px;
    --hg-nav-mx: {% if section.settings.enable_global_spacing %}-{{ settings.padding_horizontal_mobile }}px{% else %}-{{ section.settings.padding_x_mobile }}px{% endif %};
    --hg-nav-px: {% if section.settings.enable_global_spacing %}{{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.padding_x_mobile }}px{% endif %};
    --hg-pill-font: {{ section.settings.pill_font.family }}, {{ section.settings.pill_font.fallback_families }};
    --hg-pill-weight: {{ section.settings.pill_weight }};
    --hg-pill-size: {{ section.settings.pill_size }}px;
    --hg-pill-color: {{ section.settings.pill_text_color }};
    --hg-pill-bg: {{ section.settings.pill_bg_color }};
    --hg-pill-bg-hover: {{ section.settings.pill_bg_color | color_darken: 5 }};
    --hg-pill-active-bg: {{ section.settings.pill_active_bg }};
    --hg-pill-active-text: {{ section.settings.pill_active_text }};
    --hg-pill-padding: {{ section.settings.pill_padding_y }}px {{ section.settings.pill_padding_x }}px;
    --hg-pill-radius: {{ section.settings.pill_radius }}px;
    --hg-pill-border: {{ section.settings.pill_border_width }}px solid {{ section.settings.pill_border_color }};
    --hg-pill-gap: {{ section.settings.pill_gap }}px;
    --hg-grid-cols: {{ section.settings.grid_ratio_left }}fr {{ section.settings.grid_ratio_right }}fr;
    --hg-gap: {{ section.settings.image_gap }}px;
    --hg-gap-mobile: {{ section.settings.image_gap_mobile }}px;
    --hg-img-radius: {{ section.settings.image_border_radius }}px;
    --hg-loc-height: {% if section.settings.desktop_fixed_height > 0 %}{{ section.settings.desktop_fixed_height }}px{% else %}auto{% endif %};
    --hg-loc-ar: {% if section.settings.desktop_fixed_height > 0 %}auto{% else %}2 / 1{% endif %};
    --hg-main-height: {{ section.settings.mobile_main_height }}px;
    --hg-small-height: {{ section.settings.mobile_small_height }}px;
  }
{% endstyle %}

<div class="household-gallery-outer household-gallery-outer-{{ section_id }}">
  <div class="household-gallery-section household-gallery-section-{{ section_id }}">
    <div class="household-gallery-container household-gallery-container-{{ section_id }}">

      <div class="household-header household-header-{{ section_id }}">
        <div class="household-heading household-heading-{{ section_id }}">
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
        </div>

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="household-button household-button-{{ section_id }}">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="pill-nav-wrapper pill-nav-wrapper-{{ section_id }}">
          <nav class="pill-nav pill-nav-{{ section_id }}">
            {% for block in section.blocks %}
              {% render 'household-gallery-block-pill', block: block, section_id: section_id, is_first: forloop.first %}
            {% endfor %}
          </nav>
        </div>

        <div class="nvgd-location-wrapper">
          <div class="location-container location-container-{{ section_id }}">
            {% for block in section.blocks %}
              {% render 'household-gallery-block-location', block: block, section_id: section_id, is_first: forloop.first %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script src="{{ 'household-gallery.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
/* moved from inline style block for bundling */

/* Outer wrapper with background gradient - full width */
.household-gallery-outer {
  width: 100%;
  background: linear-gradient(
    to bottom,
    var(--hg-bg-top) 0%,
    var(--hg-bg-top) var(--hg-bg-split),
    var(--hg-bg-bottom) var(--hg-bg-split),
    var(--hg-bg-bottom) 100%
  );
  display: flex;
  justify-content: center;
}

/* Section - Full width, has global padding */
.household-gallery-section {
  width: 100%;
  padding: var(--hg-section-padding);
}

/* Container - Max-width centered, content fills this */
.household-gallery-container {
  width: 100%;
  margin: 0 auto;
  max-width: var(--hg-container-max);
}

/* --- Header Section --- */
.household-header {
  display: flex;
  justify-content: var(--hg-header-justify);
  align-items: center;
  margin-bottom: var(--hg-header-margin);
  text-align: left;
}

.household-heading h2 {
  font-family: var(--hg-heading-font);
  font-weight: var(--hg-heading-weight);
  font-size: var(--hg-heading-size);
  color: var(--hg-heading-color);
  line-height: 1.2;
  margin: 0;
}

/* --- Button Styling --- */
.household-button {
  display: inline-block;
  font-family: var(--hg-button-font);
  font-weight: var(--hg-button-weight);
  font-size: var(--hg-button-size);
  color: var(--hg-button-color);
  background-color: var(--hg-button-bg);
  padding: var(--hg-button-padding);
  border-radius: var(--hg-button-radius);
  text-decoration: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
  border: none;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 20px;
}

.household-button:hover {
  opacity: 0.9;
  transform: scale(1.02);
}

/* --- Pill Navigation --- */
.pill-nav-wrapper {
  margin-bottom: var(--hg-nav-margin);
  display: flex;
  justify-content: var(--hg-nav-justify);
}

.pill-nav {
  display: inline-flex;
  flex-wrap: wrap;
  gap: var(--hg-pill-gap);
  justify-content: var(--hg-nav-justify);
}

/* Pills are rendered by the household-gallery-block-pill snippet (owned elsewhere):
   targeted via their stable data-location attribute instead of per-instance classes. */
.pill-nav [data-location] {
  font-family: var(--hg-pill-font);
  font-weight: var(--hg-pill-weight);
  font-size: var(--hg-pill-size);
  color: var(--hg-pill-color);
  background-color: var(--hg-pill-bg);
  padding: var(--hg-pill-padding);
  border-radius: var(--hg-pill-radius);
  border: var(--hg-pill-border);
  text-decoration: none;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
  line-height: 1;
  display: flex;
  align-items: center;
}

.pill-nav [data-location]:hover {
  background-color: var(--hg-pill-bg-hover);
}

.pill-nav [data-location].active-pill {
  background-color: var(--hg-pill-active-bg);
  color: var(--hg-pill-active-text);
  border-color: var(--hg-pill-active-bg);
}

/* --- Image Grid Layout --- */
.location-container {
  width: 100%;
  max-width: 100%;
  display: grid;
}

.nvgd-location-wrapper {
  display: flex;
  width: 100%;
  justify-content: center;
}

/* Location panels/grid columns are rendered by the household-gallery-block-location
   snippet (owned elsewhere): targeted via data-location-content + structure. */
[data-location-content] {
  grid-area: 1 / 1;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0s 0.3s, visibility 0s 0.3s;
  grid-template-columns: var(--hg-grid-cols);
  gap: var(--hg-gap);
  display: grid;
  height: var(--hg-loc-height);
  aspect-ratio: var(--hg-loc-ar);
}

[data-location-content].active-location {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.3s ease, visibility 0s;
  z-index: 1;
  height: fit-content;
}

[data-location-content] > div {
  width: 100%;
  height: 100%;
  position: relative;
}

[data-location-content] > div.is-stacked {
  display: flex;
  flex-direction: column;
  gap: var(--hg-gap);
}

.hg-image-container {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: var(--hg-img-radius);
  overflow: hidden;
}

.is-stacked .hg-image-container {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: var(--hg-img-radius);
  overflow: hidden;
  flex: 1;
}

.hg-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* --- Responsive --- */
@media screen and (max-width: 1024px) {
  .household-heading h2 {
    font-size: var(--hg-heading-size-tablet);
  }

  .pill-nav [data-location] {
    font-size: 15px;
    padding: 10px 20px;
  }
}

@media screen and (max-width: 749px) {
  .household-gallery-section {
    padding: var(--hg-section-padding-mobile);
  }

  .household-header {
    flex-direction: column;
    align-items: var(--hg-header-align-mobile);
    text-align: var(--hg-header-align-mobile);
    gap: 20px;
  }

  .household-button {
    margin-left: 0;
  }

  .household-heading h2 {
    font-size: var(--hg-heading-size-mobile);
  }

  .location-container {
    width: 100%;
  }

  .pill-nav-wrapper {
    overflow-x: auto;
    justify-content: flex-start;
    padding-bottom: 10px;
    margin-left: var(--hg-nav-mx);
    margin-right: var(--hg-nav-mx);
    padding-left: var(--hg-nav-px);
    padding-right: var(--hg-nav-px);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .pill-nav-wrapper::-webkit-scrollbar { display: none; }

  .pill-nav {
    flex-wrap: nowrap;
  }

  .pill-nav [data-location] {
    font-size: 14px;
    padding: 8px 16px;
  }

  [data-location-content] {
    grid-template-columns: 1fr;
    height: auto;
    gap: var(--hg-gap-mobile);
  }

  [data-location-content].active-location {
    height: auto;
  }

  [data-location-content] > div {
    height: auto;
  }

  [data-location-content] > div.is-stacked {
    gap: var(--hg-gap-mobile);
    display: none;
  }

  [data-location-content] > div:not(.is-stacked) .hg-image-container {
    height: var(--hg-main-height);
  }

  [data-location-content] > div.is-stacked .hg-image-container {
    height: var(--hg-small-height);
    flex: none;
  }
}
{% endstylesheet %}

