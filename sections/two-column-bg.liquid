{% render 'section-corners', section: section %}
{% comment %} 
  Two Column Background Section
  Section with 2 column blocks, background options, and styling features 
{% endcomment %}

{%- comment -%}
  font_picker settings return a font object, and its family only renders once the
  @font-face declaration is emitted, so declare every font this section renders.
  The filter returns nothing for system fonts, so no guard is needed.
  https://shopify.dev/docs/storefronts/themes/architecture/settings/fonts
{%- endcomment -%}
{%- style -%}
  {%- for block in section.blocks -%}
    {{ block.settings.heading_font | font_face: font_display: 'swap' }}
    {{ block.settings.text_font | font_face: font_display: 'swap' }}
  {%- endfor -%}
{%- endstyle -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --tcbg-margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
    --tcbg-pad: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px{% else %}{{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px{% endif %};
    --tcbg-pad-m: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.padding_top_mobile }}px {{ section.settings.padding_right_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_left_mobile }}px{% endif %};
    --tcbg-gap: {{ section.settings.column_gap }}px;
    --tcbg-text-spacing: {{ section.settings.text_spacing }}px;
    --tcbg-heading-spacing: {{ section.settings.heading_spacing }}px;
    {% if section.settings.section_bg_type == 'color' %}
    --tcbg-bg-color: {{ section.settings.section_bg_color }};
    {% endif %}
    {% if section.settings.section_bg_type == 'image' and section.settings.section_bg_image != blank %}
    --tcbg-bg-image: url('{{ section.settings.section_bg_image | image_url: width: 1600 }}');
    --tcbg-bg-size: {{ section.settings.section_bg_image_size }};
    --tcbg-flip-x: {% if section.settings.flip_section_bg_horizontal %}-1{% else %}1{% endif %};
    --tcbg-flip-y: {% if section.settings.flip_section_bg_vertical %}-1{% else %}1{% endif %};
    {% endif %}
    {% if section.settings.section_bg_type == 'image' and section.settings.section_bg_image_mobile != blank %}
    --tcbg-bg-image-m: url('{{ section.settings.section_bg_image_mobile | image_url: width: 1200 }}');
    {% endif %}
    --tcbg-bg-size-m: {{ section.settings.section_bg_image_width_mobile }}px auto;
  }
{% endstyle %}

<div class="two-column-bg-section two-column-bg-section-{{ section.id }} nvgd-section-surface{% if section.settings.section_bg_type == 'color' %} two-column-bg-section--bg-color{% endif %}{% if section.settings.section_bg_type == 'image' and section.settings.section_bg_image != blank %} two-column-bg-section--bg-image{% endif %}{% if section.settings.section_bg_type == 'image' %} two-column-bg-section--bg-image-m{% endif %}{% if section.settings.mobile_column_order == 'reverse' %} two-column-bg-section--reverse{% endif %}">
  <div class="two-column-bg-section__container two-column-bg-section-{{ section.id }}__container page-width">
    <div class="two-column-bg-section__grid two-column-bg-section-{{ section.id }}__grid">
      {% assign total_width = 0 %}
      {% assign columns = section.blocks | where: 'type', 'column' %}

      {% comment %} Calculate total width and cap at 100% {% endcomment %}
      {% for block in columns %}
        {% assign total_width = total_width | plus: block.settings.column_width %}
      {% endfor %}

      {% for block in columns %}
        {% if forloop.index <= 2 %}
          {% comment %} Cap total width at 100% {% endcomment %}
          {% assign adjusted_width = block.settings.column_width %}
          {% if total_width > 100 %}
            {% assign adjusted_width = block.settings.column_width | times: 100 | divided_by: total_width %}
          {% endif %}

          <div
            class="two-column-bg-section__column two-column-bg-section-{{ section.id }}__column two-column-bg-section-{{ section.id }}__column--{{ block.id }}{% if block.settings.use_column_transform %} two-column-bg-section__column--transformed two-column-bg-section-{{ section.id }}__column--transformed{% endif %}"
            style="width: calc({{ adjusted_width }}% - {{ section.settings.column_gap }}px);
              --column-width-mobile: {{ block.settings.column_width_mobile }}%;
              {% if block.settings.use_column_transform %}
                --column-offset-x: {% render 'css-length', value: block.settings.column_transform_x_desktop %};
                --column-offset-y: {% render 'css-length', value: block.settings.column_transform_y_desktop %};
                --column-offset-x-mobile: {% render 'css-length', value: block.settings.column_transform_x_mobile %};
                --column-offset-y-mobile: {% render 'css-length', value: block.settings.column_transform_y_mobile %};
              {% endif %}"
            data-content-type="{{ block.settings.content_type }}"
            {{ block.shopify_attributes }}>


            <div class="two-column-bg-section__column-inner two-column-bg-section-{{ section.id }}__column-inner two-column-bg-section-{{ section.id }}__column-inner--{{ block.id }} {% if block.settings.content_type == 'text' and block.settings.wrap_text_background %}two-column-bg-section-{{ section.id }}__column-inner--wrapped{% endif %}" style="{% if block.settings.add_column_background %}
                          --column-pad-m: {{ block.settings.column_padding_top_mobile }}px {{ block.settings.column_padding_right_mobile }}px {{ block.settings.column_padding_bottom_mobile }}px {{ block.settings.column_padding_left_mobile }}px;
                          {% if block.settings.column_bg_type == 'image' and block.settings.column_bg_image != blank %}--column-bg-size-m: {{ block.settings.column_bg_image_width_mobile }}% auto;{% endif %}
                          {% if block.settings.column_bg_type == 'color' %}
                            background-color: {{ block.settings.column_bg_color }};
                          {% elsif block.settings.column_bg_type == 'image' and block.settings.column_bg_image != blank %}
                            background-image: url('{{ block.settings.column_bg_image | image_url: width: 1200 }}');
                            background-size: {{ block.settings.column_bg_image_width }}% auto;
                            background-position: center;
                            background-repeat: no-repeat;
                          {% endif %}
                          border-radius: {{ block.settings.column_border_radius }}px;
                          box-shadow: {{ block.settings.shadow_horizontal }}px {{ block.settings.shadow_vertical }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_spread }}px {{ block.settings.shadow_color }};
                          padding: {{ block.settings.column_padding_top }}px {{ block.settings.column_padding_right }}px {{ block.settings.column_padding_bottom }}px {{ block.settings.column_padding_left }}px;
                        {% endif %}">
              <div
                class="two-column-bg-section__content two-column-bg-section-{{ section.id }}__content two-column-bg-section-{{ section.id }}__content--{{ block.id }}{% if block.settings.use_transform %} two-column-bg-section__content--positioned two-column-bg-section-{{ section.id }}__content--positioned{% endif %}"
                {% if block.settings.use_transform %}
                style="{% render 'column-transform-variables', block: block %} --column-heading-size-m: {{ block.settings.heading_size_mobile }}px; --column-text-size-m: {{ block.settings.text_size_mobile }}px;"
                {% else %}
                style="margin: 0 auto; --column-heading-size-m: {{ block.settings.heading_size_mobile }}px; --column-text-size-m: {{ block.settings.text_size_mobile }}px;"
                {% endif %}>


                {% comment %} IMAGE CONTENT {% endcomment %}
                {% if block.settings.content_type == 'image' %}
                  {% if block.settings.image != blank %}
                    <div class="column-bg-image-wrapper column-bg-image-wrapper--{{ block.settings.image_ratio }} column-bg-image-wrapper--{{ section.id }}-{{ block.id }}" style="width: {{ block.settings.image_width }}%; border-radius: {{ block.settings.image_border_radius }}px; --image-width-m: {{ block.settings.image_width_mobile }}%;">
                      <img
                        class="column-bg-image"
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        style="transform: scaleX({% if block.settings.flip_image_horizontal %}-1{% else %}1{% endif %}) scaleY({% if block.settings.flip_image_vertical %}-1{% else %}1{% endif %});">
                    </div>
                  {% else %}
                    <div class="column-bg-image-wrapper column-bg-image-wrapper--{{ block.settings.image_ratio }} column-bg-image-wrapper--{{ section.id }}-{{ block.id }}" style="width: {{ block.settings.image_width }}%; border-radius: {{ block.settings.image_border_radius }}px; --image-width-m: {{ block.settings.image_width_mobile }}%;">
                      {% if request.design_mode %}{{ 'image' | placeholder_svg_tag: 'column-bg-image' }}{% endif %}
                    </div>
                  {% endif %}
                {% endif %}

                {% comment %} TEXT CONTENT {% endcomment %}
                {% if block.settings.content_type == 'text' %}
                  <div class="column-bg-text">
                    {% comment %} Item 1 {% endcomment %}
                    {% if block.settings.heading_1 != blank or block.settings.text_1 != blank %}
                      <div class="column-bg-text__item">
                        {% if block.settings.heading_1 != blank %}
                          <h3 class="column-bg-text__heading" style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                     font-size: {{ block.settings.heading_size_desktop }}px; 
                                     font-weight: {{ block.settings.heading_weight }}; 
                                     font-style: {{ block.settings.heading_style }}; 
                                     color: {{ block.settings.heading_color }};">
                            {{ block.settings.heading_1 }}
                          </h3>
                        {% endif %}
                        {% if block.settings.text_1 != blank %}
                          <div class="column-bg-text__text" style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                      font-size: {{ block.settings.text_size_desktop }}px; 
                                      font-weight: {{ block.settings.text_weight }}; 
                                      font-style: {{ block.settings.text_style }}; 
                                      color: {{ block.settings.text_color }};">
                            {{ block.settings.text_1 }}
                          </div>
                        {% endif %}
                        {% if block.settings.show_divider %}
                          <div class="column-bg-text__divider" style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                      margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                      height: {{ block.settings.divider_thickness }}px;
                                      background-color: {{ block.settings.divider_color }};
                                      width: {{ block.settings.divider_width }}%;">
</div>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% comment %} Item 2 {% endcomment %}
                    {% if block.settings.heading_2 != blank or block.settings.text_2 != blank %}
                      <div class="column-bg-text__item">
                        {% if block.settings.heading_2 != blank %}
                          <h3 class="column-bg-text__heading" style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                     font-size: {{ block.settings.heading_size_desktop }}px; 
                                     font-weight: {{ block.settings.heading_weight }}; 
                                     font-style: {{ block.settings.heading_style }}; 
                                     color: {{ block.settings.heading_color }};">
                            {{ block.settings.heading_2 }}
                          </h3>
                        {% endif %}
                        {% if block.settings.text_2 != blank %}
                          <div class="column-bg-text__text" style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                      font-size: {{ block.settings.text_size_desktop }}px; 
                                      font-weight: {{ block.settings.text_weight }}; 
                                      font-style: {{ block.settings.text_style }}; 
                                      color: {{ block.settings.text_color }};">
                            {{ block.settings.text_2 }}
                          </div>
                        {% endif %}
                        {% if block.settings.show_divider %}
                          <div class="column-bg-text__divider" style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                      margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                      height: {{ block.settings.divider_thickness }}px;
                                      background-color: {{ block.settings.divider_color }};
                                      width: {{ block.settings.divider_width }}%;">
</div>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% comment %} Item 3 {% endcomment %}
                    {% if block.settings.heading_3 != blank or block.settings.text_3 != blank %}
                      <div class="column-bg-text__item">
                        {% if block.settings.heading_3 != blank %}
                          <h3 class="column-bg-text__heading" style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                     font-size: {{ block.settings.heading_size_desktop }}px; 
                                     font-weight: {{ block.settings.heading_weight }}; 
                                     font-style: {{ block.settings.heading_style }}; 
                                     color: {{ block.settings.heading_color }};">
                            {{ block.settings.heading_3 }}
                          </h3>
                        {% endif %}
                        {% if block.settings.text_3 != blank %}
                          <div class="column-bg-text__text" style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                      font-size: {{ block.settings.text_size_desktop }}px; 
                                      font-weight: {{ block.settings.text_weight }}; 
                                      font-style: {{ block.settings.text_style }}; 
                                      color: {{ block.settings.text_color }};">
                            {{ block.settings.text_3 }}
                          </div>
                        {% endif %}
                        {% if block.settings.show_divider %}
                          <div class="column-bg-text__divider" style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                      margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                      height: {{ block.settings.divider_thickness }}px;
                                      background-color: {{ block.settings.divider_color }};
                                      width: {{ block.settings.divider_width }}%;">
</div>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% comment %} Item 4 {% endcomment %}
                    {% if block.settings.heading_4 != blank or block.settings.text_4 != blank %}
                      <div class="column-bg-text__item">
                        {% if block.settings.heading_4 != blank %}
                          <h3 class="column-bg-text__heading" style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                     font-size: {{ block.settings.heading_size_desktop }}px; 
                                     font-weight: {{ block.settings.heading_weight }}; 
                                     font-style: {{ block.settings.heading_style }}; 
                                     color: {{ block.settings.heading_color }};">
                            {{ block.settings.heading_4 }}
                          </h3>
                        {% endif %}
                        {% if block.settings.text_4 != blank %}
                          <div class="column-bg-text__text" style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                      font-size: {{ block.settings.text_size_desktop }}px; 
                                      font-weight: {{ block.settings.text_weight }}; 
                                      font-style: {{ block.settings.text_style }}; 
                                      color: {{ block.settings.text_color }};">
                            {{ block.settings.text_4 }}
                          </div>
                        {% endif %}
                        {% if block.settings.show_divider %}
                          <div class="column-bg-text__divider" style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                      margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                      height: {{ block.settings.divider_thickness }}px;
                                      background-color: {{ block.settings.divider_color }};
                                      width: {{ block.settings.divider_width }}%;">
</div>
                        {% endif %}
                      </div>
                    {% endif %}

                    {% comment %} Item 5 {% endcomment %}
                    {% if block.settings.heading_5 != blank or block.settings.text_5 != blank %}
                      <div class="column-bg-text__item">
                        {% if block.settings.heading_5 != blank %}
                          <h3 class="column-bg-text__heading" style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                     font-size: {{ block.settings.heading_size_desktop }}px; 
                                     font-weight: {{ block.settings.heading_weight }}; 
                                     font-style: {{ block.settings.heading_style }}; 
                                     color: {{ block.settings.heading_color }};">
                            {{ block.settings.heading_5 }}
                          </h3>
                        {% endif %}
                        {% if block.settings.text_5 != blank %}
                          <div class="column-bg-text__text" style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                      font-size: {{ block.settings.text_size_desktop }}px; 
                                      font-weight: {{ block.settings.text_weight }}; 
                                      font-style: {{ block.settings.text_style }}; 
                                      color: {{ block.settings.text_color }};">
                            {{ block.settings.text_5 }}
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
/* Static CSS moved from the per-instance inline style block. Setting-driven
   values are read from custom properties declared on the section root; the
   --bg-color / --bg-image modifier classes are chosen in Liquid. */
.two-column-bg-section {
  margin-top: var(--tcbg-margin-top);
  padding: var(--tcbg-pad);
  position: relative;
}

.two-column-bg-section--bg-color {
  background-color: var(--tcbg-bg-color);
}

.two-column-bg-section--bg-image::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: var(--tcbg-bg-image);
  background-size: var(--tcbg-bg-size);
  background-position: center;
  background-repeat: no-repeat;
  transform: scaleX(var(--tcbg-flip-x, 1)) scaleY(var(--tcbg-flip-y, 1));
  z-index: 0;
}

.two-column-bg-section__column--transformed {
  transform: translate(var(--column-offset-x), var(--column-offset-y));
}
@media (max-width: 768px) {
  .two-column-bg-section__column--transformed {
    transform: translate(var(--column-offset-x-mobile), var(--column-offset-y-mobile));
  }
}

.two-column-bg-section__content--positioned {
  transform: translate(var(--column-offset-x), var(--column-offset-y));
}
@media (max-width: 768px) {
  .two-column-bg-section__content--positioned {
    transform: translate(var(--column-offset-x-mobile), var(--column-offset-y-mobile));
  }
}

/* Image Styles */
.two-column-bg-section .column-bg-image-wrapper {
  width: 100%;
  overflow: hidden;
}

.two-column-bg-section .column-bg-image-wrapper--full {
  aspect-ratio: auto;
}

.two-column-bg-section .column-bg-image-wrapper--square {
  aspect-ratio: 1 / 1;
}

.two-column-bg-section .column-bg-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* Text Content Styles */
.two-column-bg-section .column-bg-text__item {
  margin-bottom: var(--tcbg-text-spacing);
}

.two-column-bg-section .column-bg-text__heading {
  margin-bottom: var(--tcbg-heading-spacing);
}

.two-column-bg-section .column-bg-text__text {
  line-height: 1.6;
}

.two-column-bg-section .column-bg-text__divider {
  display: block !important;
}

/* Responsive */
@media (max-width: 768px) {
  .two-column-bg-section {
    margin-top: 0;
    padding: var(--tcbg-pad-m) !important;
  }

  .two-column-bg-section--bg-image-m::before {
    background-image: var(--tcbg-bg-image-m, var(--tcbg-bg-image, none)) !important;
    background-size: var(--tcbg-bg-size-m) !important;
  }

  .two-column-bg-section__grid {
    flex-direction: column;
  }

  /* Mobile column ordering (modifier class chosen in Liquid) */
  .two-column-bg-section--reverse .two-column-bg-section__column:nth-child(1) {
    order: 2;
  }
  .two-column-bg-section--reverse .two-column-bg-section__column:nth-child(2) {
    order: 1;
  }
}

/* Per-column mobile width (custom property set on each column root) */
@media (max-width: 768px) {
  .two-column-bg-section__column {
    width: var(--column-width-mobile) !important;
  }
}

/* Per-block mobile inner padding and background size (custom properties set
   on each column-inner root) */
@media (max-width: 768px) {
  .two-column-bg-section__column-inner {
    padding: var(--column-pad-m, 0px) !important;
    background-size: var(--column-bg-size-m, auto) !important;
  }
}

/* Per-block mobile image wrapper width (custom property on each wrapper) */
@media (max-width: 768px) {
  .two-column-bg-section .column-bg-image-wrapper {
    width: var(--image-width-m, 100%) !important;
  }
}

/* Per-block mobile font sizes (custom properties set on each content root) */
@media (max-width: 768px) {
  .two-column-bg-section__content .column-bg-text__heading {
    font-size: var(--column-heading-size-m) !important;
  }
  .two-column-bg-section__content .column-bg-text__text {
    font-size: var(--column-text-size-m) !important;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Two column background",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "section_bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "section_bg_image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "section_bg_image_size",
      "label": "Background image size",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Fill & Crop)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit & Keep Ratio)"
        }
      ],
      "default": "cover",
      "info": "Cover fills the area (may crop), Contain fits the whole image (may show gaps)"
    },
    {
      "type": "range",
      "id": "section_bg_image_width",
      "min": 800,
      "max": 1800,
      "step": 10,
      "default": 1200,
      "unit": "px",
      "label": "Background image width (desktop)",
      "info": "Set exact pixel width for the background image"
    },
    {
      "type": "header",
      "content": "Background image flip"
    },
    {
      "type": "checkbox",
      "id": "flip_section_bg_horizontal",
      "label": "Flip background image horizontally (left/right)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "flip_section_bg_vertical",
      "label": "Flip background image vertically (up/down)",
      "default": false
    },
    {
      "type": "header",
      "content": "Background (mobile)"
    },
    {
      "type": "image_picker",
      "id": "section_bg_image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional: Use a different image for mobile. If not set, desktop image will be used"
    },
    {
      "type": "select",
      "id": "section_bg_image_size_mobile",
      "label": "Background image size (mobile)",
      "options": [
        {
          "value": "cover",
          "label": "Cover (Fill & Crop)"
        },
        {
          "value": "contain",
          "label": "Contain (Fit & Keep Ratio)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "section_bg_image_width_mobile",
      "min": 400,
      "max": 1200,
      "step": 10,
      "default": 760,
      "unit": "px",
      "label": "Background image width (mobile)",
      "info": "Set exact pixel width for the background image on mobile"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "px",
      "label": "Column gap"
    },
    {
