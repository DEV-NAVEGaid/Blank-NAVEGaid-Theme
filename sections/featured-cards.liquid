{% render 'section-corners', section: section %}
{% assign overlay_mode = section.settings.overlay_content %}

{% style %}
  #shopify-section-{{ section.id }} {
    /* Section - Full width, has ALL padding */
    --fc-bg: {{ section.settings.bg_color }};
    --fc-padding: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px{% else %}{{ section.settings.padding_top }}px {{ section.settings.padding_x }}px {{ section.settings.padding_bottom }}px{% endif %};
    --fc-padding-mobile: {% if section.settings.enable_global_spacing %}{{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px{% else %}{{ section.settings.padding_top_mobile }}px {{ section.settings.padding_x_mobile }}px {{ section.settings.padding_bottom_mobile }}px{% endif %};
    --fc-container-max: {% if section.settings.enable_global_spacing %}var(--page-width){% else %}{{ section.settings.container_width }}px{% endif %};

    /* Card Style */
    --card-bg: {{ section.settings.card_bg_color }};
    --card-radius: {{ section.settings.card_radius }}px;

    /* Image Style */
    --img-ratio: {{ section.settings.image_ratio }};
    --img-radius: {{ section.settings.image_radius }}px;
    --img-padding: {{ section.settings.image_padding }}px;

    /* Content & Typography */
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --content-align: {{ section.settings.content_align }};
    --content-padding: {{ section.settings.content_padding }}px;

    /* Overlay Specifics */
    --overlay-x: {{ section.settings.position_x }}%;
    --overlay-y: {{ section.settings.position_y }}%;
    --overlay-width: {{ section.settings.content_width }}%;
    --overlay-bg: {{ section.settings.content_bg_color }};
    --overlay-radius: {{ section.settings.content_radius }}px;

    /* Grid */
    --grid-gap: {{ section.settings.gap }}px;
    --grid-columns: {{ section.settings.columns }};
    --grid-columns-tablet: {{ section.settings.columns_tablet }};

    /* Mobile Overrides */
    --grid-gap-mobile: {{ section.settings.gap_mobile }}px;
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
    --content-align-mobile: {{ section.settings.content_align_mobile }};
    --content-padding-mobile: {{ section.settings.content_padding_mobile | default: section.settings.content_padding }}px;
    --overlay-x-mobile: {{ section.settings.position_x_mobile }}%;
    --overlay-y-mobile: {{ section.settings.position_y_mobile }}%;

    {% if section.settings.type_preset == 'custom' %}
    --fc-heading-font: {{ section.settings.font }};
    --fc-heading-size: {{ section.settings.font_size }};
    --fc-heading-lh: {% case section.settings.line_height %}{% when 'tight' %}1.2{% when 'loose' %}1.8{% else %}1.5{% endcase %};
    --fc-heading-ls: {% case section.settings.letter_spacing %}{% when 'tight' %}-0.02em{% when 'loose' %}0.05em{% else %}normal{% endcase %};
    --fc-heading-transform: {{ section.settings.case }};
    {% if section.settings.wrap %}--fc-heading-wrap: {{ section.settings.wrap }};{% endif %}
    {% endif %}
    {% if section.settings.text_type_preset == 'custom' %}
    --fc-text-font: {{ section.settings.text_font }};
    --fc-text-size: {{ section.settings.text_font_size }};
    --fc-text-lh: {% case section.settings.text_line_height %}{% when 'tight' %}1.2{% when 'loose' %}1.8{% else %}1.5{% endcase %};
    --fc-text-ls: {% case section.settings.text_letter_spacing %}{% when 'tight' %}-0.02em{% when 'loose' %}0.05em{% else %}normal{% endcase %};
    --fc-text-transform: {{ section.settings.text_case }};
    {% if section.settings.text_wrap %}--fc-text-wrap: {{ section.settings.text_wrap }};{% endif %}
    {% endif %}
  }
{% endstyle %}

<div class="feature-cards nvgd-section-surface{% if overlay_mode %} feature-cards--overlay{% endif %}{% if section.settings.type_preset == 'custom' %} feature-cards--custom-heading{% endif %}{% if section.settings.text_type_preset == 'custom' %} feature-cards--custom-text{% endif %}">
  <div class="feature-cards__container">
    <div class="feature-cards__grid">
      {% for block in section.blocks %}
        {% render 'featured-cards-block-card', block: block, section: section, overlay_mode: overlay_mode %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
/* moved from inline style block for bundling */
.feature-cards {
  width: 100%;
  background-color: var(--fc-bg);
  padding: var(--fc-padding);
}

.feature-cards .feature-cards__container {
  width: 100%;
  margin: 0 auto;
  max-width: var(--fc-container-max);
}

.feature-cards .feature-cards__grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns), 1fr);
  gap: var(--grid-gap);
}

.feature-cards .feature-cards__card {
  position: relative;
  display: flex;
  flex-direction: column;
  background-color: var(--card-bg);
  border-radius: var(--card-radius);
  overflow: hidden;
  isolation: isolate;
}

.feature-cards .feature-cards__media {
  position: relative;
  width: 100%;
  padding: var(--img-padding);
  box-sizing: border-box;
}

.feature-cards .feature-cards__media img,
.feature-cards .feature-cards__media video,
.feature-cards .feature-cards__media iframe {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  aspect-ratio: var(--img-ratio);
  border-radius: var(--img-radius);
}

.feature-cards .feature-cards__placeholder {
  background-color: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: var(--img-ratio);
  border-radius: var(--img-radius);
}
.feature-cards .feature-cards__placeholder svg {
  width: 50%; opacity: 0.4;
}

.feature-cards .feature-cards__content {
  text-align: var(--content-align);
  padding: var(--content-padding);
  box-sizing: border-box;
}

.feature-cards .feature-cards__heading {
  color: var(--heading-color);
  line-height: 1.2;
  margin: 0 0 12px;
}

.feature-cards .feature-cards__text {
  color: var(--text-color);
  line-height: 1.6;
  margin: 0;
}

.feature-cards--overlay .feature-cards__content {
  position: absolute;
  z-index: 2;
  top: var(--overlay-y);
  left: var(--overlay-x);
  transform: translate(-50%, -50%);
  width: var(--overlay-width);
  max-width: calc(100% - 30px);

  background-color: var(--overlay-bg);
  border-radius: var(--overlay-radius);
}

.feature-cards--custom-heading .feature-cards__heading {
  font-family: var(--fc-heading-font);
  font-size: var(--fc-heading-size);
  line-height: var(--fc-heading-lh);
  letter-spacing: var(--fc-heading-ls);
  text-transform: var(--fc-heading-transform);
  text-wrap: var(--fc-heading-wrap, wrap);
}

.feature-cards--custom-text .feature-cards__text {
  font-family: var(--fc-text-font);
  font-size: var(--fc-text-size);
  line-height: var(--fc-text-lh);
  letter-spacing: var(--fc-text-ls);
  text-transform: var(--fc-text-transform);
  text-wrap: var(--fc-text-wrap, wrap);
}

@media screen and (max-width: 750px) {
  .feature-cards {
    padding: var(--fc-padding-mobile);
    --grid-gap: var(--grid-gap-mobile);
    --grid-columns: var(--grid-columns-mobile);
    --content-align: var(--content-align-mobile);
    --content-padding: var(--content-padding-mobile);
    --overlay-x: var(--overlay-x-mobile);
    --overlay-y: var(--overlay-y-mobile);
  }
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .feature-cards .feature-cards__grid {
    grid-template-columns: repeat(var(--grid-columns-tablet), 1fr);
  }
}
{% endstylesheet %}

