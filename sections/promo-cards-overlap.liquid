{% assign section_id = section.id | replace: '_', '' | downcase %}

{%- comment -%}
  font_picker settings return a font object, and its family only renders once the
  @font-face declaration is emitted, so declare every card font this section renders.
  The filter returns nothing for system fonts, so no guard is needed, and the global
  typography fonts are already declared in the layout.
  https://shopify.dev/docs/storefronts/themes/architecture/settings/fonts
{%- endcomment -%}
{%- unless section.settings.enable_global_typography -%}
  {%- style -%}
    {%- for block in section.blocks -%}
      {{ block.settings.s1_heading_font | font_face: font_display: 'swap' }}
      {{ block.settings.s1_sub_font | font_face: font_display: 'swap' }}
      {{ block.settings.s1_text_font | font_face: font_display: 'swap' }}
      {{ block.settings.s2_heading_font | font_face: font_display: 'swap' }}
      {{ block.settings.s2_sub_font | font_face: font_display: 'swap' }}
      {{ block.settings.s2_text_font | font_face: font_display: 'swap' }}
      {{ block.settings.s3_heading_font | font_face: font_display: 'swap' }}
      {{ block.settings.s3_sub_font | font_face: font_display: 'swap' }}
      {{ block.settings.s3_text_font | font_face: font_display: 'swap' }}
    {%- endfor -%}
  {%- endstyle -%}
{%- endunless -%}

{% style %}
  /* Outer Section - Handles Padding */
  .promo-cards-section-{{ section_id }} {
    border-radius: {{ section.settings.section_border_radius }}px;
    {% if section.settings.enable_global_spacing %}
      padding: {{ settings.padding_vertical }}px {{ settings.padding_horizontal }}px;
    {% else %}
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .promo-cards-section-{{ section_id }} {
      {% if section.settings.enable_global_spacing %}
        padding: {{ settings.padding_vertical_mobile }}px {{ settings.padding_horizontal_mobile }}px;
      {% else %}
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        padding-left: {{ section.settings.padding_left_mobile }}px;
        padding-right: {{ section.settings.padding_right_mobile }}px;
      {% endif %}
    }
  }

  /* Inner Container - Handles Max Width */
  .promo-cards-container-{{ section_id }} {
    margin: 0 auto;
    width: 100%;
    border-radius: {{ section.settings.container_border_radius }}px;
    {% if section.settings.enable_global_spacing %}
      max-width: var(--page-width);
    {% elsif section.settings.section_width == 'fixed' %}
      {% if section.settings.use_custom_container_width %}
        max-width: {{ section.settings.custom_container_width }}px;
      {% else %}
        max-width: {{ section.settings.container_width }}px;
      {% endif %}
    {% else %}
      max-width: 100%;
    {% endif %}
  }

  .promo-cards-{{ section_id }} {
    position: relative;
    z-index: {{ section.settings.z_index }};
    margin-top: {{ section.settings.margin_top }}px;
    padding: {{ section.settings.inner_padding_top }}px {{ section.settings.inner_padding_right }}px {{ section.settings.inner_padding_bottom }}px {{ section.settings.inner_padding_left }}px;
    display: {% if section.settings.cards_layout == 'grid' %}grid{% else %}flex{% endif %};
    {% if section.settings.cards_layout == 'grid' %}
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    {% else %}
      flex-direction: column;
    {% endif %}
    gap: {{ section.settings.cards_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .promo-cards-{{ section_id }} {
      display: flex;
      flex-direction: column;
      margin-top: {{ section.settings.margin_top_mobile }}px;
      padding: {{ section.settings.inner_padding_top_mobile }}px {{ section.settings.inner_padding_right_mobile }}px {{ section.settings.inner_padding_bottom_mobile }}px {{ section.settings.inner_padding_left_mobile }}px;
      gap: {{ section.settings.cards_gap_mobile }}px;
    }
  }
{% endstyle %}

<div class="promo-cards-section-{{ section_id }}">
  <div class="promo-cards-container-{{ section_id }}">
    <div class="promo-cards-{{ section_id }}">
    {% for block in section.blocks %}
      {% render 'promo-cards-overlap-block-card', block: block, section: section %}
    {% endfor %}
    </div>
  </div>
</div>

