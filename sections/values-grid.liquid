  ],
  "presets": [
    {
      "name": "Values grid",
      "settings": {
        "heading": "Heading"
      },
      "blocks": [
        {
          "type": "value"
        },
        {
          "type": "value"
        },
        {
          "type": "value"
        }
      ]
    }
  ]
