{% render 'section-corners', section: section %}
{{ 'section-editorial.css' | asset_url | stylesheet_tag }}
{% render 'editorial-style', section: section %}
<div class="nvgd-editorial" style="--value-columns: {{ section.settings.columns }}; --value-columns-mobile: {{ section.settings.columns_mobile }}; --value-padding: {{ section.settings.card_padding }}px; --value-background: {{ section.settings.card_background }}; --value-border: {{ section.settings.card_border }}; --value-icon-background: {{ section.settings.icon_background }}; --value-heading-size: {{ section.settings.card_heading_size }}px; --value-heading-family: {% if section.settings.card_heading_style == 'heading' %}var(--font-heading-family){% else %}var(--font-body-family){% endif %};">
  <div class="nvgd-editorial__inner">
    {% render 'editorial-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, link_label: section.settings.link_label, link_url: section.settings.link_url %}
    <div class="nvgd-values">
      {% for block in section.blocks %}
        <article class="nvgd-values__card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="nvgd-values__icon">
              {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', sizes: '24px' }}
            </div>
          {% elsif block.settings.show_icon %}
            <div class="nvgd-values__icon">
              {% render 'editorial-icon', icon: block.settings.icon %}
            </div>
          {% endif %}
          {% if block.settings.heading != blank %}<h3>{{ block.settings.heading }}</h3>{% endif %}
          {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Values grid",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "secondary_color",
      "label": "Secondary text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns",
