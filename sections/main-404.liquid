{% render 'section-corners', section: section %}
{% style %}
  #shopify-section-{{ section.id }} {
    --notfound-title-size: {{ section.settings.heading_size | default: 64 }}px;
    --notfound-title-size-mobile: {{ section.settings.heading_size_mobile | default: 40 }}px;
  }
{% endstyle %}

<div class="template-404 page-width page-margin center nvgd-section-surface">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    {{ 'general.continue_shopping' | t }}
  </a>
</div>

{% stylesheet %}
  .template-404 .title {
    font-size: var(--notfound-title-size-mobile, 40px);
  }

  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title {
      font-size: var(--notfound-title-size, 64px);
    }

    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "header",
      "content": "Section corners"
    },
    {
      "type": "checkbox",
      "id": "custom_section_corners",
      "label": "Customize section corners",
      "default": false
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_section_corners }}"
    },
    {
      "type": "checkbox",
      "id": "clip_section_corners",
      "label": "Clip content to corners",
      "default": false,
      "info": "Enable for edge-to-edge images. Leave off for menus, popups, sticky content, or overlapping elements.",
      "visible_if": "{{ section.settings.custom_section_corners and section.settings.section_corner_radius > 0 }}"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 32,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
