{% render 'section-corners', section: section %}
{% comment %}
  Two Column Section with Banner
  Features: Banner image on top, two columns below with horizontal/vertical layout option
{% endcomment %}

{%- comment -%}
  font_picker settings return a font object, and its family only renders once the
  @font-face declaration is emitted, so declare every font this section renders.
  The filter returns nothing for system fonts, so no guard is needed.
  https://shopify.dev/docs/storefronts/themes/architecture/settings/fonts
{%- endcomment -%}
{%- style -%}
  {%- for block in section.blocks -%}
    {{ block.settings.heading_font | font_face: font_display: 'swap' }}
    {{ block.settings.text_font | font_face: font_display: 'swap' }}
  {%- endfor -%}
{%- endstyle -%}

{% style %}
  #shopify-section-{{ section.id }} {
    --tcb-pad-top: {{ section.settings.padding_top }}px;
    --tcb-pad-bottom: {{ section.settings.padding_bottom }}px;
    --tcb-banner-spacing: {{ section.settings.banner_bottom_spacing }}px;
    --tcb-banner-radius: {{ section.settings.banner_border_radius }}px;
    --tcb-banner-radius-mobile: {{ section.settings.banner_border_radius_mobile }}px;
    --tcb-gap: {{ section.settings.column_gap }}px;
    --tcb-text-spacing: {{ section.settings.text_spacing }}px;
    --tcb-heading-spacing: {{ section.settings.heading_spacing }}px;
  }
{% endstyle %}

<div class="two-column-banner two-column-banner-{{ section.id }} nvgd-section-surface{% if section.settings.mobile_column_order == 'reverse' %} two-column-banner--reverse-order{% endif %}">
  <div class="two-column-banner__container two-column-banner-{{ section.id }}__container
  {% if section.settings.section_width == 'page' %}
    page-width
  {% endif %}
">

    {% comment %} BANNER IMAGE {% endcomment %}
    {% if section.settings.banner_image != blank %}
      <div class="two-column-banner__banner two-column-banner-{{ section.id }}__banner">
        <picture>
          {% if section.settings.banner_image_mobile != blank %}
            <source media="(max-width: 768px)" srcset="{{ section.settings.banner_image_mobile | image_url: width: 1200 }}">
          {% endif %}
          <img
            class="two-column-banner__banner-image two-column-banner-{{ section.id }}__banner-image"
            src="{{ section.settings.banner_image | image_url: width: 1600 }}"
            alt="{{ section.settings.banner_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.banner_image.width }}"
            height="{{ section.settings.banner_image.height }}">
        </picture>
      </div>
    {% endif %}

    {% comment %} COLUMNS GRID {% endcomment %}
    <div class="two-column-banner__grid two-column-banner-{{ section.id }}__grid">
      {% assign total_width = 0 %}
      {% assign columns = section.blocks | where: 'type', 'column' %}

      {% comment %} Calculate total width and cap at 100% {% endcomment %}
      {% for block in columns %}
        {% assign total_width = total_width | plus: block.settings.column_width %}
      {% endfor %}

      {% for block in columns %}
        {% if forloop.index <= 2 %}
          {% comment %} Cap total width at 100% {% endcomment %}
          {% assign adjusted_width = block.settings.column_width %}
          {% if total_width > 100 %}
            {% assign adjusted_width = block.settings.column_width | times: 100 | divided_by: total_width %}
          {% endif %}

          <div class="two-column-banner__column two-column-banner-{{ section.id }}__column"
               style="
                width: calc({{ adjusted_width }}% - {{ section.settings.column_gap }}px);
              "
               {{ block.shopify_attributes }}>
            <div class="two-column-banner__content two-column-banner-{{ section.id }}__content{% if block.settings.content_type == 'text' %} two-column-banner__text two-column-banner-{{ section.id }}__text{% if block.settings.text_layout == 'horizontal' %}--horizontal two-column-banner-{{ section.id }}__text--horizontal{% endif %}{% endif %}{% if block.settings.use_transform %} two-column-banner__content--positioned two-column-banner-{{ section.id }}__content--positioned{% endif %}"
              {% if block.settings.content_type == 'text' %}
                style="--tcb-heading-size-mobile: {{ block.settings.heading_size_mobile }}px; --tcb-text-size-mobile: {{ block.settings.text_size_mobile }}px; --tcb-text-gap: {{ block.settings.text_content_gap }}px;{% if block.settings.use_transform %}{% render 'column-transform-variables', block: block %}{% endif %}"
              {% elsif block.settings.use_transform %}
                style="{% render 'column-transform-variables', block: block %}"
              {% endif %}>

              {% comment %} IMAGE CONTENT {% endcomment %}
              {% if block.settings.content_type == 'image' %}
                {% if block.settings.image != blank %}
                  <div class="column-image-wrapper column-image-wrapper--{{ block.settings.image_ratio }} column-image-wrapper--{{ section.id }}-{{ block.id }}"
                       style="width: {{ block.settings.image_width }}%; border-radius: {{ block.settings.image_border_radius }}px; --tcb-img-w-mobile: {{ block.settings.image_width_mobile }}%;">
                    <img
                      class="column-image"
                      src="{{ block.settings.image | image_url: width: 1200 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}">
                  </div>
                {% else %}
                  <div class="column-image-wrapper column-image-wrapper--{{ block.settings.image_ratio }} column-image-wrapper--{{ section.id }}-{{ block.id }}"
                       style="width: {{ block.settings.image_width }}%; border-radius: {{ block.settings.image_border_radius }}px; --tcb-img-w-mobile: {{ block.settings.image_width_mobile }}%;">
                    {% if request.design_mode %}{{ 'image' | placeholder_svg_tag: 'column-image' }}{% endif %}
                  </div>
                {% endif %}
              {% endif %}

              {% comment %} TEXT CONTENT {% endcomment %}
              {% if block.settings.content_type == 'text' %}
                <div class="column-text">
                  {% comment %} Item 1 {% endcomment %}
                  {% if block.settings.heading_1 != blank or block.settings.text_1 != blank %}
                    <div class="column-text__item">
                      {% if block.settings.heading_1 != blank %}
                        <h3 class="column-text__heading"
                            style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                   font-size: {{ block.settings.heading_size_desktop }}px;
                                   font-weight: {{ block.settings.heading_weight }};
                                   font-style: {{ block.settings.heading_style }};
                                   color: {{ block.settings.heading_color }};">
                          {{ block.settings.heading_1 }}
                        </h3>
                      {% endif %}
                      {% if block.settings.text_1 != blank %}
                        <div class="column-text__text"
                             style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                    font-size: {{ block.settings.text_size_desktop }}px;
                                    font-weight: {{ block.settings.text_weight }};
                                    font-style: {{ block.settings.text_style }};
                                    color: {{ block.settings.text_color }};">
                          {{ block.settings.text_1 }}
                        </div>
                      {% endif %}
                      {% if block.settings.show_divider %}
                        <div class="column-text__divider"
                             style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                    margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                    height: {{ block.settings.divider_thickness }}px;
                                    background-color: {{ block.settings.divider_color }};
                                    width: {{ block.settings.divider_width }}%;"></div>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% comment %} Item 2 {% endcomment %}
                  {% if block.settings.heading_2 != blank or block.settings.text_2 != blank %}
                    <div class="column-text__item">
                      {% if block.settings.heading_2 != blank %}
                        <h3 class="column-text__heading"
                            style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                   font-size: {{ block.settings.heading_size_desktop }}px;
                                   font-weight: {{ block.settings.heading_weight }};
                                   font-style: {{ block.settings.heading_style }};
                                   color: {{ block.settings.heading_color }};">
                          {{ block.settings.heading_2 }}
                        </h3>
                      {% endif %}
                      {% if block.settings.text_2 != blank %}
                        <div class="column-text__text"
                             style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                    font-size: {{ block.settings.text_size_desktop }}px;
                                    font-weight: {{ block.settings.text_weight }};
                                    font-style: {{ block.settings.text_style }};
                                    color: {{ block.settings.text_color }};">
                          {{ block.settings.text_2 }}
                        </div>
                      {% endif %}
                      {% if block.settings.show_divider %}
                        <div class="column-text__divider"
                             style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                    margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                    height: {{ block.settings.divider_thickness }}px;
                                    background-color: {{ block.settings.divider_color }};
                                    width: {{ block.settings.divider_width }}%;"></div>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% comment %} Item 3 {% endcomment %}
                  {% if block.settings.heading_3 != blank or block.settings.text_3 != blank %}
                    <div class="column-text__item">
                      {% if block.settings.heading_3 != blank %}
                        <h3 class="column-text__heading"
                            style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                   font-size: {{ block.settings.heading_size_desktop }}px;
                                   font-weight: {{ block.settings.heading_weight }};
                                   font-style: {{ block.settings.heading_style }};
                                   color: {{ block.settings.heading_color }};">
                          {{ block.settings.heading_3 }}
                        </h3>
                      {% endif %}
                      {% if block.settings.text_3 != blank %}
                        <div class="column-text__text"
                             style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                    font-size: {{ block.settings.text_size_desktop }}px;
                                    font-weight: {{ block.settings.text_weight }};
                                    font-style: {{ block.settings.text_style }};
                                    color: {{ block.settings.text_color }};">
                          {{ block.settings.text_3 }}
                        </div>
                      {% endif %}
                      {% if block.settings.show_divider %}
                        <div class="column-text__divider"
                             style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                    margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                    height: {{ block.settings.divider_thickness }}px;
                                    background-color: {{ block.settings.divider_color }};
                                    width: {{ block.settings.divider_width }}%;"></div>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% comment %} Item 4 {% endcomment %}
                  {% if block.settings.heading_4 != blank or block.settings.text_4 != blank %}
                    <div class="column-text__item">
                      {% if block.settings.heading_4 != blank %}
                        <h3 class="column-text__heading"
                            style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                   font-size: {{ block.settings.heading_size_desktop }}px;
                                   font-weight: {{ block.settings.heading_weight }};
                                   font-style: {{ block.settings.heading_style }};
                                   color: {{ block.settings.heading_color }};">
                          {{ block.settings.heading_4 }}
                        </h3>
                      {% endif %}
                      {% if block.settings.text_4 != blank %}
                        <div class="column-text__text"
                             style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                    font-size: {{ block.settings.text_size_desktop }}px;
                                    font-weight: {{ block.settings.text_weight }};
                                    font-style: {{ block.settings.text_style }};
                                    color: {{ block.settings.text_color }};">
                          {{ block.settings.text_4 }}
                        </div>
                      {% endif %}
                      {% if block.settings.show_divider %}
                        <div class="column-text__divider"
                             style="margin-top: {{ block.settings.divider_spacing_top }}px;
                                    margin-bottom: {{ block.settings.divider_spacing_bottom }}px;
                                    height: {{ block.settings.divider_thickness }}px;
                                    background-color: {{ block.settings.divider_color }};
                                    width: {{ block.settings.divider_width }}%;"></div>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% comment %} Item 5 {% endcomment %}
                  {% if block.settings.heading_5 != blank or block.settings.text_5 != blank %}
                    <div class="column-text__item">
                      {% if block.settings.heading_5 != blank %}
                        <h3 class="column-text__heading"
                            style="font-family: {{ block.settings.heading_font.family | escape }}, {{ block.settings.heading_font.fallback_families | escape }};
                                   font-size: {{ block.settings.heading_size_desktop }}px;
                                   font-weight: {{ block.settings.heading_weight }};
                                   font-style: {{ block.settings.heading_style }};
                                   color: {{ block.settings.heading_color }};">
                          {{ block.settings.heading_5 }}
                        </h3>
                      {% endif %}
                      {% if block.settings.text_5 != blank %}
                        <div class="column-text__text"
                             style="font-family: {{ block.settings.text_font.family | escape }}, {{ block.settings.text_font.fallback_families | escape }};
                                    font-size: {{ block.settings.text_size_desktop }}px;
                                    font-weight: {{ block.settings.text_weight }};
                                    font-style: {{ block.settings.text_style }};
                                    color: {{ block.settings.text_color }};">
                          {{ block.settings.text_5 }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>

              {% endif %}

            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
/* moved from inline style block for bundling */
.two-column-banner {
  padding: var(--tcb-pad-top) 0 var(--tcb-pad-bottom);
}

.two-column-banner__container {
  width: 100%;
}

/* Banner Image Styles */
.two-column-banner__banner {
  width: 100%;
  margin-bottom: var(--tcb-banner-spacing);
  overflow: hidden;
  border-radius: var(--tcb-banner-radius);
}

.two-column-banner__banner-image {
  width: 100%;
  height: auto;
  display: block;
}

/* Column Grid Styles */
.two-column-banner__grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--tcb-gap);
}

.two-column-banner__column {
  flex: 1 1 auto;
  min-width: 0;
  position: relative;
}

.two-column-banner__content {
  height: 100%;
}

.two-column-banner__content--positioned {
  transform: translate(var(--column-offset-x), var(--column-offset-y));
}

/* Image Styles */
.two-column-banner .column-image-wrapper {
  width: 100%;
  overflow: hidden;
}

.two-column-banner .column-image-wrapper--full {
  aspect-ratio: auto;
}

.two-column-banner .column-image-wrapper--square {
  aspect-ratio: 1 / 1;
}

.two-column-banner .column-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

/* Text Content Styles */
.two-column-banner .column-text__item {
  margin-bottom: var(--tcb-text-spacing);
}

.two-column-banner .column-text__item:last-child {
  margin-bottom: 0;
}

.two-column-banner .column-text__heading {
  margin-bottom: var(--tcb-heading-spacing);
}

.two-column-banner .column-text__text {
  line-height: 1.6;
}

.two-column-banner .column-text__divider {
  display: block !important;
}

/* Per-block text layout (was a style block in the block loop) */
.two-column-banner__text .column-text__item {
  display: flex;
  flex-direction: column;
}

.two-column-banner__text--horizontal .column-text__item {
  flex-direction: row;
  gap: var(--tcb-text-gap, 20px);
  align-items: flex-start;
}

.two-column-banner__text--horizontal .column-text__item .column-text__heading {
  flex: 0 0 50%;
  max-width: 50%;
  margin: 0 !important;
}

.two-column-banner__text--horizontal .column-text__item .column-text__text {
  flex: 0 0 50%;
  max-width: 50%;
}

.two-column-banner__text .column-text__item .column-text__text {
  flex: 1;
}

/* Responsive */
@media (max-width: 768px) {
  .two-column-banner__banner {
    border-radius: var(--tcb-banner-radius-mobile);
  }

  .two-column-banner__grid {
    flex-direction: column;
  }

  .two-column-banner__column {
    width: 100% !important;
  }

  .two-column-banner__content--positioned {
    transform: translate(var(--column-offset-x-mobile), var(--column-offset-y-mobile));
  }

  .two-column-banner .column-image-wrapper {
    width: var(--tcb-img-w-mobile) !important;
  }

  .two-column-banner__text .column-text__item {
    flex-direction: column !important;
    gap: 0 !important;
  }

  .two-column-banner__text .column-text__item .column-text__heading {
    margin-bottom: var(--tcb-heading-spacing) !important;
  }

  .two-column-banner__text .column-text__heading {
    font-size: var(--tcb-heading-size-mobile) !important;
  }

  .two-column-banner__text .column-text__text {
    font-size: var(--tcb-text-size-mobile) !important;
  }

  /* Mobile column ordering */
  .two-column-banner--reverse-order .two-column-banner__column:nth-child(1) {
    order: 2;
  }

  .two-column-banner--reverse-order .two-column-banner__column:nth-child(2) {
    order: 1;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Two column with banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_mobile",
      "label": "Banner image (mobile)",
      "info": "Optional: Use a different image for mobile. If not set, desktop image will be used"
    },
    {
      "type": "range",
      "id": "banner_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10,
      "unit": "px",
      "label": "Banner border radius (desktop)"
    },
    {
      "type": "range",
      "id": "banner_border_radius_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10,
      "unit": "px",
      "label": "Banner border radius (mobile)"
    },
    {
      "type": "range",
      "id": "banner_bottom_spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px",
      "label": "Space below banner"
    },
    {
      "type": "header",
      "content": "Column layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "px",
      "label": "Column gap"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_column_order",
      "label": "Mobile column order",
      "options": [
        {
          "value": "default",
          "label": "Default (1, 2)"
        },
        {
          "value": "reverse",
          "label": "Reverse (2, 1)"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "px",
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "px",
      "label": "Padding bottom"
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px",
      "label": "Padding left"
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px",
      "label": "Padding right"
    },
    {
      "type": "header",
      "content": "Text spacing"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20,
      "unit": "px",
      "label": "Space between text items"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px",
      "label": "Space below heading"
    },
    {
      "type": "header",
      "content": "Section corners"
    },
    {
      "type": "checkbox",
      "id": "custom_section_corners",
      "label": "Customize section corners",
      "default": false
    },
    {
      "type": "range",
      "id": "section_corner_radius",
      "label": "Section corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.custom_section_corners }}"
    },
    {
      "type": "checkbox",
      "id": "clip_section_corners",
      "label": "Clip content to corners",
      "default": false,
      "info": "Enable for edge-to-edge images. Leave off for menus, popups, sticky content, or overlapping elements.",
      "visible_if": "{{ section.settings.custom_section_corners and section.settings.section_corner_radius > 0 }}"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 2,
      "settings": [
        {
          "type": "range",
          "id": "column_width",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 50,
          "unit": "%",
          "label": "Column width",
          "info": "Width will be adjusted if total exceeds 100%"
        },
        {
          "type": "select",
          "id": "content_type",
          "label": "Content type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "text",
              "label": "Text"
            }
          ],
          "default": "image"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 100,
          "unit": "%",
          "label": "Image width (desktop)"
        },
        {
          "type": "range",
          "id": "image_width_mobile",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 100,
          "unit": "%",
          "label": "Image width (mobile)"
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image aspect ratio",
          "options": [
            {
              "value": "full",
              "label": "Original (Full)"
            },
            {
              "value": "square",
              "label": "Square (1:1)"
            }
          ],
          "default": "full"
        },
        {
