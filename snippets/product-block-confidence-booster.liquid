  Usage: {% render 'product-block-confidence-booster', block: block %}
{% endcomment %}

<div class="confidence-booster-container" {{ block.shopify_attributes }}>
  <ul>
    {%- for i in (1..3) -%}
      {%- assign text_key = 'benefit_text_' | append: i -%}
      {%- assign image_key = 'image_icon_' | append: i -%}
      {%- assign benefit_text = block.settings[text_key] -%}
      {%- assign benefit_image = block.settings[image_key] -%}

      {%- if benefit_text != blank -%}
        <li class="confidence-content">

          {%- if benefit_image != blank -%}
            <img
              src="{{ benefit_image | image_url: width: 40 }}"
              alt="{{ benefit_text | escape }}"
              width="24"
              height="24"
              loading="lazy"
            >

          {%- elsif i == 1 -%}
