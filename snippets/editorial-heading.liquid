{%- if eyebrow != blank or heading != blank or text != blank or link_label != blank -%}
  <div class="nvgd-editorial__header-wrapper">
    <div class="nvgd-editorial__heading">
      {%- if eyebrow != blank -%}<p class="nvgd-editorial__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
      {%- if heading != blank -%}<h2>{{ heading }}</h2>{%- endif -%}
      {%- if text != blank -%}<div class="rte nvgd-editorial__description">{{ text }}</div>{%- endif -%}
    </div>
    {%- if link_label != blank -%}
      <div class="nvgd-editorial__header-action">
        <a href="{{ link_url | default: '#' }}" class="nvgd-editorial__link">
          {{ link_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
