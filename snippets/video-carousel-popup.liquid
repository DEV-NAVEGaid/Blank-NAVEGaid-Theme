{% stylesheet %}
  /* Popup Overlay */
  .nvgd-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  .nvgd-popup-overlay.nvgd-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Popup Container */
  .nvgd-popup-container {
    position: fixed;
    bottom: 20px;
    right: -100%;
    width: 90%;
    max-width: 380px;
    height: 85vh;
    max-height: 620px;
    background-color: #000;
    z-index: 9999;
    transition: right 0.3s ease;
    overflow: hidden;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.3);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
  }

  .nvgd-popup-container.nvgd-active {
    right: 20px;
  }

  /* Progress Bar */
  .nvgd-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.3);
    z-index: 13;
    display: block !important;
  }

  .nvgd-progress-fill {
    height: 100%;
    width: 0%;
    background-color: #fff;
    display: block !important;
  }

  /* Popup Header */
  .nvgd-popup-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
    padding: 15px 15px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    z-index: 12;
    pointer-events: none;
  }

  .nvgd-popup-header button {
    pointer-events: auto;
  }

  .nvgd-header-left {
    display: flex;
    gap: 10px;
  }

  .nvgd-header-right {
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: center;
  }

  .nvgd-popup-close {
    width: 44px;
    height: 44px;
    border: none;
    background-color: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: white;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .nvgd-popup-close:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .nvgd-popup-menu {
    width: 44px;
    height: 44px;
    border: none;
    background-color: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .nvgd-popup-menu:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .nvgd-popup-share {
    width: 44px;
    height: 44px;
    border: none;
    background-color: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .nvgd-popup-share:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  /* Popup Content */
  .nvgd-popup-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .nvgd-video-container {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .nvgd-video-player {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Navigation arrows */
  .nvgd-nav-vertical {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 15px;
    z-index: 11;
  }

  .nvgd-nav-arrow-alt {
    width: 44px;
    height: 44px;
    background-color: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
    transition: background-color 0.2s ease;
  }

  .nvgd-nav-arrow-alt:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  /* Sound toggle button */
  .nvgd-sound-toggle {
    position: absolute;
    bottom: 70px;
    right: 15px;
    width: 44px;
    height: 44px;
    background-color: rgba(255, 255, 255, 0.2);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    color: white;
    transition: background-color 0.2s ease;
    z-index: 11;
  }

  .nvgd-sound-toggle:hover {
    background-color: rgba(255, 255, 255, 0.3);
  }

  .nvgd-video-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 15px 70px 15px;
    background: linear-gradient(0deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    color: white;
    z-index: 11;
    pointer-events: none;
  }

  .nvgd-video-title {
    font-size: 15px;
    font-weight: 400;
    color: white;
    margin-bottom: 0;
    line-height: 1.4;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .nvgd-shop-button {
    position: absolute;
    bottom: 15px;
    left: 15px;
    right: 15px;
    padding: 14px;
    background-color: #fff;
    color: #000;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
    z-index: 11;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .nvgd-shop-button:hover {
    background-color: #F5F5F5;
  }

  /* Report Bottom Sheet (Step 1) */
  .nvgd-report-sheet {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 12px 12px 0 0;
    z-index: 14;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    display: block !important;
    padding: 12px 16px 20px 16px;
  }

  .nvgd-report-sheet.nvgd-active {
    transform: translateY(0);
  }

  .nvgd-report-sheet-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 28px;
    height: 28px;
    border: none;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #666;
    border-radius: 50%;
    transition: background-color 0.2s ease;
    padding: 0;
    z-index: 3;
  }

  .nvgd-report-sheet-close:hover {
    background-color: #F5F5F5;
  }

  .nvgd-report-sheet-option {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 0 0 0;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    color: #111111;
    transition: background-color 0.2s ease;
  }

  .nvgd-report-sheet-option:hover {
    opacity: 0.8;
  }

  .nvgd-report-sheet-option svg {
    width: 22px;
    height: 22px;
    fill: #111111;
    flex-shrink: 0;
  }

  /* Report Full Form (Step 2) */
  .nvgd-report-menu {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    top: 0;
    background: #fff;
    z-index: 15;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    display: flex !important;
    flex-direction: column;
    overflow: hidden;
  }

  .nvgd-report-menu.nvgd-active {
    transform: translateY(0);
  }

  .nvgd-report-menu-header {
    display: flex;
    align-items: center;
    padding: 14px 16px;
    flex-shrink: 0;
  }

  .nvgd-report-menu-close {
    width: 36px;
    height: 36px;
    border: none;
    background: #F5F5F5;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    color: #333;
    border-radius: 50%;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .nvgd-report-menu-close:hover {
    background-color: #ddd;
  }

  .nvgd-report-body {
    flex: 1;
    overflow-y: auto;
    padding: 0 16px;
  }

  .nvgd-report-title {
    font-size: 18px;
    font-weight: 700;
    color: #000;
    margin: 0 0 8px 0;
  }

  .nvgd-report-desc {
    font-size: 13px;
    color: #555;
    line-height: 1.5;
    margin: 0 0 20px 0;
  }

  .nvgd-report-options {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nvgd-report-label {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    cursor: pointer;
    font-size: 14px;
    font-weight: 400;
    color: #222;
  }

  .nvgd-report-label input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    border: 2px solid #999;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    cursor: pointer;
    margin: 0;
  }

  .nvgd-report-label input[type="radio"]:checked {
    border-color: #E5E5E5;
  }

  .nvgd-report-label input[type="radio"]:checked::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 10px;
    height: 10px;
    background: #111111;
    border-radius: 50%;
  }

  .nvgd-report-footer {
    padding: 16px;
    flex-shrink: 0;
  }

  .nvgd-report-submit {
    width: 100%;
    padding: 14px;
    background-color: #111111;
    color: #fff;
    border: none;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
    margin-bottom: 8px;
  }

  .nvgd-report-submit:hover {
    background-color: #111111;
  }

  .nvgd-report-submit:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  .nvgd-report-cancel {
    width: 100%;
    padding: 12px;
    background: none;
    border: none;
    font-size: 15px;
    font-weight: 600;
    color: #222;
    cursor: pointer;
  }

  .nvgd-report-cancel:hover {
    color: #000;
  }

  /* Success state */
  .nvgd-report-success {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    gap: 12px;
    flex: 1;
  }

  .nvgd-report-success.nvgd-active {
    display: flex;
  }

  .nvgd-report-success-icon {
    width: 48px;
    height: 48px;
    background: #F5F5F5;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }

  .nvgd-report-success-icon svg {
    width: 24px;
    height: 24px;
    fill: #111111;
  }

  .nvgd-report-success h3 {
    font-size: 18px;
    font-weight: 700;
    color: #000;
    margin: 0;
  }

  .nvgd-report-success p {
    font-size: 14px;
    color: #555;
    margin: 0;
    line-height: 1.5;
  }

  .nvgd-report-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 13;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .nvgd-report-overlay.nvgd-active {
    opacity: 1;
    visibility: visible;
  }

  /* Share Bottom Sheet */
  .nvgd-share-sheet {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 12px 12px 0 0;
    z-index: 14;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    padding: 0 20px 28px 20px;
    display: block !important;
  }

  .nvgd-share-sheet.nvgd-active {
    transform: translateY(0);
  }

  .nvgd-share-sheet-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0 16px 0;
  }

  .nvgd-share-sheet-title {
    font-size: 16px;
    font-weight: 700;
    color: #000;
    margin: 0;
  }

  .nvgd-share-sheet-close {
    width: 28px;
    height: 28px;
    border: none;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #666;
    border-radius: 50%;
    transition: background-color 0.2s ease;
    padding: 0;
  }

  .nvgd-share-sheet-close:hover {
    background-color: #F5F5F5;
  }

  .nvgd-share-options {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .nvgd-share-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 50%;
    border: 1.5px solid #ddd;
    background: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    padding: 0;
    flex-shrink: 0;
  }

  .nvgd-share-btn:hover {
    background-color: #F5F5F5;
    border-color: #bbb;
  }

  .nvgd-share-btn svg {
    width: 18px;
    height: 18px;
  }

  .nvgd-share-copy {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-radius: 50px;
    border: 1.5px solid #ddd;
    background: #fff;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: #222;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nvgd-share-copy:hover {
    background-color: #F5F5F5;
    border-color: #bbb;
  }

  .nvgd-share-copy svg {
    width: 16px;
    height: 16px;
  }

  .nvgd-share-copy.nvgd-copied {
    border-color: #E5E5E5;
    color: #111111;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .nvgd-popup-container {
      width: 95%;
      max-width: 95%;
      height: 80vh;
      max-height: 650px;
      border-radius: 12px;
      bottom: 10px;
      right: -100%;
      left: auto;
    }

    .nvgd-popup-container.nvgd-active {
      right: 2.5%;
    }

    .nvgd-popup-close,
    .nvgd-popup-menu,
    .nvgd-popup-share {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }

    .nvgd-nav-arrow-alt {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }

    .nvgd-sound-toggle {
      width: 40px;
      height: 40px;
      font-size: 18px;
    }

    .nvgd-video-info {
      padding: 15px 12px 65px 12px;
    }

    .nvgd-video-title {
      font-size: 14px;
    }

    .nvgd-shop-button {
      bottom: 12px;
      left: 12px;
      right: 12px;
      padding: 12px;
      font-size: 15px;
    }
  }

  @media (max-width: 480px) {
    .nvgd-popup-container {
      max-width: 95%;
    }
  }
{% endstylesheet %}

<!-- Icon templates for JS (rendered once, read by assets/video-carousel-popup.js) -->
<template id="nvgdIconVolumeHigh">{% render 'nvgd-icon', icon: 'volume-high', size: '20px' %}</template>
<template id="nvgdIconVolumeXmark">{% render 'nvgd-icon', icon: 'volume-xmark', size: '20px' %}</template>

<!-- Popup Overlay -->
<div class="nvgd-popup-overlay" id="nvgdPopupOverlay"></div>

<!-- Popup Container -->
<div class="nvgd-popup-container" id="nvgdPopupContainer" role="dialog" aria-modal="true" aria-label="Video player">
  <!-- Progress Bar -->
  <div class="nvgd-progress-bar">
    <div class="nvgd-progress-fill" id="nvgdProgressFill"></div>
  </div>

  <div class="nvgd-popup-header">
    <div class="nvgd-header-left">
      <button class="nvgd-popup-close" id="nvgdPopupClose" aria-label="Close">✕</button>
    </div>
    <div class="nvgd-header-right">
      <button class="nvgd-popup-menu" id="nvgdPopupMenu" aria-label="Menu">⋮</button>
      <button class="nvgd-popup-share" id="nvgdPopupShare" aria-label="Share">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12l-7-7v4C7 9 4 14 3 19c2.5-3.5 6-5 11-5v4l7-7z"/></svg>
      </button>
    </div>
  </div>
  
  <div class="nvgd-popup-content">
    <div class="nvgd-video-container">
      <video class="nvgd-video-player" 
             id="nvgdVideoPlayer" 
             loop 
             playsinline
             preload="metadata">
        Your browser does not support the video tag.
      </video>

      <!-- Navigation Arrows -->
      <div class="nvgd-nav-vertical">
        <button class="nvgd-nav-arrow-alt nvgd-prev" id="nvgdPrevBtn" aria-label="Previous video">
          {% render 'nvgd-icon', icon: 'chevron-up', size: '20px' %}
        </button>
        <button class="nvgd-nav-arrow-alt nvgd-next" id="nvgdNextBtn" aria-label="Next video">
          {% render 'nvgd-icon', icon: 'chevron-down', size: '20px' %}
        </button>
      </div>

      <!-- Sound Toggle -->
      <button class="nvgd-sound-toggle" id="nvgdSoundToggle" aria-label="Toggle sound">
        {% render 'nvgd-icon', icon: 'volume-high', size: '20px' %}
      </button>
      
      <!-- Video Info Overlay -->
      <div class="nvgd-video-info">
        <h2 class="nvgd-video-title" id="nvgdVideoTitle"></h2>
      </div>

      <!-- Shop Button -->
      <button class="nvgd-shop-button" id="nvgdShopBtn" style="display: none;"></button>

      <!-- Report Overlay -->
      <div class="nvgd-report-overlay" id="nvgdReportOverlay"></div>

      <!-- Step 1: Bottom Sheet -->
      <div class="nvgd-report-sheet" id="nvgdReportSheet">
        <button class="nvgd-report-sheet-close" id="nvgdReportSheetClose" aria-label="Close">✕</button>
        <button class="nvgd-report-sheet-option" id="nvgdReportSheetBtn">
          <svg viewBox="0 0 24 24"><path d="M14.4 6l-.24-1.2c-.09-.46-.5-.8-.98-.8H6c-.55 0-1 .45-1 1v15c0 .55.45 1 1 1s1-.45 1-1v-6h5.6l.24 1.2c.09.47.5.8.98.8H19c.55 0 1-.45 1-1V7c0-.55-.45-1-1-1h-4.6z"/></svg>
          Report
        </button>
      </div>

      <!-- Step 2: Full Report Form -->
      <div class="nvgd-report-menu" id="nvgdReportMenu" role="dialog" aria-modal="true" aria-label="Report video">
        <div class="nvgd-report-menu-header">
          <button class="nvgd-report-menu-close" id="nvgdReportMenuClose" aria-label="Close">✕</button>
        </div>

        <div class="nvgd-report-body" id="nvgdReportBody">
          <h3 class="nvgd-report-title">Report Video</h3>
          <p class="nvgd-report-desc">Your report is anonymous, except if you're reporting an intellectual property infringement. If someone is in immediate danger, call the local emergency services - don't wait.</p>

          <div class="nvgd-report-options">
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Sexual Content">
              Sexual Content
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Violent or repulsive content">
              Violent or repulsive content
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Harmful or abusive content">
              Harmful or abusive content
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Harassment or bullying">
              Harassment or bullying
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Harmful or dangerous content">
              Harmful or dangerous content
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Misinformation">
              Misinformation
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Child abuse">
              Child abuse
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Promotes terrorism">
              Promotes terrorism
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Spam or misleading">
              Spam or misleading
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Legal issue">
              Legal issue
            </label>
            <label class="nvgd-report-label">
              <input type="radio" name="nvgd-report-reason" value="Caption issue">
              Caption issue
            </label>
