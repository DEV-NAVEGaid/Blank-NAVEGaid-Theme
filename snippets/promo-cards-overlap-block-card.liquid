{% comment %}
  Renders a single promo card for the Promo Cards Overlap section.

  Resolves per-block typography presets, sets block-scoped custom properties,
  and renders configured slot columns; on mobile, slots 1 and 2 share a row and slot 3 follows.

  Accepts:
  - block: {Object} Section block containing card settings
  - section: {Object} Section object (used for section.settings.*)

  Usage:
  {% render 'promo-cards-overlap-block-card', block: block, section: section %}
{% endcomment %}

      {%- comment -%}
        =============================================
        TYPOGRAPHY RESOLUTION (per block)

        If global typography is ON → resolve presets to font properties + clamp values
        =============================================
      {%- endcomment -%}

      {% if section.settings.enable_global_typography %}

        {%- comment -%} ===== HEADING preset ===== {%- endcomment -%}
        {% case block.settings.heading_preset %}
          {% when 'h1' %}
            {% assign _hd_font_key = settings.type_font_h1 %}
            {% assign _hd_size = settings.type_size_h1 | times: 1 %}
            {% assign _hd_lh = settings.type_line_height_h1 %}
            {% assign _hd_ls = settings.type_letter_spacing_h1 %}
            {% assign _hd_case = settings.type_case_h1 %}
          {% when 'h2' %}
            {% assign _hd_font_key = settings.type_font_h2 %}
            {% assign _hd_size = settings.type_size_h2 | times: 1 %}
            {% assign _hd_lh = settings.type_line_height_h2 %}
            {% assign _hd_ls = settings.type_letter_spacing_h2 %}
            {% assign _hd_case = settings.type_case_h2 %}
          {% when 'h3' %}
            {% assign _hd_font_key = settings.type_font_h3 %}
            {% assign _hd_size = settings.type_size_h3 | times: 1 %}
            {% assign _hd_lh = settings.type_line_height_h3 %}
            {% assign _hd_ls = settings.type_letter_spacing_h3 %}
            {% assign _hd_case = settings.type_case_h3 %}
          {% when 'h4' %}
            {% assign _hd_font_key = settings.type_font_h4 %}
            {% assign _hd_size = settings.type_size_h4 | times: 1 %}
            {% assign _hd_lh = settings.type_line_height_h4 %}
            {% assign _hd_ls = settings.type_letter_spacing_h4 %}
            {% assign _hd_case = settings.type_case_h4 %}
          {% when 'h5' %}
            {% assign _hd_font_key = settings.type_font_h5 %}
            {% assign _hd_size = settings.type_size_h5 | times: 1 %}
            {% assign _hd_lh = settings.type_line_height_h5 %}
            {% assign _hd_ls = settings.type_letter_spacing_h5 %}
            {% assign _hd_case = settings.type_case_h5 %}
          {% when 'h6' %}
            {% assign _hd_font_key = settings.type_font_h6 %}
            {% assign _hd_size = settings.type_size_h6 | times: 1 %}
            {% assign _hd_lh = settings.type_line_height_h6 %}
            {% assign _hd_ls = settings.type_letter_spacing_h6 %}
            {% assign _hd_case = settings.type_case_h6 %}
        {% endcase %}

        {% case _hd_font_key %}
          {% when 'heading' %}
            {% assign _hd_family = settings.type_header_font.family %}
            {% assign _hd_fallback = settings.type_header_font.fallback_families %}
            {% assign _hd_weight = settings.type_header_font.weight %}
            {% assign _hd_style = settings.type_header_font.style %}
          {% when 'accent' %}
            {% assign _hd_family = settings.type_accent_font.family %}
            {% assign _hd_fallback = settings.type_accent_font.fallback_families %}
            {% assign _hd_weight = settings.type_accent_font.weight %}
            {% assign _hd_style = settings.type_accent_font.style %}
          {% when 'subheading' %}
            {% assign _hd_family = settings.type_subheading_font.family %}
            {% assign _hd_fallback = settings.type_subheading_font.fallback_families %}
            {% assign _hd_weight = settings.type_subheading_font.weight %}
            {% assign _hd_style = settings.type_subheading_font.style %}
          {% when 'body' %}
            {% assign _hd_family = settings.type_body_font.family %}
            {% assign _hd_fallback = settings.type_body_font.fallback_families %}
            {% assign _hd_weight = settings.type_body_font.weight %}
            {% assign _hd_style = settings.type_body_font.style %}
        {% endcase %}

        {% assign _hd_min = _hd_size | times: 0.45 | round %}
        {% assign _hd_preferred = _hd_size | times: 0.14 | round %}

        {% case _hd_lh %}
          {% when 'display-tight' %}{% assign _hd_lh_val = 1.05 %}
          {% when 'display-normal' %}{% assign _hd_lh_val = 1.2 %}
          {% when 'display-loose' %}{% assign _hd_lh_val = 1.4 %}
        {% endcase %}

        {% case _hd_ls %}
          {% when 'heading-tight' %}{% assign _hd_ls_val = '-0.02em' %}
          {% when 'heading-normal' %}{% assign _hd_ls_val = '0em' %}
          {% when 'heading-loose' %}{% assign _hd_ls_val = '0.04em' %}
        {% endcase %}

        {%- comment -%} ===== SUBHEADING preset ===== {%- endcomment -%}
        {% case block.settings.subheading_preset %}
          {% when 'h4' %}
            {% assign _sh_font_key = settings.type_font_h4 %}
            {% assign _sh_size = settings.type_size_h4 | times: 1 %}
            {% assign _sh_lh = settings.type_line_height_h4 %}
            {% assign _sh_case = settings.type_case_h4 %}
          {% when 'h5' %}
            {% assign _sh_font_key = settings.type_font_h5 %}
            {% assign _sh_size = settings.type_size_h5 | times: 1 %}
            {% assign _sh_lh = settings.type_line_height_h5 %}
            {% assign _sh_case = settings.type_case_h5 %}
          {% when 'h6' %}
            {% assign _sh_font_key = settings.type_font_h6 %}
            {% assign _sh_size = settings.type_size_h6 | times: 1 %}
            {% assign _sh_lh = settings.type_line_height_h6 %}
            {% assign _sh_case = settings.type_case_h6 %}
          {% when 'paragraph' %}
            {% assign _sh_font_key = 'body' %}
            {% assign _sh_size = settings.type_size_paragraph | times: 1 %}
            {% assign _sh_lh = settings.type_line_height_paragraph %}
            {% assign _sh_case = 'none' %}
        {% endcase %}

        {% case _sh_font_key %}
          {% when 'heading' %}
            {% assign _sh_family = settings.type_header_font.family %}
            {% assign _sh_fallback = settings.type_header_font.fallback_families %}
            {% assign _sh_weight = settings.type_header_font.weight %}
            {% assign _sh_style = settings.type_header_font.style %}
          {% when 'accent' %}
            {% assign _sh_family = settings.type_accent_font.family %}
            {% assign _sh_fallback = settings.type_accent_font.fallback_families %}
            {% assign _sh_weight = settings.type_accent_font.weight %}
            {% assign _sh_style = settings.type_accent_font.style %}
          {% when 'subheading' %}
            {% assign _sh_family = settings.type_subheading_font.family %}
            {% assign _sh_fallback = settings.type_subheading_font.fallback_families %}
            {% assign _sh_weight = settings.type_subheading_font.weight %}
            {% assign _sh_style = settings.type_subheading_font.style %}
          {% when 'body' %}
            {% assign _sh_family = settings.type_body_font.family %}
            {% assign _sh_fallback = settings.type_body_font.fallback_families %}
            {% assign _sh_weight = settings.type_body_font.weight %}
            {% assign _sh_style = settings.type_body_font.style %}
        {% endcase %}

        {% assign _sh_min = _sh_size | times: 0.7 | round %}
        {% assign _sh_preferred = _sh_size | times: 0.3 | round %}

        {% case _sh_lh %}
          {% when 'display-tight' %}{% assign _sh_lh_val = 1.05 %}
          {% when 'display-normal' %}{% assign _sh_lh_val = 1.2 %}
          {% when 'display-loose' %}{% assign _sh_lh_val = 1.4 %}
          {% when 'body-tight' %}{% assign _sh_lh_val = 1.3 %}
          {% when 'body-normal' %}{% assign _sh_lh_val = 1.5 %}
          {% when 'body-loose' %}{% assign _sh_lh_val = 1.7 %}
        {% endcase %}

        {%- comment -%} ===== BODY TEXT preset ===== {%- endcomment -%}
        {% case block.settings.body_preset %}
          {% when 'h5' %}
            {% assign _bt_font_key = settings.type_font_h5 %}
            {% assign _bt_size = settings.type_size_h5 | times: 1 %}
            {% assign _bt_lh = settings.type_line_height_h5 %}
            {% assign _bt_case = settings.type_case_h5 %}
          {% when 'h6' %}
            {% assign _bt_font_key = settings.type_font_h6 %}
            {% assign _bt_size = settings.type_size_h6 | times: 1 %}
            {% assign _bt_lh = settings.type_line_height_h6 %}
            {% assign _bt_case = settings.type_case_h6 %}
          {% when 'paragraph' %}
            {% assign _bt_font_key = 'body' %}
            {% assign _bt_size = settings.type_size_paragraph | times: 1 %}
            {% assign _bt_lh = settings.type_line_height_paragraph %}
            {% assign _bt_case = 'none' %}
        {% endcase %}

        {% case _bt_font_key %}
          {% when 'heading' %}
            {% assign _bt_family = settings.type_header_font.family %}
            {% assign _bt_fallback = settings.type_header_font.fallback_families %}
            {% assign _bt_weight = settings.type_header_font.weight %}
            {% assign _bt_style = settings.type_header_font.style %}
          {% when 'accent' %}
            {% assign _bt_family = settings.type_accent_font.family %}
            {% assign _bt_fallback = settings.type_accent_font.fallback_families %}
            {% assign _bt_weight = settings.type_accent_font.weight %}
            {% assign _bt_style = settings.type_accent_font.style %}
          {% when 'subheading' %}
            {% assign _bt_family = settings.type_subheading_font.family %}
            {% assign _bt_fallback = settings.type_subheading_font.fallback_families %}
            {% assign _bt_weight = settings.type_subheading_font.weight %}
            {% assign _bt_style = settings.type_subheading_font.style %}
          {% when 'body' %}
            {% assign _bt_family = settings.type_body_font.family %}
            {% assign _bt_fallback = settings.type_body_font.fallback_families %}
            {% assign _bt_weight = settings.type_body_font.weight %}
            {% assign _bt_style = settings.type_body_font.style %}
        {% endcase %}

        {% assign _bt_min = _bt_size | times: 0.7 | round %}
        {% assign _bt_preferred = _bt_size | times: 0.3 | round %}

        {% case _bt_lh %}
          {% when 'display-tight' %}{% assign _bt_lh_val = 1.05 %}
          {% when 'display-normal' %}{% assign _bt_lh_val = 1.2 %}
          {% when 'display-loose' %}{% assign _bt_lh_val = 1.4 %}
          {% when 'body-tight' %}{% assign _bt_lh_val = 1.3 %}
          {% when 'body-normal' %}{% assign _bt_lh_val = 1.5 %}
          {% when 'body-loose' %}{% assign _bt_lh_val = 1.7 %}
        {% endcase %}

        {%- comment -%} ===== BUTTON preset ===== {%- endcomment -%}
        {% case block.settings.button_preset %}
          {% when 'h5' %}
            {% assign _btn_font_key = settings.type_font_h5 %}
            {% assign _btn_size = settings.type_size_h5 | times: 1 %}
            {% assign _btn_case = settings.type_case_h5 %}
          {% when 'h6' %}
            {% assign _btn_font_key = settings.type_font_h6 %}
            {% assign _btn_size = settings.type_size_h6 | times: 1 %}
            {% assign _btn_case = settings.type_case_h6 %}
          {% when 'paragraph' %}
            {% assign _btn_font_key = 'body' %}
            {% assign _btn_size = settings.type_size_paragraph | times: 1 %}
            {% assign _btn_case = 'none' %}
        {% endcase %}

        {% case _btn_font_key %}
          {% when 'heading' %}
            {% assign _btn_family = settings.type_header_font.family %}
            {% assign _btn_fallback = settings.type_header_font.fallback_families %}
            {% assign _btn_weight = settings.type_header_font.weight %}
            {% assign _btn_style = settings.type_header_font.style %}
          {% when 'accent' %}
            {% assign _btn_family = settings.type_accent_font.family %}
            {% assign _btn_fallback = settings.type_accent_font.fallback_families %}
            {% assign _btn_weight = settings.type_accent_font.weight %}
            {% assign _btn_style = settings.type_accent_font.style %}
          {% when 'subheading' %}
            {% assign _btn_family = settings.type_subheading_font.family %}
            {% assign _btn_fallback = settings.type_subheading_font.fallback_families %}
            {% assign _btn_weight = settings.type_subheading_font.weight %}
            {% assign _btn_style = settings.type_subheading_font.style %}
          {% when 'body' %}
            {% assign _btn_family = settings.type_body_font.family %}
            {% assign _btn_fallback = settings.type_body_font.fallback_families %}
            {% assign _btn_weight = settings.type_body_font.weight %}
            {% assign _btn_style = settings.type_body_font.style %}
        {% endcase %}

        {% assign _btn_min = _btn_size | times: 0.8 | round %}
        {% assign _btn_preferred = _btn_size | times: 0.4 | round %}

      {% endif %}

      {%- capture pc_cols -%}{% if block.settings.s1_type != 'none' %}{{ block.settings.s1_width }}fr {% endif %}{% if block.settings.s2_type != 'none' %}{{ block.settings.s2_width }}fr {% endif %}{% if block.settings.s3_type != 'none' %}{{ block.settings.s3_width }}fr {% endif %}{%- endcapture -%}

      {%- comment -%}
        Block-scoped custom properties (referenced by the bundled stylesheet below).
      {%- endcomment -%}
      {%- capture pc_style -%}
--pc-bg: {{ block.settings.bg_color }};
--pc-radius: {{ block.settings.border_radius }}px;
--pad-x: {{ block.settings.padding_x }}px;
--pad-y: {{ block.settings.padding_y }}px;
--pad-x-m: {{ block.settings.padding_x_mobile }}px;
--pad-y-m: {{ block.settings.padding_y_mobile }}px;
--pc-mb: {{ block.settings.margin_bottom }}px;
--pc-ovf: {% if block.settings.s1_popout or block.settings.s2_popout or block.settings.s3_popout %}visible{% else %}hidden{% endif %};
--pc-minh-d: {{ section.settings.min_height_desktop }}px;
--pc-minh-m: {{ section.settings.min_height_mobile }}px;
--pc-w: {% if block.settings.use_custom_card_width %}{{ block.settings.custom_card_width }}{% else %}{{ block.settings.card_width }}{% endif %}%;
--pc-w-m: {% if block.settings.use_custom_card_width_mobile %}{{ block.settings.custom_card_width_mobile }}{% else %}{{ block.settings.card_width_mobile }}{% endif %}%;
--pc-ml: {% if block.settings.card_alignment == 'start' %}0{% else %}auto{% endif %};
--pc-mr: {% if block.settings.card_alignment == 'end' %}0{% else %}auto{% endif %};
--pc-ml-m: {% if block.settings.card_alignment_mobile == 'start' %}0{% else %}auto{% endif %};
--pc-mr-m: {% if block.settings.card_alignment_mobile == 'end' %}0{% else %}auto{% endif %};
{%- if block.settings.bg_image != blank -%}
--pc-bg-image: url('{{ block.settings.bg_image | image_url: width: 1600 }}');
--pc-bg-size: cover;
--pc-bg-rep: no-repeat;
--pc-bg-pos: {% if block.settings.bg_position_custom %}{{ block.settings.bg_position_x }}% {{ block.settings.bg_position_y }}%{% else %}{{ block.settings.bg_position }}{% endif %};
{%- endif -%}
{%- if block.settings.bg_image_mobile != blank -%}
--pc-bg-image-m: url('{{ block.settings.bg_image_mobile | image_url: width: 1600 }}');
{%- endif -%}
{%- if section.settings.fixed_height_desktop > 0 -%}
--pc-fixed-h: {{ section.settings.fixed_height_desktop }}px;
{%- endif -%}
{%- if section.settings.fixed_height_mobile > 0 -%}
--pc-fixed-h-m: {{ section.settings.fixed_height_mobile }}px;
{%- endif -%}
--pc-cols: {{ pc_cols }};
--pc-gap: {{ block.settings.gap }}px;
--pc-gap-m: {{ block.settings.gap_mobile }}px;
--pc-align: {{ block.settings.vertical_alignment }};
--pc-media-radius: {{ block.settings.media_radius }}px;
--pc-s3-col: {% if block.settings.s2_type == 'text' or block.settings.s2_type == 'media' %}1 / -1{% else %}auto{% endif %};
--pc-mw-m: {{ block.settings.media_width_mobile }}%;
--pc-btn-c: {{ block.settings.button_text_color }};
--pc-btn-bg: {{ block.settings.button_bg_color }};
--pc-btn-pad: {{ block.settings.button_padding_y }}px {{ block.settings.button_padding_x }}px;
--pc-btn-radius: {{ block.settings.button_radius }}px;
--pc-btn-border: {% if block.settings.button_border %}1px solid {{ block.settings.button_border_color }}{% else %}none{% endif %};
--pc-btn-mt: {{ block.settings.button_margin_top }}px;
--pc-btn-hover-bg: {{ block.settings.button_hover_bg_color }};
--pc-btn-hover-c: {{ block.settings.button_hover_text_color }};
--pc-btn-pad-m: {{ block.settings.button_padding_y_mobile }}px {{ block.settings.button_padding_x_mobile }}px;
{%- for i in (1..3) -%}
{%- capture ta_key -%}s{{ i }}_text_align{%- endcapture -%}
{%- capture jf_key -%}s{{ i }}_position_horizontal{%- endcapture -%}
{%- capture cv_key -%}s{{ i }}_content_vertical{%- endcapture -%}
{%- capture pv_key -%}s{{ i }}_position_vertical{%- endcapture -%}
{%- capture ch_key -%}s{{ i }}_content_horizontal{%- endcapture -%}
{%- capture py_key -%}s{{ i }}_padding_y{%- endcapture -%}
{%- capture px_key -%}s{{ i }}_padding_x{%- endcapture -%}
{%- capture pop_key -%}s{{ i }}_popout{%- endcapture -%}
{%- capture mw_key -%}s{{ i }}_max_width{%- endcapture -%}
{%- capture tam_key -%}s{{ i }}_text_align_mobile{%- endcapture -%}
{%- capture cvm_key -%}s{{ i }}_content_vertical_mobile{%- endcapture -%}
{%- capture chm_key -%}s{{ i }}_content_horizontal_mobile{%- endcapture -%}
{%- capture ord_key -%}s{{ i }}_order_mobile{%- endcapture -%}
{%- capture head_c_key -%}s{{ i }}_heading_color{%- endcapture -%}
{%- capture head_mg_key -%}s{{ i }}_heading_margin{%- endcapture -%}
{%- capture sub_c_key -%}s{{ i }}_sub_color{%- endcapture -%}
{%- capture sub_mg_key -%}s{{ i }}_sub_margin{%- endcapture -%}
{%- capture text_c_key -%}s{{ i }}_text_color{%- endcapture -%}
{%- capture text_mg_key -%}s{{ i }}_text_margin{%- endcapture -%}
--pc-s{{ i }}-ta: {{ block.settings[ta_key] }};
--pc-s{{ i }}-jf: {{ block.settings[jf_key] }};
--pc-s{{ i }}-as: {% if block.settings[cv_key] != 'flex-start' %}stretch{% else %}{{ block.settings[pv_key] }}{% endif %};
--pc-s{{ i }}-jc: {{ block.settings[cv_key] }};
--pc-s{{ i }}-ai: {{ block.settings[ch_key] }};
--pc-s{{ i }}-pad: {{ block.settings[py_key] }}px {{ block.settings[px_key] }}px;
--pc-s{{ i }}-ta-m: {{ block.settings[tam_key] }};
--pc-s{{ i }}-jc-m: {{ block.settings[cvm_key] }};
--pc-s{{ i }}-ai-m: {{ block.settings[chm_key] }};
--pc-s{{ i }}-ord: {{ block.settings[ord_key] }};
--pc-s{{ i }}-head-c: {{ block.settings[head_c_key] }};
--pc-s{{ i }}-head-mg: {{ block.settings[head_mg_key] }}px;
--pc-s{{ i }}-sub-c: {{ block.settings[sub_c_key] }};
--pc-s{{ i }}-sub-mg: {{ block.settings[sub_mg_key] }}px;
--pc-s{{ i }}-text-c: {{ block.settings[text_c_key] }};
--pc-s{{ i }}-text-mg: {{ block.settings[text_mg_key] }}px;
{%- if block.settings[pop_key] -%}
--pc-s{{ i }}-ovf: visible;
--pc-s{{ i }}-z: 10;
--pc-s{{ i }}-popw: {{ block.settings[mw_key] }}px;
{%- endif -%}
{%- unless section.settings.enable_global_typography -%}
{%- capture head_font_key -%}s{{ i }}_heading_font{%- endcapture -%}
{%- capture head_fw_key -%}s{{ i }}_heading_weight{%- endcapture -%}
{%- capture head_size_key -%}s{{ i }}_heading_size{%- endcapture -%}
{%- capture head_lh_key -%}s{{ i }}_heading_line_height{%- endcapture -%}
{%- capture head_sm_key -%}s{{ i }}_heading_size_mobile{%- endcapture -%}
{%- capture sub_font_key -%}s{{ i }}_sub_font{%- endcapture -%}
{%- capture sub_size_key -%}s{{ i }}_sub_size{%- endcapture -%}
{%- capture sub_sm_key -%}s{{ i }}_sub_size_mobile{%- endcapture -%}
{%- capture text_font_key -%}s{{ i }}_text_font{%- endcapture -%}
{%- capture text_size_key -%}s{{ i }}_text_size{%- endcapture -%}
{%- capture text_lh_key -%}s{{ i }}_text_line_height{%- endcapture -%}
{%- capture text_sm_key -%}s{{ i }}_text_size_mobile{%- endcapture -%}
--pc-s{{ i }}-head: {{ block.settings[head_size_key] }}px;
--pc-s{{ i }}-head-ff: {{ block.settings[head_font_key].family }}, {{ block.settings[head_font_key].fallback_families }};
--pc-s{{ i }}-head-fw: {{ block.settings[head_fw_key] }};
--pc-s{{ i }}-head-lh: {{ block.settings[head_lh_key] }};
--pc-s{{ i }}-head-m: {{ block.settings[head_sm_key] }}px;
--pc-s{{ i }}-sub: {{ block.settings[sub_size_key] }}px;
--pc-s{{ i }}-sub-ff: {{ block.settings[sub_font_key].family }}, {{ block.settings[sub_font_key].fallback_families }};
--pc-s{{ i }}-sub-m: {{ block.settings[sub_sm_key] }}px;
--pc-s{{ i }}-text: {{ block.settings[text_size_key] }}px;
--pc-s{{ i }}-text-ff: {{ block.settings[text_font_key].family }}, {{ block.settings[text_font_key].fallback_families }};
--pc-s{{ i }}-text-lh: {{ block.settings[text_lh_key] }};
--pc-s{{ i }}-text-m: {{ block.settings[text_sm_key] }}px;
--pc-btn: {{ block.settings.button_size }}px;
--pc-btn-fw: {{ block.settings.button_weight }};
--pc-btn-m: {{ block.settings.button_size_mobile }}px;
{%- endunless -%}
{%- endfor -%}
{%- if section.settings.enable_global_typography -%}
--pc-hd-ff: {{ _hd_family }}, {{ _hd_fallback }};
--pc-hd-fw: {{ _hd_weight }};
--pc-hd-fs: {{ _hd_style }};
--pc-hd-lh: {{ _hd_lh_val }};
--pc-hd-ls: {{ _hd_ls_val }};
--pc-hd-tt: {{ _hd_case }};
--pc-hd-size: clamp({{ _hd_min }}px, {{ _hd_preferred }}px + 3vw, {{ _hd_size }}px);
--pc-sh-ff: {{ _sh_family }}, {{ _sh_fallback }};
--pc-sh-fw: {{ _sh_weight }};
--pc-sh-fs: {{ _sh_style }};
--pc-sh-lh: {{ _sh_lh_val }};
--pc-sh-tt: {{ _sh_case }};
--pc-sh-size: clamp({{ _sh_min }}px, {{ _sh_preferred }}px + 1vw, {{ _sh_size }}px);
--pc-bt-ff: {{ _bt_family }}, {{ _bt_fallback }};
--pc-bt-fw: {{ _bt_weight }};
--pc-bt-fs: {{ _bt_style }};
--pc-bt-lh: {{ _bt_lh_val }};
--pc-bt-tt: {{ _bt_case }};
--pc-bt-size: clamp({{ _bt_min }}px, {{ _bt_preferred }}px + 0.5vw, {{ _bt_size }}px);
--pc-btn-ff: {{ _btn_family }}, {{ _btn_fallback }};
--pc-btn-fw: {{ _btn_weight }};
--pc-btn-fs: {{ _btn_style }};
--pc-btn-tt: {{ _btn_case }};
--pc-btn-size: clamp({{ _btn_min }}px, {{ _btn_preferred }}px + 0.5vw, {{ _btn_size }}px);
{%- endif -%}
{%- endcapture -%}

      <div class="promo-card {% if section.settings.enable_global_typography %}pc-gtypo{% else %}pc-ctypo{% endif %}" style="{{ pc_style | escape }}" {{ block.shopify_attributes }}>
        <div class="promo-card__inner">

          <!-- Wrapper for Slots 1 & 2 (row on mobile) -->
          <div class="pc-slots-row">
