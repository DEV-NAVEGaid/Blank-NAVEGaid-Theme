      {% stylesheet %}
        /* moved from inline style block for bundling */
        .promo-card {
          position: relative;
          box-sizing: border-box;
          background-color: var(--pc-bg);
          border-radius: var(--pc-radius);
          padding: var(--pad-y) var(--pad-x);
          margin-bottom: var(--pc-mb);
          overflow: var(--pc-ovf);
          height: auto;
          min-height: var(--pc-minh-d);
          width: var(--pc-w);
          margin-left: var(--pc-ml);
          margin-right: var(--pc-mr);
          background-image: var(--pc-bg-image, none);
          background-size: var(--pc-bg-size, auto);
          background-repeat: var(--pc-bg-rep, repeat);
          background-position: var(--pc-bg-pos, 0% 0%);
        }

        @media screen and (max-width: 750px) {
          .promo-card {
            background-image: var(--pc-bg-image-m, var(--pc-bg-image, none));
          }
        }

        @media screen and (min-width: 750px) {
          .promo-card {
            height: var(--pc-fixed-h, auto);
          }
        }

        /* --- CSS GRID ENGINE --- */
        .promo-card__inner {
          position: relative;
          width: 100%;
          height: 100%;
          min-height: max(0px, calc(var(--pc-minh-d) - (var(--pad-y) * 2)));
          z-index: 2;
          display: grid;
          grid-template-columns: var(--pc-cols);
          gap: var(--pc-gap);
          align-items: var(--pc-align);
        }

        .pc-slot {
          position: relative;
          z-index: 2;
          min-width: 0;
          width: 100%;
          min-height: 100%;
        }

        /* --- COLUMN POSITIONING --- */
        .slot-1 {
          text-align: var(--pc-s1-ta);
          justify-self: var(--pc-s1-jf);
          /* ponytail: a slot that hugs its content has no free space, so
             justify-content below is a no-op. Stretch it whenever the
             merchant has asked for content to sit anywhere but the top. */
          align-self: var(--pc-s1-as);
          display: flex;
          flex-direction: column;
          justify-content: var(--pc-s1-jc);
          align-items: var(--pc-s1-ai);
          padding: var(--pc-s1-pad);
          overflow: var(--pc-s1-ovf, visible) !important;
          z-index: var(--pc-s1-z, 2) !important;
        }
        .slot-2 {
          text-align: var(--pc-s2-ta);
          justify-self: var(--pc-s2-jf);
          align-self: var(--pc-s2-as);
          display: flex;
          flex-direction: column;
          justify-content: var(--pc-s2-jc);
          align-items: var(--pc-s2-ai);
          padding: var(--pc-s2-pad);
          overflow: var(--pc-s2-ovf, visible) !important;
          z-index: var(--pc-s2-z, 2) !important;
        }
        .slot-3 {
          text-align: var(--pc-s3-ta);
          justify-self: var(--pc-s3-jf);
          align-self: var(--pc-s3-as);
          display: flex;
          flex-direction: column;
          justify-content: var(--pc-s3-jc);
          align-items: var(--pc-s3-ai);
          padding: var(--pc-s3-pad);
          overflow: var(--pc-s3-ovf, visible) !important;
          z-index: var(--pc-s3-z, 2) !important;
        }
        .slot-3 {
          grid-column: var(--pc-s3-col);
        }

        /* --- Media Handling --- */
        .pc-stretch-vertical {
          margin-top: calc(var(--pad-y) * -1);
          margin-bottom: calc(var(--pad-y) * -1);
          height: calc(100% + (var(--pad-y) * 2));
          display: flex;
          flex-direction: column;
          justify-content: center;
        }
        .pc-stretch-vertical .pc-media-wrapper {
          height: 100%;
        }
        .pc-stretch-vertical img, .pc-stretch-vertical video {
          height: 100%;
          width: auto;
          object-fit: contain;
          max-width: 100%;
        }

        .pc-stretch-full {
          margin-top: calc(var(--pad-y) * -1);
          margin-bottom: calc(var(--pad-y) * -1);
          height: calc(100% + (var(--pad-y) * 2));
        }

        .slot-1.pc-stretch-full { margin-left: calc(var(--pad-x) * -1); width: calc(100% + var(--pad-x)); }
        .slot-3.pc-stretch-full { margin-right: calc(var(--pad-x) * -1); width: calc(100% + var(--pad-x)); }

        .pc-stretch-full .pc-media-wrapper { width: 100%; height: 100%; }
        .pc-stretch-full img, .pc-stretch-full video { width: 100%; height: 100%; object-fit: cover; border-radius: 0; }

        .pc-media-wrapper {
          width: 100%;
          height: auto;
          position: relative;
          display: block;
          line-height: 0;
          max-width: 100%;
          min-width: 0;
          overflow: hidden;
        }
        .pc-media-wrapper img, .pc-media-wrapper video {
          width: 100%;
          height: auto;
          max-width: 100%;
          object-fit: contain;
          display: block;
          border-radius: var(--pc-media-radius);
        }

        .pc-slot.pc-stretch-vertical .pc-media-wrapper,
        .pc-slot.pc-stretch-full .pc-media-wrapper {
          height: 100%;
        }

        .pc-slot.pc-stretch-vertical .pc-media-wrapper img,
        .pc-slot.pc-stretch-vertical .pc-media-wrapper video {
          width: 100%;
          height: 100%;
          object-fit: contain;
        }

        .pc-slot.pc-stretch-full .pc-media-wrapper img,
        .pc-slot.pc-stretch-full .pc-media-wrapper video {
          width: 100%;
          height: 100%;
          object-fit: cover;
          border-radius: 0;
        }

        /* Mobile Row Wrapper for Slots 1 & 2 */
        .pc-slots-row {
          display: contents;
        }

        @media screen and (max-width: 749px) {
          .pc-slots-row {
            display: flex;
            flex-direction: row;
            gap: var(--pc-gap-m);
            width: 100%;
            align-items: stretch;
          }

          .pc-slots-row .pc-slot {
            flex: 1;
            min-width: 0;
          }
        }

        /* Pop-out overrides */
        .slot-1 .pc-media-wrapper { width: min(100%, var(--pc-s1-popw, 100%)); max-width: 100%; }
        .slot-1 .pc-media-wrapper img { width: 100%; max-width: 100%; }
        .slot-2 .pc-media-wrapper { width: min(100%, var(--pc-s2-popw, 100%)); max-width: 100%; }
        .slot-2 .pc-media-wrapper img { width: 100%; max-width: 100%; }
        .slot-3 .pc-media-wrapper { width: min(100%, var(--pc-s3-popw, 100%)); max-width: 100%; }
        .slot-3 .pc-media-wrapper img { width: 100%; max-width: 100%; }

