        .promo-card.pc-ctypo .s3-subheading {
          font-family: var(--pc-s3-sub-ff);
          font-size: var(--pc-s3-sub);
          line-height: 1.3;
          color: var(--pc-s3-sub-c);
          margin: 0 0 var(--pc-s3-sub-mg) 0;
          word-wrap: break-word;
        }
        .promo-card.pc-gtypo .s3-text {
          font-family: var(--pc-bt-ff);
          font-weight: var(--pc-bt-fw);
          font-style: var(--pc-bt-fs);
          font-size: var(--pc-bt-size);
          line-height: var(--pc-bt-lh);
          text-transform: var(--pc-bt-tt);
          color: var(--pc-s3-text-c);
          margin: 0 0 var(--pc-s3-text-mg) 0;
          word-wrap: break-word;
        }
        .promo-card.pc-ctypo .s3-text {
          font-family: var(--pc-s3-text-ff);
          font-size: var(--pc-s3-text);
          line-height: var(--pc-s3-text-lh);
          color: var(--pc-s3-text-c);
          margin: 0 0 var(--pc-s3-text-mg) 0;
          word-wrap: break-word;
        }

        .inline-logo {
          width: auto;
          vertical-align: middle;
          display: inline-block;
        }

        /* ===== BUTTON ===== */
        .promo-card.pc-gtypo .pc-button {
          display: inline-block;
          font-family: var(--pc-btn-ff);
          font-weight: var(--pc-btn-fw);
          font-style: var(--pc-btn-fs);
          font-size: var(--pc-btn-size);
          text-transform: var(--pc-btn-tt);
          color: var(--pc-btn-c);
          background-color: var(--pc-btn-bg);
          padding: var(--pc-btn-pad);
          border-radius: var(--pc-btn-radius);
          text-decoration: none;
          transition: all 0.3s ease;
          border: var(--pc-btn-border);
          margin-top: var(--pc-btn-mt);
          white-space: nowrap;
          cursor: pointer;
          line-height: 1.2;
        }
        .promo-card.pc-ctypo .pc-button {
          display: inline-block;
          font-size: var(--pc-btn);
          font-weight: var(--pc-btn-fw);
          color: var(--pc-btn-c);
          background-color: var(--pc-btn-bg);
          padding: var(--pc-btn-pad);
          border-radius: var(--pc-btn-radius);
          text-decoration: none;
          transition: all 0.3s ease;
          border: var(--pc-btn-border);
          margin-top: var(--pc-btn-mt);
          white-space: nowrap;
          cursor: pointer;
          line-height: 1.2;
        }

        .pc-button:hover {
          background-color: var(--pc-btn-hover-bg);
          color: var(--pc-btn-hover-c);
          border-color: var(--pc-btn-hover-bg);
        }

        @media screen and (max-width: 749px) {
          .promo-card {
            --pad-x: var(--pad-x-m);
            --pad-y: var(--pad-y-m);
            padding: var(--pad-y-m) var(--pad-x-m);
            width: var(--pc-w-m) !important;
            margin-left: var(--pc-ml-m);
            margin-right: var(--pc-mr-m);
            height: auto;
            min-height: var(--pc-minh-m);
          }

          .promo-card {
            height: var(--pc-fixed-h-m, auto) !important;
          }

          .promo-card__inner {
            display: flex;
            flex-direction: column;
            gap: var(--pc-gap-m);
            min-height: max(0px, calc(var(--pc-minh-m) - (var(--pad-y) * 2)));
          }

          .slot-1,
          .slot-2,
          .slot-3 {
            width: 100%;
            margin: 0;
            min-height: 0;
          }
          /* Reset desktop stretch classes on mobile — let mobile-specific ones take over */
          .slot-1.pc-stretch-full,
          .slot-2.pc-stretch-full,
          .slot-3.pc-stretch-full {
            margin-left: 0 !important;
            margin-right: 0 !important;
            margin-top: 0 !important;
            margin-bottom: 0 !important;
            width: 100% !important;
          }

          /* Mobile stretch: bleed to edges */
          .slot-1.pc-stretch-full-m,
          .slot-2.pc-stretch-full-m,
          .slot-3.pc-stretch-full-m {
            margin-left: calc(var(--pad-x) * -1) !important;
            margin-right: calc(var(--pad-x) * -1) !important;
            width: calc(100% + (var(--pad-x) * 2)) !important;
            max-width: none !important;
          }
          .slot-1.pc-stretch-full-m { margin-top: calc(var(--pad-y) * -1) !important; }
          .slot-3.pc-stretch-full-m { margin-bottom: calc(var(--pad-y) * -1) !important; }

          /* Mobile stretch: vertical only */
          .slot-1.pc-stretch-vertical-m,
          .slot-2.pc-stretch-vertical-m,
          .slot-3.pc-stretch-vertical-m {
            height: auto;
          }

          /* Media wrapper for mobile stretch-full */
          .slot-1.pc-stretch-full-m .pc-media-wrapper,
          .slot-2.pc-stretch-full-m .pc-media-wrapper,
          .slot-3.pc-stretch-full-m .pc-media-wrapper {
            width: 100% !important;
          }
          .slot-1.pc-stretch-full-m .pc-media-wrapper img,
          .slot-2.pc-stretch-full-m .pc-media-wrapper img,
          .slot-3.pc-stretch-full-m .pc-media-wrapper img,
          .slot-1.pc-stretch-full-m .pc-media-wrapper video,
          .slot-2.pc-stretch-full-m .pc-media-wrapper video,
          .slot-3.pc-stretch-full-m .pc-media-wrapper video {
            width: 100%;
            object-fit: cover;
            border-radius: 0;
          }

          .slot-1 {
            text-align: var(--pc-s1-ta-m);
            justify-content: var(--pc-s1-jc-m);
            align-items: var(--pc-s1-ai-m);
          }

          .slot-2 {
            text-align: var(--pc-s2-ta-m);
            justify-content: var(--pc-s2-jc-m);
            align-items: var(--pc-s2-ai-m);
          }

          .slot-3 {
            text-align: var(--pc-s3-ta-m);
            justify-content: var(--pc-s3-jc-m);
            align-items: var(--pc-s3-ai-m);
          }

          .slot-1 { order: var(--pc-s1-ord); }
          .slot-2 { order: var(--pc-s2-ord); }
          .slot-3 { order: var(--pc-s3-ord); }

          .slot-1 .pc-media-wrapper,
          .slot-2 .pc-media-wrapper,
          .slot-3 .pc-media-wrapper {
            width: var(--pc-mw-m) !important;
            max-width: 100% !important;
            margin: 0;
          }

          /* Reset stretch wrapper width on mobile so it doesn't stay bounded */
          .slot-1.pc-stretch-full .pc-media-wrapper,
          .slot-2.pc-stretch-full .pc-media-wrapper,
          .slot-3.pc-stretch-full .pc-media-wrapper {
            width: 100% !important;
          }

          /* Custom mode: block-level mobile overrides */
          .promo-card.pc-ctypo .s1-heading { font-size: var(--pc-s1-head-m); }
          .promo-card.pc-ctypo .s1-subheading { font-size: var(--pc-s1-sub-m); }
          .promo-card.pc-ctypo .s1-text { font-size: var(--pc-s1-text-m); }

          .promo-card.pc-ctypo .s2-heading { font-size: var(--pc-s2-head-m); }
          .promo-card.pc-ctypo .s2-subheading { font-size: var(--pc-s2-sub-m); }
          .promo-card.pc-ctypo .s2-text { font-size: var(--pc-s2-text-m); }

          .promo-card.pc-ctypo .s3-heading { font-size: var(--pc-s3-head-m); }
          .promo-card.pc-ctypo .s3-subheading { font-size: var(--pc-s3-sub-m); }
          .promo-card.pc-ctypo .s3-text { font-size: var(--pc-s3-text-m); }

          .promo-card.pc-ctypo .pc-button {
            font-size: var(--pc-btn-m);
          }

          .pc-button {
            padding: var(--pc-btn-pad-m);
            width: 100%;
            text-align: center;
          }
        }
      {% endstylesheet %}
