{%- comment -%}
  Renders an inline SVG icon (self-hosted replacement for Font Awesome).
  Usage: {% render 'nvgd-icon', icon: 'chevron-up' %}
         {% render 'nvgd-icon', icon: 'cart-shopping', size: '28px' %}
  Params:
    icon (string, required) — one of the names in the case below.
    size (string, optional) — width/height, defaults to 1em (inherits font-size).
  Color follows `currentColor`, so set `color` on the parent like Font Awesome did.
{%- endcomment -%}
{%- liquid
  assign nvgd_icon = icon | default: ''
  assign nvgd_size = size | default: '1em'
-%}
{%- capture nvgd_stroke -%}width="{{ nvgd_size }}" height="{{ nvgd_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nvgd-icon nvgd-icon--{{ nvgd_icon }}" aria-hidden="true" focusable="false"{%- endcapture -%}
{%- capture nvgd_fill -%}width="{{ nvgd_size }}" height="{{ nvgd_size }}" viewBox="0 0 24 24" fill="currentColor" class="nvgd-icon nvgd-icon--{{ nvgd_icon }}" aria-hidden="true" focusable="false"{%- endcapture -%}
{%- case nvgd_icon -%}
  {%- when 'chevron-up' -%}<svg {{ nvgd_stroke }}><path d="m6 15 6-6 6 6"/></svg>
  {%- when 'chevron-down' -%}<svg {{ nvgd_stroke }}><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-right' -%}<svg {{ nvgd_stroke }}><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'cart-shopping' -%}<svg {{ nvgd_stroke }}><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
  {%- when 'truck-fast' -%}<svg {{ nvgd_stroke }}><rect x="1" y="3" width="14" height="12" rx="1"/><path d="M15 8h4l3 3v4h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="17.5" cy="18.5" r="2"/></svg>
  {%- when 'volume-high' -%}<svg {{ nvgd_stroke }}><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
  {%- when 'volume-xmark' -%}<svg {{ nvgd_stroke }}><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
  {%- when 'facebook' -%}<svg {{ nvgd_fill }}><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
