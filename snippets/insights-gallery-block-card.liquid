{% comment %}
  Renders a single navigation card for the Insights Gallery section.

  Accepts:
  - block: {Object} Section block containing insight settings
  - is_first: {Boolean} Whether this is the first card (receives active-card class)
  - block_index: {Number} One-based block index (forloop.index from parent loop)

  Usage:
  {% render 'insights-gallery-block-card', block: block, is_first: forloop.first, block_index: forloop.index %}
{% endcomment %}

<div class="insight-card {% if is_first %}active-card{% endif %}"
     data-insight-id="{{ block.id }}"
     data-block-index="{{ block_index }}"
     {{ block.shopify_attributes }}>

  <div class="card-header">
    <div class="icon-wrapper">
      {% if block.settings.icon != blank %}
        <img src="{{ block.settings.icon | image_url: width: 100 }}"
             alt="{{ block.settings.title | strip_html }}"
             loading="lazy"
             width="100"
             height="{{ 100 | divided_by: block.settings.icon.aspect_ratio | ceil }}" />
      {% endif %}
    </div>

    <div class="card-arrow">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 17L17 7M17 7H7M17 7V17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <div class="card-content">
    <h3 class="card-title">{{ block.settings.title }}</h3>
  </div>
</div>
